---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Nubo Resources | Preemies, Twins, Toddlers, and Young Kids';
const description = 'Find practical Nubo guides for premature babies, twins, toddlers, and young kids, plus everyday tracking, caregiver sharing, and visit preparation.';

const guides = await getCollection('guides');
const familyGuides = [
  { slug: 'nubo-for-preemie-babies', stage: 'Born early' },
  { slug: 'nubo-for-twins', stage: 'Twins and multiples' },
  { slug: 'nubo-for-toddlers', stage: 'The toddler years' },
  { slug: 'nubo-for-young-kids', stage: 'The preschool years' },
].map(({ slug, stage }) => {
  const guide = guides.find((entry) => entry.slug === slug);
  if (!guide) throw new Error(`Missing family guide: ${slug}`);
  return { guide, stage };
});

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime())
  .slice(0, 9);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: 'https://www.nubotracker.com/resources/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      ...familyGuides.map(({ guide }) => ({
        url: `https://www.nubotracker.com/guides/${guide.slug}/`,
        name: guide.data.title,
      })),
      ...posts.map((post) => ({
        url: `https://www.nubotracker.com/blog/${post.data.category}/${post.slug}/`,
        name: post.data.title,
      })),
    ].map((resource, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      ...resource,
    })),
  },
};

const categoryCopy = [
  ['Sleep', 'Wake windows, regressions, night tracking, and the logs that make patterns visible.', '/blog/sleep/'],
  ['Feeding', 'Breastfeeding, bottles, exclusive pumping, allergens, and pediatrician-ready intake notes.', '/blog/feeding/'],
  ['Tracking', 'Daily logging routines for diapers, pediatrician visits, catch-up entries, and patterns.', '/blog/tracking/'],
  ['Caregivers', 'Handoffs for partners, grandparents, nannies, and returning to work.', '/blog/caregiver/'],
  ['Privacy', 'Plain-English guidance on baby data, backups, sharing, and voice logging.', '/blog/privacy/'],
  ['Product', 'Nubo Intelligence, Nubo Care, Plus access, Alexa, and device setup.', '/blog/product/'],
  ['Gifts', 'Practical baby shower ideas for the newborn weeks and the people helping.', '/blog/gifts/']
];

const intentLinks = [
  ['I want to start tracking today', 'Download the free app, then read the first 12 weeks guide when you need a simple routine.', '/app/#app-downloads', 'Download free app'],
  ['I am choosing app, Nubo Plus, or device', 'Compare setup paths before you commit to hardware or Nubo Plus.', '/pricing/', 'Compare setups'],
  ['I want to understand the Nubo names', 'See how Nubo Intelligence, Nubo Care, and the Nubo Plus plan fit together.', '/faq/#nubo-intelligence', 'Read the Intelligence FAQs'],
  ['My caregiver routine is getting messy', 'Start with handoff guidance for partners, grandparents, nannies, and returning to work.', '/blog/caregiver/', 'Read caregiver guides'],
  ['I am exclusively pumping', 'See how Nubo separates shared pumped milk bottles from private milk output tracking.', '/exclusive-pumping/', 'View EP setup'],
  ['I care most about privacy', 'Review how voice, backups, sharing, and private pumping are handled.', '/privacy/', 'Read privacy overview'],
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Header />
  <main>
    <section class="page-hero">
      <div class="container">
        <p class="overline">Nubo resources</p>
        <h1>Help for the stage you're in.</h1>
        <p class="page-hero-sub">Coming home with a preemie. Caring for twins. Finding a new routine with a toddler or preschooler. Start with the care you're doing now.</p>
        <a href="#your-family" class="text-link family-jump">Find your family guide <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="family-section" id="your-family" aria-labelledby="family-title">
      <div class="container">
        <div class="section-intro"><p class="overline">Your family, your stage</p><h2 id="family-title">A useful record looks different<br />in every family.</h2><p>Keep the details that help you care for your child, share a handoff, or ask a question at the next visit.</p></div>
        <div class="family-grid">
          {familyGuides.map(({ guide, stage }) => (
            <a class="family-card" href={`/guides/${guide.slug}/`}>
              <p class="family-stage">{stage}</p>
              <h3>{guide.data.title}</h3>
              <p class="family-description">{guide.data.excerpt ?? guide.data.description}</p>
              <span class="family-cta">Read the guide <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="start-section">
      <div class="container start-inner">
        <div>
          <p class="overline">Start here</p>
          <h2>Newborn feeding tracker, sleep, and diaper guidance for the first 12 weeks.</h2>
          <p>A practical guide for the stretch when nobody remembers exactly when the last feed, nap, or diaper happened. Pair it with the <a href="/app/" class="text-link">free baby tracker app</a> or the <a href="/device/" class="text-link">screen-free baby tracker</a> if phone logging is hard at night.</p>
          <a href="/guides/track-feeding-sleep-diapers-first-12-weeks/" class="btn-primary">Read the guide</a>
        </div>
        <img src="/images/nubo-instant-tracker-900.webp" alt="Hand pressing the Nubo instant tracker beside a sleeping baby" width="900" height="900" loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="category-section">
      <div class="container">
        <div class="section-intro"><p class="overline">Start here if</p><h2>Choose the baby tracker resource by what you need.</h2></div>
        <div class="intent-grid">
          {intentLinks.map(([label, copy, href, cta]) => (
            <article>
              <h3>{label}</h3>
              <p>{copy}</p>
              <a href={href}>{cta}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="category-section category-section-alt">
      <div class="container">
        <div class="section-intro"><p class="overline">Browse by topic</p><h2>Find feeding, sleep, diaper, caregiver, and privacy help.</h2></div>
        <div class="category-grid">
          {categoryCopy.map(([label, copy, href]) => (
            <a href={href} class="category-card"><h3>{label}</h3><p>{copy}</p></a>
          ))}
        </div>
      </div>
    </section>

    <section class="latest-section">
      <div class="container">
        <div class="section-intro"><p class="overline">Latest articles</p><h2>Baby tracker guides for tired families and the people helping them.</h2></div>
        <div class="post-grid">
          {posts.map((post) => (
            <article>
              <p class="post-category">{post.data.category}</p>
              <h3><a href={`/blog/${post.data.category}/${post.slug}/`}>{post.data.title}</a></h3>
              <p>{post.data.excerpt ?? post.data.description}</p>
            </article>
          ))}
        </div>
        <div class="all-posts"><a href="/blog/" class="btn-ghost">View all articles</a></div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .family-section { padding: 4rem 0 5rem; background: var(--color-bg-ivory); scroll-margin-top: 80px; }
  .family-jump { display: inline-flex; margin-top: 1.5rem; }
  .family-section .section-intro { max-width: 740px; margin-bottom: 2rem; }
  .family-section h2 { font-size: clamp(1.75rem, 4vw, 2.75rem); line-height: 1.2; }
  .family-section .section-intro > p:last-child { color: var(--color-text-secondary); margin-top: 1rem; }
  .family-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .family-card { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; padding: 2rem; background: #fff; border: 1px solid #dce6df; border-radius: var(--radius-xl); transition: border-color .2s ease, box-shadow .2s ease; }
  .family-card:hover { border-color: var(--color-brand); box-shadow: 0 12px 30px rgba(0, 0, 0, .05); }
  .family-stage { color: var(--color-brand-dark); font-size: .75rem; font-weight: 700; }
  .family-card h3 { font-size: 1.5rem; line-height: 1.25; margin-top: .6rem; }
  .family-description { color: var(--color-text-secondary); margin-block: 1rem 1.5rem; line-height: 1.7; }
  .family-cta { color: var(--color-brand-dark); font-size: .875rem; font-weight: 700; margin-top: auto; }
  .family-card:focus-visible, .family-jump:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 5px; }
  @media (max-width: 640px) { .family-grid { grid-template-columns: 1fr; } .family-card { padding: 1.5rem; } .family-section { padding-block: 3rem; } }
  .start-section, .category-section, .latest-section { padding: 6rem 0; }
  .start-section, .latest-section { background: #fff; }
  .category-section { background: var(--color-bg-soft); }
  .category-section-alt { background: #fff; }
  .start-inner { display: grid; grid-template-columns: 1fr 0.65fr; gap: 4rem; align-items: center; }
  .start-inner h2 { font-size: clamp(1.75rem, 4vw, 3rem); line-height: 1.12; margin-bottom: 1rem; }
  .start-inner p, .category-card p, .post-grid p { color: var(--color-text-secondary); line-height: 1.7; }
  .start-inner .btn-primary { margin-top: 1.5rem; }
  .start-inner img { max-height: 520px; width: auto; justify-self: center; border-radius: var(--radius-xl); }
  .intent-grid, .category-grid, .post-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .intent-grid { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
  .post-grid { grid-template-columns: repeat(3, 1fr); }
  .intent-grid article, .category-card, .post-grid article { background: #fff; border: 1px solid #e8e8e8; border-radius: var(--radius-xl); padding: 1.75rem; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .intent-grid article { display: flex; flex-direction: column; }
  .category-section-alt .category-card { background: var(--color-bg-soft); }
  .category-card:hover, .post-grid article:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06); }
  .intent-grid h3, .category-card h3, .post-grid h3 { font-size: 1.125rem; line-height: 1.3; margin-bottom: 0.625rem; }
  .intent-grid p { color: var(--color-text-secondary); line-height: 1.7; flex: 1; }
  .intent-grid a { display: inline-flex; margin-top: 1rem; color: var(--color-brand-dark); font-weight: 800; }
  .post-category { color: var(--color-brand-dark) !important; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem; }
  .post-grid h3 a:hover { color: var(--color-brand-dark); }
  .all-posts { margin-top: 2.5rem; text-align: center; }
  @media (max-width: 980px) { .start-inner { grid-template-columns: 1fr; } .intent-grid, .category-grid, .post-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .start-section, .category-section, .latest-section { padding: 4rem 0; } .intent-grid, .category-grid, .post-grid { grid-template-columns: 1fr; } .start-inner img { max-height: 420px; } }
</style>
