---
const redirectURL = '/app/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${redirectURL}`} />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href="https://www.nubotracker.com/app/" />
    <title>Redirecting to the Nubo app</title>
  </head>
  <body>
    <p>Redirecting to <a href={redirectURL}>the Nubo app</a>.</p>
  </body>
</html>
