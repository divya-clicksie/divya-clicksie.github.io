---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'FAQ | Nubo Care, Nubo Intelligence, App, and Device';
const description = 'Answers about Nubo Care visits, Nubo Intelligence, voice logging, Notetaker, Noticed, privacy, Free and Plus access, and the optional baby tracker device.';

const careFaqs = [
  {
    "q": "What is Nubo Care?",
    "a": "Nubo Care helps you listen to your pediatrician without trying to take notes at the same time. Save questions before the visit, record with permission during it, and return to a recap, answers, and next steps afterward. It is included in Nubo Plus. See the <a href=\"/#nubo-care\">Nubo Care overview</a>."
  },
  {
    "q": "Should I download before my baby arrives?",
    "a": "Yes. Get familiar with Nubo before the first busy days. Downloading and creating a profile do not start your Plus preview. The 14-day preview starts when you confirm your child is here."
  },
  {
    "q": "Can I use Nubo Care at the first hospital conversation?",
    "a": "Yes. Start with your questions and record with your care team’s permission. You do not need a tracking history. Nubo Care is included in Plus, including your 14-day preview, and is available worldwide with recording and recaps in English."
  },
  {
    "q": "Is Nubo Care included in the Plus preview and with the device?",
    "a": "Yes. Nubo Care is part of Nubo Plus, including everyone’s 14-day Plus preview and the Plus access included with every Nubo device. Your preview starts when you confirm your child is here."
  },
  {
    "q": "Where is Nubo Care available?",
    "a": "Nubo Care is available worldwide. Visit recording and recaps support English."
  },
  {
    "q": "Do I have to record the appointment?",
    "a": "No. Prepare your questions and selected observations, then take notes if you prefer. If you record, get permission from everyone taking part and follow the clinic’s policy."
  },
  {
    "q": "How can I check an answer against the conversation?",
    "a": "Every answer extracted from a recording refers to its actual audio timestamps. On the phone that recorded the visit, you can replay the relevant passage and recollect what was said. Manually entered notes do not have an audio reference."
  },
  {
    "q": "What do caregivers see?",
    "a": "Invited caregivers receive synced summaries, question answers, to-dos, and other visit records. The audio recording is available on the recording phone and is not synced to caregivers."
  },
  {
    "q": "Where does processing happen, and what is retained?",
    "a": "Care processing happens on the server with zero data retention after processing. Summaries, answers, to-dos, and other visit records are stored on phones and backed up to users’ private backups. Audio remains available on the recording phone."
  },
  {
    "q": "Can I prepare without a tracking history?",
    "a": "Yes. Start with your own questions and observations. Select relevant logs when you have them; a long logging history is not required."
  },
  {
    "q": "Do I need the Nubo device for doctor visits?",
    "a": "No. Nubo Care works in the app on its own. The optional device adds dedicated buttons for everyday feeds, sleep, and diapers. Each phone that syncs with the device receives Plus access, refreshed for 30 days with each sync."
  }
];

const intelligenceFaqs = [
  {
    q: "What is Nubo Intelligence?",
    a: "Nubo Intelligence brings together machine learning, on-device AI, statistics, and useful automation across everyday tracking. It helps you log naturally, capture observations, and notice changes in your baby's day. Explore <a href=\"/app/#intelligence\">Nubo Intelligence in the app</a>."
  },
  {
    q: "How do Nubo Intelligence, Nubo Care, and Nubo Plus fit together?",
    a: "Nubo Intelligence is the capability behind easier logging, organized observations, suggestions, and useful context across everyday care. Nubo Care helps you prepare for doctor visits and return to your pediatrician's answers and next steps. Nubo Plus is the paid plan: it includes Nubo Care and additional Intelligence features. In-app voice logging and observations stay free; Intelligence is not a separate subscription. See <a href=\"/pricing/\">Free and Plus access details</a>."
  },
  {
    q: "Can I log by voice in the app?",
    a: "Yes. Say what happened in everyday language, such as 'She had 90 mL of formula 20 minutes ago.' Nubo Intelligence identifies supported events and extracts amounts, units, times, and durations, including several events from one spoken update. Review and edit the events before saving. In-app voice logging is free and unlimited, with no usage caps. <a href=\"/app/#voice-logging\">Try the voice logging examples</a>."
  },
  {
    q: "What does Nubo Notetaker do, and which phones support it?",
    a: "Speak freely or type an observation about a new bottle, a question for the checkup, or a moment you want to remember. Nubo Notetaker preserves your words. On iOS 26 or later with Apple Intelligence available, it can add a short title and relevant tags to spoken or typed observations. Otherwise, your note keeps its text and receives a simpler title without AI tags. <a href=\"/app/#notetaker\">Meet Nubo Notetaker</a>."
  },
  {
    q: "What does Nubo Noticed show, and is it free?",
    a: "Nubo Noticed highlights supported changes in recorded sleep, bottle intake, nursing, and wet and dirty diaper patterns. It compares recent and earlier completed days and appears when the records support a finding. Missing logs are not treated as proof that no care happened. Nubo Noticed is included with Nubo Plus and is free for everyone on Mondays. <a href=\"/app/#insights\">See a Nubo Noticed example</a>."
  },
  {
    q: "How do suggestions while logging work?",
    a: "Nubo can suggest a feed amount from recent entries of the same type, prioritizing similar times of day when enough history exists. Growth entry controls can start from an estimate based on a previous measurement and its growth-chart position at your baby's current age. Suggestions are editable starting points, and growth estimates are not measured results. You choose the values to save."
  },
  {
    q: "Where does voice processing happen?",
    a: "In-app speech recognition and voice event interpretation run on your phone, including offline. Nubo Notetaker AI titles and tags also run on the device when supported. Optional caregiver sharing and private backup are separate from local processing. Alexa logging uses Amazon's systems. Nubo Care uses separate server processing for selected visit content, with no visit data retained after processing; original visit audio stays on the recording phone. Read <a href=\"/privacy/\">how Nubo handles privacy</a>."
  },
  {
    q: "Does Nubo have an AI medical advisor or health chatbot?",
    a: "No. Nubo Intelligence helps you record care, organize observations, and review patterns in your logs. It does not diagnose conditions or establish causes or relationships between symptoms and care patterns. Nubo Care helps you return to your pediatrician's own guidance. Bring medical questions to your care team."
  }
];

const trackerFaqs = [
  {
    q: "Who is Nubo best for?",
    a: "Nubo is best for families who want baby tracking to be fast, shared, and forgiving. It works well for newborn parents managing night feeds, forgotten logs, hands-full moments, and multiple caregivers. You can use the free app on its own, add Nubo Plus for advanced tools, or add the quick-log device when opening your phone is inconvenient."
  },
  {
    q: "How is Nubo different from other baby tracker apps?",
    a: "Nubo brings doctor visits and everyday care together. Nubo Care helps you prepare questions and return to your pediatrician's words. Nubo Intelligence helps with natural logging, observations, and useful context between visits. Start with the free app, share care across iPhone and Android, and add the optional device when dedicated event buttons fit your routine."
  },
  {
    q: "Does using Nubo mean more screen time?",
    a: "No. Nubo is built to support caregiving, not compete with it. The optional device logs feeds, sleep, and diapers with dedicated event buttons, so you can mark the moment without unlocking, scrolling, or pulling your attention off the baby. When you do use the app, voice catch-up and Quick Log keep entries short. The goal is not more screen time, it is better caregiving coordination. The <a href=\"/device/\">device page</a> explains the screen-free approach."
  },
  {
    q: "What does Nubo track?",
    a: "The Nubo device has dedicated one-tap buttons for core newborn logs like feeds, sleep, and diapers. The free Nubo app supports a fuller baby timeline, including feeds, sleep, diapers, medicine, growth, notes, voice catch-up, and caregiver sharing. See the <a href=\"/device/\">device page</a> for what the device buttons cover, or the <a href=\"/app/\">app page</a> for the full timeline and advanced logs."
  },
  {
    q: "Do I need the app to use the Nubo device?",
    a: "You can tap the Nubo device buttons right away to save logs, even before connecting the app. To view your timeline, sync history, invite caregivers, edit logs, or use trends and insights, you'll use the free Nubo app. The <a href=\"/device/\">device page</a> covers physical logging, and the <a href=\"/app/\">app page</a> covers the shared timeline."
  },
  {
    q: "Can I use Nubo without buying the device?",
    a: "Yes. The Nubo app is free on iPhone and Android and can be used without the device. The device is optional and adds dedicated physical buttons for moments when opening your phone is inconvenient. Start from the <a href=\"/app/\">free app page</a> to download."
  },
  {
    q: "Does the Nubo device need Wi-Fi or internet?",
    a: "No. The Nubo device does not use Wi-Fi and does not need an internet connection to save logs. It syncs to the app over Bluetooth when your phone is nearby."
  },
  {
    q: "How does Nubo sync with the app?",
    a: "Nubo syncs via Bluetooth Low Energy. When your phone is nearby, the app automatically pulls new activity data from the device. No Wi-Fi or internet connection is needed for syncing. For the full flow, read <a href=\"/blog/product/nubo-bluetooth-sync/\">how Nubo Bluetooth sync works</a>."
  },
  {
    q: "What phones are compatible?",
    a: "The Nubo app is available for iOS (iPhone) and Android. It requires Bluetooth Low Energy support, which is standard on any phone released in the last several years. Start from the <a href=\"/app/\">free app page</a> to choose App Store or Google Play."
  },
  {
    q: "How long does the battery last?",
    a: "Nubo uses a standard coin cell battery (CR2032) that lasts several months with typical use. An extra battery is included in the box. No charging cables needed. The <a href=\"/device/\">device page</a> has the box contents and setup overview."
  },
  {
    q: "Is Nubo waterproof?",
    a: "Nubo can handle light splashes and everyday surface messes. Wipe it clean with a dry or slightly damp cloth. Do not rinse it under water, put it in the dishwasher, or submerge it."
  },
  {
    q: "Can multiple caregivers use Nubo?",
    a: "Yes. Anyone can tap Nubo device buttons to log activities. In the app, you can invite caregivers like a partner, grandparents, or nanny so everyone sees the same activity log. Learn more on the <a href=\"/caregivers/\">caregiver page</a>."
  },
  {
    q: "How much does Nubo Plus cost, and how is it billed?",
    a: "Nubo Plus is $4.99/month (billed annually). Subscriptions are billed through the App Store on iPhone or Google Play billing on Android. Prices may vary by region; check your local price in the app before subscribing. The free app remains available without a subscription."
  },
  {
    q: "How does Nubo Plus work with the Nubo device?",
    a: "The Nubo device works with the free app. Any phone that pairs with or syncs from the device gets a 30-day Nubo Plus access window, and each later sync refreshes that window. This is separate from App Store or Google Play Nubo Plus subscriptions. See the <a href=\"/pricing/\">pricing page</a> for the household math."
  },
  {
    q: "How does the device give caregivers Nubo Plus access?",
    a: "When a caregiver phone pairs with or syncs from the device, that phone gets a 30-day Nubo Plus access window. Each later sync refreshes the 30-day window. This is why the device can be a strong value for households with nannies, grandparents, doulas, or daycare staff. See the <a href=\"/pricing/\">pricing page</a> for the household math."
  },
  {
    q: "What happens if a caregiver only visits occasionally?",
    a: "Nubo Plus access lasts 30 days after that caregiver's most recent sync. If it lapses, it reactivates the next time that caregiver syncs with your device. The <a href=\"/caregivers/\">caregiver page</a> explains how occasional helpers fit into the shared timeline."
  },
  {
    q: "Does Nubo Plus work for me if my partner buys the device?",
    a: "Yes. Nubo Plus access follows device use. It does not depend on which caregiver bought the device or which Apple or Google account made the purchase."
  },
  {
    q: "Can my partner use Nubo too?",
    a: "Yes. The free app supports unlimited caregivers. Nubo Plus tools belong to the App Store or Google Play account that buys Nubo Plus. Caregivers on separate store accounts usually need their own Nubo Plus subscription, or the device can grant Nubo Plus access when they use it. The <a href=\"/pricing/\">pricing page</a> compares those setups."
  },
  {
    q: "Is my baby's data private?",
    a: "Your baby activity data is stored locally on your phone, backups use your own iCloud or Google Drive, and caregiver sharing is end-to-end encrypted. We do not sell baby activity data. We only share information as needed to provide the service, support the app, or process purchases through third-party platforms, as described in our <a href=\"/privacy-policy/\">privacy policy</a>. Read the plain-English <a href=\"/privacy/\">privacy overview</a> for more."
  },
  {
    q: "What happens to my data if my Nubo Plus access ends?",
    a: "Your baby history remains available in the free app. Nubo Plus adds advanced tools, but ending Nubo Plus access does not erase your logs. The <a href=\"/app/\">free app page</a> shows what remains useful without upgrading."
  },
  {
    q: "Is the free tier actually useful?",
    a: "Yes. The <a href=\"/app/\">free Nubo app</a> includes routine tracking, unlimited caregivers, child profiles, private backup, offline mode, voice logging, quick logs, and observations with Nubo Notetaker. Nubo Noticed is free for everyone on Mondays. Nubo Plus adds further tools, including Nubo Care and Nubo Noticed throughout the week. The device is optional."
  },
  {
    q: "Do I need to create an account?",
    a: "No account is required to use the device or app. If you want to share data with other caregivers, you can create an optional account with just an email address."
  },
  {
    q: "Where can I buy Nubo?",
    a: "Nubo is available on <a href=\"https://www.amazon.com/nubo-Newborn-Activity-Tracker-Color/dp/B0CJLNBG4P?maas=maas_adg_465D5CB69C73F660B7AD38831E2D680B_afap_abs&ref_=aa_maas&tag=maas\" target=\"_blank\" rel=\"noopener noreferrer\">Amazon</a>. Free shipping with Prime. The companion app is free on the App Store and Google Play. You can compare options on the <a href=\"/pricing/\">pricing page</a>."
  },
  {
    q: "What if I have a second baby?",
    a: "The app supports multiple child profiles, and the device can keep working for a future baby. A one-time device purchase can be especially useful for families planning beyond one newborn stage. Compare app, Nubo Plus, and device paths on the <a href=\"/pricing/\">pricing page</a>."
  },
  {
    q: "Can I return the device?",
    a: "Nubo is sold through Amazon, so returns follow Amazon's standard return policy. You can review device pricing and purchase reassurance on the <a href=\"/pricing/\">pricing page</a>."
  },
  {
    q: "What comes in the box?",
    a: "The Nubo device (with battery installed), a milk volume sticker, a magnetic mount sticker, an extra CR2032 battery, a lanyard, and setup and user guides. See the <a href=\"/device/\">device page</a> for the setup and box overview."
  },
  {
    q: "How do I mount or carry Nubo?",
    a: "Nubo has a built-in magnet. Use the included magnetic sticker to mount it on your fridge, crib, or anywhere convenient. You can also clip it to a bag or wear it with the included lanyard."
  },
  {
    q: "Can I export my data?",
    a: "Yes. Nubo Plus includes PDF and CSV export for your baby's activity data. This is helpful for pediatrician visits or keeping personal records. Your timeline stays available in the free app even if you do not use Nubo Plus. The <a href=\"/app/\">app page</a> covers the app-first tools in more detail."
  },
  {
    q: "Is Nubo good for exclusive pumping?",
    a: "Yes. Nubo separates the two records exclusive pumping families usually need: pumped milk bottles are baby feeds in the shared timeline, while Nubo Plus private pumping tracks milk output for the person who pumped. Caregivers can help log baby intake without seeing private pumping sessions. The <a href=\"/exclusive-pumping/\">exclusive pumping page</a> explains the setup."
  },
  {
    q: "Can caregivers see my pumping data?",
    a: "No. Nubo Plus includes a private pumping tracker for milk output. Pumping data is not in the shared baby log, not in caregiver sync, and not visible to partners, nannies, grandparents, or other collaborators. Read the <a href=\"/blog/privacy/pumping-tracker-private-data/\">exclusive pumping privacy guide</a> for the full design."
  },
  {
    q: "How can Nubo help me see my baby's routine?",
    a: "Quick Action cards show the latest event and today's totals. Nubo Noticed highlights supported changes across recent and earlier completed days, and Plus Rhythm charts put care events on a shared timeline. These are parts of Nubo Intelligence that help you review recorded care. See <a href=\"/app/#insights\">Nubo Noticed and its access details</a>."
  },
  {
    q: "Is Nubo a medical device?",
    a: "No. Nubo is a consumer wellness product designed to help parents track daily baby activities. It is not intended to diagnose, treat, cure, or prevent any medical condition. Always consult your pediatrician for medical advice."
  },
  {
    q: "How do I get help or report an issue?",
    a: "Email us at <a href=\"mailto:support@clicksie.io\">support@clicksie.io</a>. We typically respond within one business day. You can also visit our <a href=\"/contact/\">contact page</a>."
  },
  {
    q: "How do I pair Nubo with my phone?",
    a: "Open the Nubo app, tap Add Device, and hold Nubo close to your phone. The app will find it automatically via Bluetooth. The whole process takes about 30 seconds. No Wi-Fi or passwords needed. The <a href=\"/device/\">device page</a> has the setup overview."
  },
  {
    q: "How do I reset Nubo?",
    a: "First, remove Nubo from the app under Settings &gt; Devices. On iPhone, also open Bluetooth settings and choose \"Forget This Device\" for Nubo if it appears there. Then triple-click the + button on the device to reset pairing, or remove and reinsert the battery if needed. After that, open the Nubo app and tap Add Device again."
  },
  {
    q: "Nubo isn't syncing with the app. What should I do?",
    a: "Make sure Bluetooth is enabled on your phone and Nubo is within range (about 10 feet). Try closing and reopening the app. If it still won't sync, reset the device by removing and reinserting the battery, then re-pair. If the issue persists, email <a href=\"mailto:support@clicksie.io\">support@clicksie.io</a>."
  },
  {
    q: "How do I replace the battery?",
    a: "Slide open the battery cover on the back of the device and swap in a standard CR2032 coin cell. An extra battery is included in the box. No tools needed."
  },
  {
    q: "Can I log activities manually in the app?",
    a: "Yes. Open the app and tap the + button to add any activity with a custom time. This is useful if you forgot to tap the device or want to add a past event. See the <a href=\"/app/\">app page</a> for quick logging and catch-up options."
  },
  {
    q: "Do I need the Nubo device to use voice logging?",
    a: "No. In-app voice logging works in the free Nubo app on its own. The device adds dedicated physical buttons for moments when your phone isn't within reach. The <a href=\"/compare/\">comparison page</a> shows where voice, Quick Log, and the device each fit."
  }
];

const faqs = [...careFaqs, ...intelligenceFaqs, ...trackerFaqs];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a.replace(/<[^>]*>/g, '')
    }
  }))
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Header />
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <p class="overline">Nubo FAQ</p>
        <h1>Your questions about Nubo Care and Nubo Intelligence.</h1>
        <p class="page-hero-sub">
          Doctor visits, everyday tracking, Free and Plus, and the optional device. Can't find your answer?
          <a href="/contact/" class="hero-link">Reach out to us</a>.
        </p>
      </div>
    </section>

    <nav class="faq-paths" aria-label="FAQ topics">
      <div class="container faq-path-grid">
        <a href="#doctor-visits"><span>Nubo Care</span><strong>Doctor visits and shared next steps</strong></a>
        <a href="#nubo-intelligence"><span>Nubo Intelligence</span><strong>Logging, observations, and noticed patterns</strong></a>
        <a href="#app-and-device"><span>App and device</span><strong>Everyday tracking, access, and setup</strong></a>
      </div>
    </nav>

    <section class="faq-content" id="doctor-visits" aria-labelledby="care-faq-title">
      <div class="container faq-inner">
        <p class="overline">Nubo Care</p>
        <h2 id="care-faq-title">Doctor visits</h2>
        <p class="faq-section-intro">Preparing, recording, revisiting answers, and sharing next steps.</p>
        {careFaqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question"><span>{faq.q}</span><span class="faq-icon" aria-hidden="true">+</span></summary>
            <div class="faq-answer"><p set:html={faq.a} /></div>
          </details>
        ))}
      </div>
    </section>

    <section class="faq-content" id="nubo-intelligence" aria-labelledby="intelligence-faq-title">
      <div class="container faq-inner">
        <p class="overline">Nubo Intelligence</p>
        <h2 id="intelligence-faq-title">Easier logging. Useful context.</h2>
        <p class="faq-section-intro">Voice logging, Nubo Notetaker, Nubo Noticed, and the small tasks they help with.</p>
        {intelligenceFaqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question"><span>{faq.q}</span><span class="faq-icon" aria-hidden="true">+</span></summary>
            <div class="faq-answer"><p set:html={faq.a} /></div>
          </details>
        ))}
      </div>
    </section>

    <section class="faq-content" id="app-and-device" aria-labelledby="tracker-faq-title">
      <div class="container faq-inner">
        <p class="overline">Everyday care</p>
        <h2 id="tracker-faq-title">App and device</h2>
        <p class="faq-section-intro">Tracking, caregiver sharing, Plus, and device setup.</p>
        {trackerFaqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question"><span>{faq.q}</span><span class="faq-icon" aria-hidden="true">+</span></summary>
            <div class="faq-answer"><p set:html={faq.a} /></div>
          </details>
        ))}
      </div>
    </section>

    <section class="faq-cta">
      <div class="container faq-cta-inner">
        <h2>Still have a question about Nubo?</h2>
        <p>We'd love to hear from you.</p>
        <a href="/contact/" class="btn-primary">Contact us</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>


<style>
  section[id] { scroll-margin-top: 96px; }
  a:focus-visible, summary:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 5px; }
  .faq-section-intro { color: var(--color-text-secondary); margin: 1rem 0 1.5rem; }
  .faq-paths {
    padding: 0 0 1rem;
    background: #fff;
  }

  .faq-path-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .faq-path-grid a {
    display: grid;
    gap: 0.35rem;
    min-height: 96px;
    padding: 1rem;
    border: 1px solid #e8e8e8;
    border-radius: var(--radius-lg);
    background: var(--color-bg-soft);
    color: var(--color-text);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .faq-path-grid a:hover {
    border-color: var(--color-brand);
    transform: translateY(-2px);
  }

  .faq-path-grid span {
    color: var(--color-brand-dark);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .faq-path-grid strong {
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .faq-content {
    padding: 4rem 0 2rem;
  }

  .faq-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .faq-item {
    border-bottom: 1px solid #eee;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    cursor: pointer;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0;
    list-style: none;
    gap: 1.5rem;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--color-brand);
    transition: transform 0.3s ease;
    flex-shrink: 0;
    line-height: 1;
  }

  details[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 0 1.5rem;
  }

  .faq-answer p {
    font-size: 0.9375rem;
    color: #555;
    line-height: 1.8;
  }

  .faq-answer :global(a) {
    color: var(--color-brand-dark);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: .18em;
    transition: color 0.2s;
  }

  .faq-answer :global(a:hover) {
    color: var(--color-brand);
  }

  .faq-answer :global(a:focus-visible) { outline: 3px solid var(--color-brand); outline-offset: 5px; }

  .faq-cta {
    padding: 4rem 0 6rem;
  }

  .faq-cta-inner {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
    background: var(--color-bg-soft);
    border-radius: var(--radius-xl);
    padding: 3rem;
  }

  .faq-cta-inner h2 {
