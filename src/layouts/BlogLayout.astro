---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleContents from '../components/ArticleContents.astro';
import SiteIcon from '../components/SiteIcon.astro';

interface Props {
  title: string;
  description: string;
  datePublished: string;
  dateModified: string;
  author: string;
  category: string;
  hideNextStep?: boolean;
  heroImage?: string;
  ogImage?: string;
  tags?: string[];
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  datePublished,
  dateModified,
  author,
  category,
  hideNextStep = false,
  heroImage,
  ogImage,
  tags = [],
  headings = [],
} = Astro.props;

const categoryLabels: Record<string, string> = {
  sleep: 'Sleep',
  feeding: 'Feeding',
  tracking: 'Tracking',
  caregiver: 'Caregiver',
  privacy: 'Privacy',
  product: 'Product',
  gifts: 'Gifts',
};

const categoryNextSteps: Record<string, { eyebrow: string; title: string; copy: string; href: string; cta: string }> = {
  sleep: {
    eyebrow: 'Track sleep without the scramble',
    title: 'A tap. Then back to your baby.',
    copy: 'Hands full in the night? Tap a dedicated button, or catch up by voice in the free app. The details join one shared baby timeline.',
    href: '/device/',
    cta: 'View Nubo Remote',
  },
  feeding: {
    eyebrow: 'For feeds, pumping, and bottles',
    title: 'Start with the free app.',
    copy: 'Log nursing, bottles, diapers, growth, and observations free. Nubo Plus adds private pumping and Nubo Care for doctor visits.',
    href: '/app/',
    cta: 'Explore the app',
  },
  tracking: {
    eyebrow: 'Make the routine easier',
    title: 'Choose the setup that fits your household.',
    copy: 'Compare the free app, Nubo Plus, and the Nubo Remote by speed, privacy, and caregiver needs.',
    href: '/pricing/',
    cta: 'See pricing',
  },
  caregiver: {
    eyebrow: 'Shared care, one timeline',
    title: 'Care changes hands. The details come along.',
    copy: 'The last bottle, the morning nap, and who logged it. Unlimited caregivers share the free Nubo app across iPhone and Android.',
    href: '/caregivers/',
    cta: 'See caregiver sync',
  },
  privacy: {
    eyebrow: 'Private by design',
    title: 'Read the plain-English privacy promise.',
    copy: 'Everyday voice logging runs on your phone. Nubo Care uses separate visit processing with no retention afterward. Backups use your own cloud account.',
    href: '/privacy/',
    cta: 'Read privacy overview',
  },
  product: {
    eyebrow: 'Nubo product guide',
    title: 'The little things. The next conversation.',
    copy: 'Say what happened, save what you notice, and review recorded patterns with Nubo Intelligence. Plus adds Nubo Care for pediatrician visits.',
    href: '/app/#intelligence',
    cta: 'Explore the app',
  },
  gifts: {
    eyebrow: 'A practical baby gift',
    title: 'Give the tap parents actually use.',
    copy: 'The Nubo Remote is useful before the hospital bag, during newborn nights, and across the next baby too.',
    href: '/gift/',
    cta: 'See the gift page',
  },
};

const nextStep = categoryNextSteps[category] || categoryNextSteps.tracking;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": { "@type": "Person", "name": author },
  "publisher": {
    "@type": "Organization",
    "name": "Nubo",
    "url": "https://www.nubotracker.com",
  },
  "datePublished": datePublished,
  "dateModified": dateModified,
  ...(heroImage ? { "image": `https://www.nubotracker.com${heroImage}` } : {}),
};
---

<BaseLayout
  title={`${title} | Nubo Baby Tracker`}
  description={description}
  ogImage={ogImage || heroImage || '/images/nubo-instant-tracker.webp'}
  ogType="article"
  jsonLd={jsonLd}
>
  <Header />
  <main id="main-content">
    <article class="blog-post">
      <header class="blog-hero">
        <div class="container">
          <a href={`/blog/${category}/`} class="overline blog-back">{categoryLabels[category] || category}</a>
          <h1>{title}</h1>
          <p class="blog-meta">
            <span>{author}</span>
          </p>
        </div>
      </header>

      {heroImage && (
        <div class="blog-hero-image container">
          <img src={heroImage} alt={title} width="1120" height="560" loading="eager" />
        </div>
      )}

      <div class="blog-body container"><div class:list={['reading-grid', { 'no-contents': headings.filter((heading) => heading.depth === 2).length < 2 }]}><ArticleContents headings={headings} /><div class="reading-main">
        <div class="prose">
          <slot />
        </div>
        {!hideNextStep && (
          <aside class="article-next-step" aria-label="Recommended next step"><span class="next-step-icon"><SiteIcon name="leaf" size={28} /></span><div>
            <p class="article-next-step-eyebrow">{nextStep.eyebrow}</p>
            <h2>{nextStep.title}</h2>
            </div><a href={nextStep.href}>{nextStep.cta} <span aria-hidden="true">→</span></a>
          </aside>
        )}
        <nav class="article-footlinks" aria-label="More reading"><a href="/blog/">All articles</a><a href="/guides/">Family guides</a></nav>
      </div></div></div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .blog-hero {
    padding: 10rem 0 3rem;
    background: linear-gradient(170deg, #f0fafa 0%, #fff 60%);
    text-align: center;
  }

  .blog-hero h1 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--color-text);
    max-width: 720px;
    margin: 0 auto;
  }

  .blog-back {
    display: inline-block;
    transition: color 0.2s;
  }

  .blog-back:hover {
    color: var(--color-brand-dark);
  }

  .blog-meta {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .blog-hero-image {
    margin-top: -1rem;
    margin-bottom: 3rem;
  }

  .blog-hero-image img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: var(--radius-xl);
  }

  .blog-body {
    padding: 3rem 0 6rem;
  }

  .prose {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    letter-spacing: 0;
  }

  .prose :global(h3) {
    font-size: 1.1875rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0;
  }

  .prose :global(p) {
    font-size: 1rem;
    color: #444;
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    font-size: 1rem;
    color: #444;
    line-height: 1.8;
    margin-bottom: 0.4rem;
  }

  .prose :global(a) {
    color: var(--color-brand);
    font-weight: 600;
    transition: color 0.2s;
  }

  .prose :global(a:hover) {
    color: var(--color-brand-dark);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-brand);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    background: var(--color-bg-soft);
    border-radius: 0 var(--radius-xl) var(--radius-xl) 0;
  }

  .prose :global(blockquote p) {
    margin-bottom: 0;
    font-style: italic;
    color: #555;
  }

  .prose :global(strong) {
    font-weight: 700;
    color: var(--color-text);
  }

  .prose :global(img) {
    border-radius: var(--radius-xl);
    margin: 1.5rem 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }

  .prose :global(th) {
    text-align: left;
    font-weight: 700;
    color: var(--color-text);
    padding: 0.75rem 1rem;
    border-bottom: 2px solid #e5e5e7;
    background: var(--color-bg-soft);
  }

  .prose :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e5e5e7;
    color: #444;
    line-height: 1.6;
  }

  .prose :global(tr:last-child td) {
    border-bottom: none;
  }

  .article-next-step {
    max-width: 720px;
    margin: 3rem auto 0;
    padding: 2rem;
    border: 1px solid rgba(61, 179, 173, 0.22);
    border-radius: var(--radius-xl);
    background: linear-gradient(150deg, #f0fafa 0%, #fff 74%);
  }

  .article-next-step-eyebrow {
    margin-bottom: 0.65rem;
    color: var(--color-brand-dark);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-next-step h2 {
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--color-text);
  }

  .article-next-step p:not(.article-next-step-eyebrow) {
    margin-top: 0.8rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .article-next-step a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.15rem;
    min-height: 44px;
    padding: 0.75rem 1.1rem;
    border-radius: 999px;
    background: var(--color-brand);
    color: #fff;
    font-weight: 800;
  }

  .article-next-step a:hover {
    background: var(--color-brand-dark);
  }

  .article-brand-line {
    max-width: 720px;
    margin: 1.5rem auto 0;
    padding: 0 0.25rem;
    text-align: center;
  }

  .article-brand-line-lead {
    font-weight: 800;
    font-size: 1.0625rem;
    color: var(--color-brand-dark);
    margin: 0;
  }

  .article-brand-line-support {
    margin: 0.5rem auto 0;
    color: var(--color-text-secondary);
    line-height: 1.65;
    font-size: 0.9375rem;
  }

  @media (max-width: 768px) {
    .blog-hero { padding: 8rem 0 2.5rem; }
    .blog-hero-image img { border-radius: 16px; }

    .article-next-step {
      margin-top: 2.25rem;
      padding: 1.5rem;
      border-radius: 18px;
    }

    .prose :global(table) {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }

  .reading-grid { display: grid; grid-template-columns: 210px minmax(0,720px); gap: 3rem; align-items: start; }
  .reading-main { min-width: 0; }
  .blog-body.container, .guide-body.container { padding-inline: 2rem; }
  .reading-grid { justify-content: center; }
  .article-next-step > a:hover { background: none; color: var(--color-brand-dark); text-decoration: underline; text-underline-offset: 3px; }
  .reading-grid.no-contents { grid-template-columns: minmax(0,720px); justify-content: center; }
  .prose { max-width: 720px; margin: 0; padding: 0; }
  .blog-hero, .guide-hero { padding-block: 132px 44px; background: var(--color-bg-ivory); }
  .blog-hero h1, .guide-hero h1 { line-height: 1.14; letter-spacing: -.03em; text-wrap: balance; }
  .prose :global(h2), .prose :global(h3) { scroll-margin-top: 100px; text-wrap: balance; }
  .prose :global(h2) { border-top: 1px solid #e3e8df; padding-top: 1.5rem; }
  .prose :global(table) { display: block; overflow-x: auto; max-width: 100%; border: 1px solid #e1e6dd; border-radius: 14px; }
  .prose :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .article-footlinks { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 2rem; border-top: 1px solid #e3e8df; padding-top: 1.25rem; color: var(--color-brand-dark); font-size: .8125rem; font-weight: 700; }
  .article-next-step { display: grid; grid-template-columns: auto 1fr; gap: 1rem; margin: 2.5rem 0 0; padding: 1.5rem; background: #f0f7f2; }
  .next-step-icon { color: var(--color-brand-dark); }
  .article-next-step .article-next-step-eyebrow { font-size: .625rem; margin-bottom: .5rem; }
  .article-next-step h2 { font-size: 1.2rem; line-height: 1.4; margin: 0; }
  .article-next-step > a { grid-column: 2; font-size: .8125rem; padding: 0; background: none; color: var(--color-brand-dark); justify-self: start; }
  a:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 4px; }
  @media (max-width: 900px) { .reading-grid { grid-template-columns: minmax(0,720px); justify-content: center; gap: 2rem; } }
  @media (max-width: 680px) { .blog-hero, .guide-hero { padding-block: 100px 32px; } .blog-body, .guide-body { padding-block: 2rem 3rem; } .blog-body.container, .guide-body.container { padding-inline: 1.25rem; } .prose :global(table) { font-size: .8125rem; } .prose :global(th), .prose :global(td) { padding: .7rem; } }

</style>
