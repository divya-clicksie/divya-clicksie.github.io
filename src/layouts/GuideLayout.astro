---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleContents from '../components/ArticleContents.astro';

interface Props {
  title: string;
  description: string;
  datePublished: string;
  dateModified: string;
  author: string;
  heroImage?: string;
  ogImage?: string;
  tags?: string[];
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  datePublished,
  dateModified,
  author,
  heroImage,
  ogImage,
  tags = [],
  headings = [],
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": { "@type": "Person", "name": author },
  "publisher": {
    "@type": "Organization",
    "name": "Nubo",
    "url": "https://www.nubotracker.com",
  },
  "datePublished": datePublished,
  "dateModified": dateModified,
  ...(heroImage ? { "image": `https://www.nubotracker.com${heroImage}` } : {}),
};
---

<BaseLayout
  title={`${title} | Nubo Baby Tracker`}
  description={description}
  ogImage={ogImage || heroImage || '/images/nubo-instant-tracker.webp'}
  ogType="article"
  jsonLd={jsonLd}
>
  <Header />
  <main id="main-content">
    <article class="guide">
      <header class="guide-hero">
        <div class="container">
          <p class="overline">Guide</p>
          <h1>{title}</h1>
          <p class="guide-meta">
            <time datetime={datePublished}>{new Date(datePublished).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
            <span class="meta-sep">&middot;</span>
            <span>{author}</span>
          </p>
        </div>
      </header>

      {heroImage && (
        <div class="guide-hero-image container">
          <img src={heroImage} alt={title} width="1120" height="560" loading="eager" />
        </div>
      )}

      <div class="guide-body container"><div class:list={['reading-grid', { 'no-contents': headings.filter((heading) => heading.depth === 2).length < 2 }]}><ArticleContents headings={headings} /><div class="reading-main">
        <div class="prose">
          <slot />
        </div>
        <nav class="article-footlinks" aria-label="More reading"><a href="/guides/">All family guides</a><a href="/resources/">Resource hub</a></nav>
      </div></div></div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .guide-hero {
    padding: 10rem 0 3rem;
    background: linear-gradient(170deg, #f0fafa 0%, #fff 60%);
    text-align: center;
  }

  .guide-hero h1 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--color-text);
    max-width: 720px;
    margin: 0 auto;
  }

  .guide-meta {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .meta-sep {
    margin: 0 0.5rem;
    color: #ccc;
  }

  .guide-hero-image {
    margin-top: -1rem;
    margin-bottom: 3rem;
  }

  .guide-hero-image img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: var(--radius-xl);
  }

  .guide-body {
    padding-block: 3rem 6rem;
  }

  .prose {
    max-width: 720px;
    margin: 0 auto;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    letter-spacing: 0;
  }

  .prose :global(h3) {
    font-size: 1.1875rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0;
  }

  .prose :global(p) {
    font-size: 1rem;
    color: #444;
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    font-size: 1rem;
    color: #444;
    line-height: 1.8;
    margin-bottom: 0.4rem;
  }

  .prose :global(a) {
    color: var(--color-brand);
    font-weight: 600;
    transition: color 0.2s;
  }

  .prose :global(a:hover) {
    color: var(--color-brand-dark);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-brand);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    background: var(--color-bg-soft);
    border-radius: 0 var(--radius-xl) var(--radius-xl) 0;
  }

  .prose :global(blockquote p) {
    margin-bottom: 0;
    font-style: italic;
    color: #555;
  }

  .prose :global(strong) {
    font-weight: 700;
    color: var(--color-text);
  }

  .prose :global(img) {
    border-radius: var(--radius-xl);
    margin: 1.5rem 0;
  }

  @media (max-width: 768px) {
    .guide-hero { padding: 8rem 0 2.5rem; }
    .guide-hero-image img { border-radius: 16px; }
  }

  .reading-grid { display: grid; grid-template-columns: 210px minmax(0,720px); gap: 3rem; align-items: start; }
  .reading-main { min-width: 0; }
  .blog-body.container, .guide-body.container { padding-inline: 2rem; }
  .reading-grid { justify-content: center; }
  .article-next-step > a:hover { background: none; color: var(--color-brand-dark); text-decoration: underline; text-underline-offset: 3px; }
  .reading-grid.no-contents { grid-template-columns: minmax(0,720px); justify-content: center; }
  .prose { max-width: 720px; margin: 0; padding: 0; }
  .blog-hero, .guide-hero { padding-block: 132px 44px; background: var(--color-bg-ivory); }
  .blog-hero h1, .guide-hero h1 { line-height: 1.14; letter-spacing: -.03em; text-wrap: balance; }
  .prose :global(h2), .prose :global(h3) { scroll-margin-top: 100px; text-wrap: balance; }
  .prose :global(h2) { border-top: 1px solid #e3e8df; padding-top: 1.5rem; }
  .prose :global(table) { display: block; overflow-x: auto; max-width: 100%; border: 1px solid #e1e6dd; border-radius: 14px; }
  .prose :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .article-footlinks { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 2rem; border-top: 1px solid #e3e8df; padding-top: 1.25rem; color: var(--color-brand-dark); font-size: .8125rem; font-weight: 700; }
  .article-next-step { display: grid; grid-template-columns: auto 1fr; gap: 1rem; margin: 2.5rem 0 0; padding: 1.5rem; background: #f0f7f2; }
  .next-step-icon { color: var(--color-brand-dark); }
  .article-next-step .article-next-step-eyebrow { font-size: .625rem; margin-bottom: .5rem; }
  .article-next-step h2 { font-size: 1.2rem; line-height: 1.4; margin: 0; }
  .article-next-step > a { grid-column: 2; font-size: .8125rem; padding: 0; background: none; color: var(--color-brand-dark); justify-self: start; }
  a:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 4px; }
  @media (max-width: 900px) { .reading-grid { grid-template-columns: minmax(0,720px); justify-content: center; gap: 2rem; } }
  @media (max-width: 680px) { .blog-hero, .guide-hero { padding-block: 100px 32px; } .blog-body, .guide-body { padding-block: 2rem 3rem; } .blog-body.container, .guide-body.container { padding-inline: 1.25rem; } .prose :global(table) { font-size: .8125rem; } .prose :global(th), .prose :global(td) { padding: .7rem; } }

</style>
