---
import { careHeroScenes as scenes } from '../data/careHeroScenes';
---

<div class="care-gallery" data-care-gallery role="region" aria-roledescription="carousel" aria-label="Care conversations as your child grows">
  {scenes.map((scene, index) => {
    const src = `/images/nubo-care-${scene.key}.webp`;
    const srcset = `/images/nubo-care-${scene.key}-960.webp 960w, /images/nubo-care-${scene.key}-1920.webp 1920w, ${src} ${scene.width}w`;
    return <div class:list={['care-scene', { 'is-active': index === 0 }]} data-scene={scene.key} data-label={scene.label} data-short={scene.short} aria-hidden={index === 0 ? 'false' : 'true'}>
      <img src={index === 0 ? src : undefined} srcset={index === 0 ? srcset : undefined} data-src={src} data-srcset={srcset} sizes="100vw" alt={scene.alt} width={scene.width} height={scene.width / 2} fetchpriority={index === 0 ? 'high' : 'low'} decoding="async" />
    </div>;
  })}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-care-gallery]').forEach((gallery) => {
    const hero = gallery.closest<HTMLElement>('.hero');
    const scenes = Array.from(gallery.querySelectorAll<HTMLElement>('[data-scene]'));
    const headlines = Array.from(hero?.querySelectorAll<HTMLElement>('[data-care-headline]') || []);
    const toggle = hero?.querySelector<HTMLButtonElement>('[data-care-toggle]');
    const controls = hero?.querySelector<HTMLElement>('[data-care-controls]');
    const choices = Array.from(hero?.querySelectorAll<HTMLButtonElement>('[data-care-choice]') || []);
    if (!hero || scenes.length < 2) return;

    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const hover = window.matchMedia('(hover: hover)');
    let current = 0;
    let paused = false;
    let inView = true;
    let pointerInside = false;
    let focusInside = false;
    let timer: number | undefined;
    let request = 0;

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };
    const load = async (index: number) => {
      const image = scenes[index].querySelector<HTMLImageElement>('img');
      if (!image) return false;
      if (!image.getAttribute('src')) {
        image.srcset = image.dataset.srcset || '';
        image.src = image.dataset.src || '';
      }
      try { await image.decode(); return image.naturalWidth > 0; }
      catch { return false; }
    };
    const select = async (index: number) => {
      const selectedRequest = ++request;
      if (!await load(index) || selectedRequest !== request) return;
      scenes[current].classList.remove('is-active');
      scenes[current].setAttribute('aria-hidden', 'true');
      headlines.forEach((headline) => {
        const active = headline.dataset.careHeadline === scenes[index].dataset.scene;
        headline.classList.toggle('is-active', active);
        headline.setAttribute('aria-hidden', String(!active));
      });
      current = index;
      choices.forEach((choice, index) => choice.setAttribute('aria-pressed', String(index === current)));
      scenes[current].classList.add('is-active');
      scenes[current].setAttribute('aria-hidden', 'false');
      void load((current + 1) % scenes.length);
    };
    const schedule = () => {
      stop();
      if (!motion.matches && !paused && inView && !document.hidden && !pointerInside && !focusInside) {
        timer = window.setInterval(() => { void select((current + 1) % scenes.length); }, 8000);
      }
    };
    hero.addEventListener('mouseenter', () => {
      if (!hover.matches) return;
      pointerInside = true;
      ++request;
      stop();
    });
    hero.addEventListener('mouseleave', () => { pointerInside = false; schedule(); });
    hero.addEventListener('focusin', () => { focusInside = true; ++request; stop(); });
    hero.addEventListener('focusout', (event) => {
      focusInside = event.relatedTarget instanceof Node && hero.contains(event.relatedTarget);
      schedule();
    });
    choices.forEach((choice, index) => choice.addEventListener('click', () => {
      paused = true;
      stop();
      if (toggle) toggle.textContent = 'Play slideshow';
      void select(index);
    }));
    toggle?.addEventListener('click', () => {
      ++request;
      paused = !paused;
      toggle.textContent = paused ? 'Play slideshow' : 'Pause slideshow';
      schedule();
    });
    document.addEventListener('visibilitychange', () => { ++request; schedule(); });
    motion.addEventListener('change', () => {
      ++request;
      if (toggle) toggle.hidden = motion.matches;
      schedule();
    });
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting && entry.intersectionRatio >= 0.3;
      if (!inView) ++request;
      schedule();
    }, { threshold: [0, 0.3] });
    observer.observe(hero);
    if (controls) controls.hidden = false;
    if (toggle) toggle.hidden = motion.matches;
    schedule();
    const firstImage = scenes[0].querySelector<HTMLImageElement>('img');
    if (firstImage?.complete) void load(1);
    else firstImage?.addEventListener('load', () => { void load(1); }, { once: true });
  });
</script>

<style>
  .care-gallery { position: absolute; inset: 0; }
  .care-scene { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 1s ease, visibility 1s; }
  .care-scene.is-active { opacity: 1; visibility: visible; }
  .care-scene img { width: 100%; height: 100%; object-fit: cover; object-position: 68% center; }
  @media (prefers-reduced-motion: reduce) { .care-scene { transition: none; } }
  @media (max-width: 680px) {
    .care-gallery { position: relative; height: 215px; }
    .care-scene img { object-position: 78% center; }
  }
  @media (max-width: 360px) { .care-gallery { height: 195px; } }
</style>
