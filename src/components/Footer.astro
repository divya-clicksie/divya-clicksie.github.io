---
import StoreLinks from './StoreLinks.astro';

const currentYear = new Date().getFullYear();
const amazonURL = 'https://www.amazon.com/nubo-Newborn-Activity-Tracker-Color/dp/B0CJLNBG4P?maas=maas_adg_465D5CB69C73F660B7AD38831E2D680B_afap_abs&ref_=aa_maas&tag=maas';
const instagramURL = 'https://www.instagram.com/nubo_baby_tracker';
const youtubeURL = 'https://www.youtube.com/@NuboBabyTracker';
---

<footer class="site-footer"><div class="container">
  <div class="footer-top"><div class="footer-brand"><a href="/" aria-label="Nubo Baby Tracker Home"><img src="/images/nubo-logo.svg" alt="nubo" width="90" height="28" /></a><p>Everyday care. Doctor visits.<br />The details, together.</p><StoreLinks /></div><nav class="footer-columns" aria-label="Footer navigation"><div><h2>Product</h2><ul><li><a href="/app/">Free app</a></li><li><a href="/device/">Device</a></li><li><a href="/#nubo-care">Nubo Care</a></li><li><a href="/app/#intelligence">Nubo Intelligence</a></li><li><a href="/pricing/">Plus and pricing</a></li><li><a href="/alexa/">Alexa skill</a></li></ul></div><div><h2>Explore</h2><ul><li><a href="/caregivers/">Shared care</a></li><li><a href="/exclusive-pumping/">Private pumping</a></li><li><a href="/gift/">Gifts</a></li><li><a href="/compare/">Compare options</a></li><li><a href="/blog/">Blog</a></li><li><a href="/guides/">Family guides</a></li></ul></div><div><h2>Help and trust</h2><ul><li><a href="/resources/">Resources</a></li><li><a href="/faq/">FAQ</a></li><li><a href="/contact/">Contact</a></li><li><a href="/about/">About Nubo</a></li><li><a href="/privacy/">Privacy at Nubo</a></li></ul></div></nav></div>
  <div class="footer-connect"><a href="mailto:support@clicksie.io">support@clicksie.io</a><div><a href={amazonURL} target="_blank" rel="noopener noreferrer">Buy on Amazon <span aria-hidden="true">↗</span></a><a href={instagramURL} target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a><a href={youtubeURL} target="_blank" rel="noopener noreferrer">YouTube <span aria-hidden="true">↗</span></a></div></div>
  <div class="footer-bottom"><p>Nubo is not a medical device and is not intended to diagnose, treat, cure, or prevent medical conditions.</p><div><p>© {currentYear} Clicksie LLC</p><nav aria-label="Legal"><a href="/privacy-policy/">Privacy policy</a><a href="/terms-of-use/">Terms of use</a></nav></div></div>
</div></footer>
<style>
  .site-footer { background: #f7f9f5; border-top: 1px solid #e1e7dc; padding-block: 3.5rem 1.75rem; }
  .footer-top { display: grid; grid-template-columns: 280px minmax(0,1fr); gap: 3.5rem; padding-bottom: 2.5rem; }
  .footer-brand > a { display: inline-flex; } .footer-brand > a img { width: 90px; height: auto; }
  .footer-brand > p { font-size: 1.0625rem; line-height: 1.6; color: var(--color-text-secondary); margin-block: 1rem 1.25rem; }
  .footer-brand :global(.store-badges img) { width: 128px; height: 45px; }
  .footer-columns { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.5rem; }
  .footer-columns h2 { font-size: .6875rem; text-transform: uppercase; letter-spacing: .06em; color: var(--color-brand-dark); margin-bottom: 1rem; }
  .footer-columns ul { list-style: none; display: grid; gap: .65rem; padding: 0; } .footer-columns a { color: var(--color-text-secondary); font-size: .8125rem; }
  .footer-connect { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-block: 1.25rem; border-block: 1px solid #dfe6da; color: var(--color-brand-dark); font-size: .8125rem; font-weight: 700; }
  .footer-connect > div { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .footer-bottom { padding-top: 1.25rem; } .footer-bottom > p { font-size: .6875rem; color: var(--color-text-secondary); line-height: 1.7; }
  .footer-bottom > div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem; font-size: .6875rem; color: var(--color-text-secondary); margin-top: 1rem; }
  .footer-bottom nav { display: flex; gap: 1.5rem; }
  a:hover { color: var(--color-brand-dark); text-decoration: underline; text-underline-offset: 3px; } a:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 4px; }
  @media (max-width: 900px) { .footer-top { grid-template-columns: 1fr; gap: 2rem; } }
  @media (max-width: 600px) { .site-footer { padding-block: 2.5rem 1.5rem; } .footer-columns { grid-template-columns: 1fr 1fr; gap: 1.75rem; } .footer-columns > div:last-child { grid-column: 1 / -1; } .footer-columns > div:last-child ul { grid-template-columns: 1fr 1fr; } .footer-connect > div { gap: 1rem; } }
</style>
