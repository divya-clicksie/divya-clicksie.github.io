---
import { appScreenshots } from '../data/appScreenshots';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['app-carousel', { 'app-carousel-compact': compact }]} data-app-carousel aria-roledescription="carousel" aria-label="Nubo app screenshots">
  <div class="app-carousel-stage">
    {appScreenshots.map(([label, src, alt], index) => (
      <figure class:list={['app-slide', { 'is-active': index === 0 }]} data-app-slide hidden={index !== 0}>
        <img src={src} alt={alt} width="642" height="1389" loading={compact || index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'auto' : 'low'} decoding="async" />
      </figure>
    ))}
  </div>
  <div class="app-carousel-controls" aria-label="App screenshot controls">
    <button type="button" class="app-carousel-btn" data-app-prev aria-label="Previous app screenshot"></button>
    <div class="app-carousel-dots" role="tablist" aria-label="Choose app screenshot">
      {appScreenshots.map(([label], index) => (
        <button type="button" class:list={['app-carousel-dot', { 'is-active': index === 0 }]} data-app-dot={index} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-label={`Show ${label}`}></button>
      ))}
    </div>
    <button type="button" class="app-carousel-btn" data-app-next aria-label="Next app screenshot"></button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-app-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-app-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLElement>('[data-app-dot]'));
    const prev = carousel.querySelector<HTMLButtonElement>('[data-app-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-app-next]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let rotation: number | undefined;

    const showSlide = (nextIndex: number) => {
      activeIndex = (nextIndex + slides.length) % slides.length;

      slides.forEach((slide, index) => {
        const active = index === activeIndex;
        slide.hidden = !active;
        slide.classList.toggle('is-active', active);
      });

      dots.forEach((dot, index) => {
        const active = index === activeIndex;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    };

    const stopRotation = () => {
      if (rotation) window.clearInterval(rotation);
      rotation = undefined;
    };

    const startRotation = () => {
      if (prefersReducedMotion || rotation || document.hidden) return;
      rotation = window.setInterval(() => showSlide(activeIndex + 1), 4500);
    };

    prev?.addEventListener('click', () => {
      stopRotation();
      showSlide(activeIndex - 1);
    });

    next?.addEventListener('click', () => {
      stopRotation();
      showSlide(activeIndex + 1);
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        stopRotation();
        showSlide(index);
      });
    });

    carousel.addEventListener('mouseenter', stopRotation);
    carousel.addEventListener('focusin', stopRotation);
    carousel.addEventListener('mouseleave', startRotation);
    carousel.addEventListener('focusout', (event) => {
      if (!carousel.contains(event.relatedTarget as Node)) startRotation();
    });
    document.addEventListener('visibilitychange', () => document.hidden ? stopRotation() : startRotation());
    startRotation();
  });
</script>

<style>
  .app-carousel { justify-self: center; width: min(100%, 360px); }
  .app-carousel-stage { position: relative; display: grid; place-items: center; min-height: 620px; }
  .app-carousel-stage::before { content: ""; position: absolute; inset: 3% 0; z-index: 0; border-radius: 46% 46% 38% 38%; background: var(--color-bg-peach); }
  .app-slide { position: relative; z-index: 1; margin: 0; text-align: center; }
  .app-slide[hidden] { display: none; }
  .app-slide img { display: block; max-height: 620px; width: auto; max-width: 100%; border-radius: 30px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.14); }
  .app-carousel-controls { display: grid; grid-template-columns: 2.25rem 1fr 2.25rem; align-items: center; gap: 0.75rem; margin-top: 1rem; }
  .app-carousel-btn { position: relative; width: 2.25rem; height: 2.25rem; border: 1px solid rgba(61, 179, 173, 0.28); border-radius: 999px; background: #fff; color: var(--color-brand-dark); cursor: pointer; }
  .app-carousel-btn::before { content: ""; position: absolute; top: 50%; left: 50%; width: 0.5rem; height: 0.5rem; border-top: 2px solid currentColor; border-right: 2px solid currentColor; }
  .app-carousel-btn[data-app-prev]::before { transform: translate(-42%, -50%) rotate(225deg); }
  .app-carousel-btn[data-app-next]::before { transform: translate(-58%, -50%) rotate(45deg); }
  .app-carousel-dots { display: flex; align-items: center; justify-content: center; gap: 0.45rem; }
  .app-carousel-dot { width: 0.55rem; height: 0.55rem; border: 0; border-radius: 999px; background: #c9e9ea; cursor: pointer; }
  .app-carousel-dot.is-active { width: 1.4rem; background: var(--color-brand); }
  .app-carousel-btn:focus-visible, .app-carousel-dot:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 3px; }
  .app-carousel-compact { width: clamp(130px, 30%, 190px); }
  .app-carousel-compact .app-carousel-stage { min-height: 0; aspect-ratio: 642 / 1389; }
  .app-carousel-compact .app-carousel-stage::before { display: none; }
  .app-carousel-compact .app-slide { position: absolute; inset: 0; }
  .app-carousel-compact .app-slide img { width: 100%; height: 100%; max-height: none; border-radius: 13px; box-shadow: 0 14px 32px rgba(27, 72, 76, 0.22); }
  .app-carousel-compact .app-carousel-controls { grid-template-columns: 1.75rem 1fr 1.75rem; gap: 0.3rem; margin-top: 0.5rem; }
  .app-carousel-compact .app-carousel-btn { width: 1.75rem; height: 1.75rem; }
  .app-carousel-compact .app-carousel-dots { gap: 0.24rem; }
  .app-carousel-compact .app-carousel-dot { width: 0.3rem; height: 0.3rem; }
  .app-carousel-compact .app-carousel-dot.is-active { width: 0.8rem; }

  @media (max-width: 640px) {
    .app-carousel:not(.app-carousel-compact) { width: min(100%, 300px); }
    .app-carousel:not(.app-carousel-compact) .app-carousel-stage { min-height: 520px; }
    .app-carousel:not(.app-carousel-compact) .app-slide img { max-height: 480px; }
    .app-carousel-compact .app-carousel-controls { width: 112px; margin-left: 50%; transform: translateX(-50%); grid-template-columns: 1.5rem 1fr 1.5rem; gap: 0.2rem; }
    .app-carousel-compact .app-carousel-btn { width: 1.5rem; height: 1.5rem; }
    .app-carousel-compact .app-carousel-dots { gap: 0.1rem; }
    .app-carousel-compact .app-carousel-dot { width: 0.25rem; height: 0.25rem; }
    .app-carousel-compact .app-carousel-dot.is-active { width: 0.6rem; }
  }
</style>
