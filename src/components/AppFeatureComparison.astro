---
import { free, plus } from '../data/appFeatureComparison';
import { nuboAccess } from '../data/nuboMessaging';

interface Props {
  heading?: string;
  intro?: string;
}

const {
  heading = 'See what is included before you download.',
  intro = 'Everyday tracking stays free. Your 14-day Nubo Plus preview starts when you confirm your child is here. Every Nubo Remote includes Plus. Nubo Care is included in Plus.',
} = Astro.props;

const featureGroups = [
  { label: 'Everyday tracking, included in both plans', features: free, freeIncluded: true },
  { label: 'Optional tools with Nubo Plus', features: plus, freeIncluded: false },
];
---

<section class="app-feature-comparison" aria-labelledby="app-feature-comparison-title">
  <div class="section-intro">
    <p class="overline">Free app vs Nubo Plus</p>
    <h2 id="app-feature-comparison-title">{heading}</h2>
    <p class="section-sub">{intro}</p>
  </div>
  <div class="feature-table-wrap">
    <table class="feature-table">
      <caption>Free app and Nubo Plus feature availability</caption>
      <colgroup>
        <col class="feature-name-col" />
        <col class="feature-status-col" />
        <col class="feature-status-col" />
      </colgroup>
      <thead>
        <tr>
          <th scope="col">Feature</th>
          <th scope="col">Nubo Free<span class="plan-price">$0</span></th>
          <th scope="col">Nubo Plus<span class="plan-price">$4.99<wbr />/month</span><span class="plan-billing">(billed annually)</span></th>
        </tr>
      </thead>
      <tbody>
        {featureGroups.map((group) => <>
          <tr class="feature-group"><th colspan="3">{group.label}</th></tr>
          {group.features.map((feature) => (
          <tr>
            <th scope="row">{feature}</th>
            <td>
              <span class:list={['feature-mark', group.freeIncluded ? 'feature-mark-included' : 'feature-mark-unavailable']}>
                <span class="sr-only">{group.freeIncluded ? 'Included' : 'Not included'}</span>
                <span aria-hidden="true">{group.freeIncluded ? '✓' : '−'}</span>
              </span>
            </td>
            <td>
              <span class="feature-mark feature-mark-included">
                <span class="sr-only">Included</span>
                <span aria-hidden="true">✓</span>
              </span>
            </td>
          </tr>
          ))}
        </>)}
      </tbody>
    </table>
  </div>
  <p class="availability-note">{nuboAccess.noticed} {nuboAccess.notetaker}</p>
  <div class="access-notes">
    <article><h3>Try Plus after baby arrives.</h3><p>Everyone gets a 14-day Plus preview, starting when you confirm your child is here. Downloading and creating a profile do not start it. The preview is separate from a subscription. Core tracking stays free after it ends.</p></article>
    <article><h3>Plus comes with Nubo Remote.</h3><p>Every Nubo Remote includes Plus access. Each phone that syncs with the device receives a refreshed 30-day window, including Nubo Care. <a href="/device/" class="text-link">Explore Nubo Remote <span aria-hidden="true">→</span></a></p></article>
  </div>
  <p class="pricing-note">Nubo Plus subscriptions are billed through the App Store on iPhone or Google Play billing on Android. Prices may vary by region; check your local price in the app before subscribing. <a href="/pricing/" class="text-link">See pricing and access details <span aria-hidden="true">→</span></a></p>
</section>

<style>
  .app-feature-comparison { margin: 3rem 0; }
  .app-feature-comparison .section-intro { margin-bottom: 1.5rem; text-align: left; }
  .app-feature-comparison .section-intro h2 { margin: 0.4rem 0 0.65rem; font-size: clamp(1.5rem, 3vw, 2rem); }
  .app-feature-comparison .section-sub { margin: 0; color: var(--color-text-secondary); line-height: 1.7; }
  .feature-table-wrap { overflow-x: auto; border: 1px solid #e8e8e8; border-radius: var(--radius-xl); background: #fff; box-shadow: 0 16px 38px rgba(31, 41, 55, 0.06); }
  .feature-table { width: 100%; table-layout: fixed; border-collapse: collapse; }
  .feature-name-col { width: 64%; }
  .feature-status-col { width: 18%; }
  .feature-table caption { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  .feature-table th, .feature-table td { padding: 1rem 1.25rem; border-bottom: 1px solid #ececec; vertical-align: middle; }
  .feature-table thead th { background: var(--color-bg-soft); color: var(--color-text); font-size: 0.84rem; font-weight: 800; line-height: 1.2; text-align: center; text-transform: uppercase; letter-spacing: 0.04em; }
  .feature-table thead th:first-child { text-align: left; }
  .plan-billing { display: block; margin-top: .35rem; color: var(--color-text-secondary); font-size: .7rem; font-weight: 500; letter-spacing: 0; text-transform: none; line-height: 1.4; }
  .plan-price { display: block; font-size: .875rem; letter-spacing: 0; text-transform: none; color: var(--color-brand-dark); margin-top: .6rem; }
  .feature-table tbody th { width: 64%; min-width: 360px; color: var(--color-text); font-size: 1rem; font-weight: 700; line-height: 1.45; text-align: left; overflow-wrap: anywhere; }
  .feature-table tbody td { width: 18%; text-align: center; }
  .feature-table .feature-group th { width: auto; min-width: 0; background: #eef7f4; color: var(--color-brand-dark); font-size: .8125rem; padding-block: .85rem; }
  .feature-table tbody tr:last-child th, .feature-table tbody tr:last-child td { border-bottom: 0; }
  .feature-mark { display: inline-grid; width: 1.75rem; height: 1.75rem; place-items: center; border-radius: 999px; font-weight: 900; line-height: 1; }
  .feature-mark-included { background: rgba(61, 179, 173, 0.16); color: var(--color-brand-dark); }
  .feature-mark-unavailable { border: 1px solid #d5d5d5; background: #f7f7f7; color: #8d8d8d; }
  .availability-note { font-size: .8125rem; color: var(--color-text-secondary); margin-top: 1rem; }
  .access-notes { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2rem; }
  .access-notes article { border-top: 2px solid #cce8e5; padding-top: 1rem; }
  .access-notes h3 { font-size: 1rem; }
  .access-notes p { font-size: .875rem; color: var(--color-text-secondary); margin-top: .6rem; }
  .access-notes .text-link, .pricing-note .text-link { font-size: inherit; }
  .pricing-note { font-size: .8125rem; color: var(--color-text-secondary); margin-top: 1.5rem; }

  @media (max-width: 640px) {
    .feature-table { min-width: 0; table-layout: fixed; }
    .feature-name-col { width: 58%; }
    .feature-status-col { width: 21%; }
    .feature-table th, .feature-table td { padding: 0.8rem 0.5rem; }
    .feature-table thead th { font-size: 0.7rem; letter-spacing: 0.03em; }
    .feature-table tbody th { width: 58%; min-width: 0; font-size: 0.86rem; line-height: 1.35; }
    .feature-table tbody td { width: 21%; }
    .plan-price { font-size: .7rem; line-height: 1.4; }
    .access-notes { grid-template-columns: 1fr; gap: 1.5rem; }
    .feature-mark { width: 1.45rem; height: 1.45rem; }
  }
</style>
