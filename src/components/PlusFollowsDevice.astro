---
interface Props { showImage?: boolean; }
const { showImage = true } = Astro.props;
---
<section class="plus-device-section">
  <div class:list={['container', 'plus-device-inner', { 'without-image': !showImage }]}>
    {showImage && <img src="/images/caregiver-hub.webp" alt="Nubo Remote and app connected across caregiver phones" width="970" height="600" loading="lazy" decoding="async" />}
    <div><p class="overline">Plus follows your Nubo Remote</p><div class="access-window"><strong>30</strong><span>days of Plus<br />refreshed with each sync</span></div><h2>Each syncing phone gets Plus.</h2><p>Including Nubo Care and Nubo Noticed all week. Nubo Remote access is separate from a store subscription.</p><a href="/pricing/" class="text-link">See Plus and access details <span aria-hidden="true">→</span></a></div>
  </div>
</section>
<style>
  .plus-device-section { padding-block: 3.5rem; background: var(--color-brand-light); }
  .plus-device-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .plus-device-inner > * { min-width: 0; } .plus-device-inner img { width: 100%; height: auto; }
  .without-image { grid-template-columns: 1fr; max-width: 800px; }
  .access-window { display: flex; gap: 1rem; align-items: center; margin-block: 1.2rem; color: var(--color-brand-dark); }
  .access-window strong { font-size: 4rem; line-height: 1; letter-spacing: -.05em; } .access-window span { font-size: .875rem; font-weight: 700; line-height: 1.5; }
  h2 { font-size: clamp(1.5rem,2.7vw,2rem); line-height: 1.2; letter-spacing: -.025em; }
  div > p:not(.overline) { margin-top: .85rem; max-width: 440px; color: var(--color-text-secondary); font-size: .9375rem; }
  .text-link { display: inline-block; margin-top: 1.25rem; font-size: .875rem; }
  @media (max-width: 680px) { .plus-device-inner { grid-template-columns: 1fr; gap: 1.5rem; } .plus-device-section { padding-block: 2.5rem; } .plus-device-inner img { max-width: 420px; margin-inline: auto; } .access-window strong { font-size: 3.5rem; } }
</style>
