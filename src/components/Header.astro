---
interface Props {
  ctaHref?: string;
  ctaLabel?: string;
  ctaExternal?: boolean;
  photoHero?: boolean;
}

const {
  ctaHref = '/app/#app-downloads',
  ctaLabel = 'Download free app',
  ctaExternal = false,
  photoHero = false
} = Astro.props;

const ctaAttrs = ctaExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const navLinks = [
  { href: '/care/', label: 'Nubo Care' },
  { href: '/app/', label: 'Baby Tracker' },
  { href: '/device/', label: 'Nubo Remote' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/resources/', label: 'Resources' },
];
const currentPath = Astro.url.pathname;
---

<header class:list={['site-header', { 'photo-hero-header': photoHero }]} id="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Nubo Baby Tracker Home">
      <img src="/images/nubo-logo.svg" alt="nubo" width="90" height="28" />
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {navLinks.map(({ href, label }) => <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>)}
    </nav>

    <a href={ctaHref} class="header-cta" {...ctaAttrs}>
      {ctaLabel}
    </a>

    <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav">
    <nav class="mobile-nav-links" aria-label="Mobile navigation">
      {navLinks.map(({ href, label }) => <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>)}
      <a href="/privacy/" aria-current={currentPath === '/privacy/' ? 'page' : undefined}>Trust &amp; Privacy</a>
      <a href="/faq/">FAQ</a>
      <a href={ctaHref} class="mobile-nav-cta" {...ctaAttrs}>
        {ctaLabel}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: transparent;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-header.scrolled {
    background: rgba(255, 250, 247, 0.94);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
  }

  .site-header.photo-hero-header { background: rgba(255, 250, 247, 0.96); }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 2rem;
  }

  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo img {
    height: 26px;
    width: auto;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    white-space: nowrap;
    font-size: 0.875rem;
    font-weight: 600;
    color: #3f4348;
    transition: color 0.2s;
    letter-spacing: 0;
  }

  .nav-links a:hover {
    color: var(--color-brand);
  }

  .nav-links a[aria-current="page"], .mobile-nav-links a[aria-current="page"] {
    color: var(--color-brand-dark);
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-brand);
    border-radius: 100px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
    letter-spacing: 0;
  }

  .header-cta:hover {
    background: var(--color-brand-dark);
    transform: scale(1.05);
    box-shadow: 0 4px 20px rgba(19, 188, 195, 0.3);
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: none;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }

  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background: #333;
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: center;
  }

  .mobile-menu-btn.open .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu-btn.open .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn.open .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .header-cta { display: none; }
    .header-inner { height: 60px; }
    .logo img { height: 22px; }
    .mobile-menu-btn { display: flex; }

    .mobile-nav {
      display: none;
      max-height: calc(100dvh - 60px);
      overflow-y: auto;
      background: rgba(255, 250, 247, 0.98);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-top: 1px solid rgba(0, 0, 0, 0.06);
      padding: 1rem 0 1.5rem;
    }

    .mobile-nav.open {
      display: block;
    }

    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      padding: 0 1.5rem;
    }

    .mobile-nav-links a {
      font-size: 1rem;
      font-weight: 600;
      color: #2f3337;
      padding: 0.75rem 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
      transition: color 0.2s;
    }

    .mobile-nav-links a:last-child {
      border-bottom: none;
    }

    .mobile-nav-links a:hover {
      color: var(--color-brand);
    }

    .mobile-nav-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 0.75rem;
      padding: 0.75rem 1.5rem;
      font-size: 0.9375rem;
      font-weight: 700;
      color: #fff !important;
      background: var(--color-brand);
      border-radius: 100px;
      border-bottom: none !important;
    }

    .mobile-nav-cta:hover {
      color: #fff !important;
      background: var(--color-brand-dark);
    }
  }
</style>

<script>
  const setupHeaderScroll = () => {
    const header = document.getElementById('site-header');
    if (!header) return;

    let ticking = false;
    let lastScrolled = false;
    const updateHeaderState = () => {
      const scrolled = window.scrollY > 40;
      if (scrolled !== lastScrolled) {
        header.classList.toggle('scrolled', scrolled);
        lastScrolled = scrolled;
      }
    };

    updateHeaderState();
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateHeaderState();
        ticking = false;
      });
    }, { passive: true });
  };

  const setupMobileMenu = () => {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileNav = document.getElementById('mobile-nav');
    if (!menuBtn || !mobileNav) return;

    const closeMenu = () => {
      menuBtn.classList.remove('open');
      mobileNav.classList.remove('open');
      menuBtn.setAttribute('aria-expanded', 'false');
      menuBtn.setAttribute('aria-label', 'Open menu');
    };

    menuBtn.addEventListener('click', () => {
      const isOpen = menuBtn.classList.toggle('open');
      mobileNav.classList.toggle('open');
      menuBtn.setAttribute('aria-expanded', String(isOpen));
      menuBtn.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    });

    mobileNav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        menuBtn.focus();
      }
    });
  };

  setupMobileMenu();

  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(setupHeaderScroll, { timeout: 1000 });
  } else {
    window.addEventListener('load', setupHeaderScroll, { once: true });
  }
</script>
