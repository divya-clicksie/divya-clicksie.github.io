---
interface Props { id?: string; hospital?: boolean; childName?: string; }
const { id = 'care-recap-preview', hospital = false, childName = 'Ella' } = Astro.props;
const visit = hospital ? `${childName}'s hospital conversation` : `${childName}'s pediatrician visit`;
const question = hospital ? 'What should we bring to the first checkup?' : 'What should we keep track of before the follow-up?';
const answer = hospital ? 'Bring your questions and the notes you keep from these first days.' : 'Keep a note of the feeding changes you notice and bring those observations to the next visit.';
const task = hospital ? 'Note questions for the first checkup.' : 'Save feeding observations for the follow-up.';
---

<figure class="recap-preview" aria-labelledby={`${id}-caption`}>
  <div class="preview-label"><span>Nubo Care</span><span>Sample visit</span></div>
  <div class="recap-sheet">
    <div class="visit-heading"><span class="visit-mark" aria-hidden="true">N</span><div><p>{visit}</p><span>Your visit, remembered.</span></div></div>
    <div class="answer-note"><span class="small-label">You asked</span><h3>{question}</h3><p class="answer-copy">{answer}</p><div class="audio-reference"><span class="play-symbol" aria-hidden="true">▶</span><div><strong>04:32 <span>in your recording</span></strong><p>Your pediatrician's original words</p></div></div></div>
    <div class="next-step"><span class="check-mark" aria-hidden="true">✓</span><div><span class="small-label">Reviewed next step</span><p>{task}</p></div></div>
  </div>
  <div class="caregiver-recap"><span class="sync-mark" aria-hidden="true">↗</span><div><strong>Shared with caregivers given access. Audio kept on your phone.</strong></div></div>
  <figcaption id={`${id}-caption`}>Illustrative visit recap. Audio replay is on the recording phone.</figcaption>
</figure>

<style>
  .recap-preview { margin: 0; min-width: 0; width: 100%; max-width: 520px; justify-self: center; background: var(--color-bg-ivory); border: 1px solid #e8e4e1; border-radius: 26px; padding: 1.35rem; }
  .preview-label { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; color: var(--color-brand-dark); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .recap-sheet { background: #fff; border: 1px solid #e8e4e1; border-radius: 18px; padding: 1.5rem; box-shadow: 0 12px 28px rgba(29, 29, 31, 0.05); }
  .visit-heading { display: flex; align-items: center; gap: 0.75rem; padding-bottom: 1.15rem; border-bottom: 1px solid #e8e4e1; }
  .visit-mark { display: grid; place-items: center; flex-shrink: 0; width: 38px; height: 38px; background: var(--color-brand-light); color: var(--color-brand-dark); border-radius: 12px; font-weight: 700; }
  .visit-heading p { font-size: 1.05rem; font-weight: 700; }
  .visit-heading div > span { display: block; color: var(--color-text-secondary); font-size: 0.75rem; margin-top: 0.15rem; }
  .small-label { display: block; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-text-secondary); }
  .answer-note { padding-block: 1.2rem; }
  .answer-note h3 { font-size: 1rem; line-height: 1.45; margin-top: 0.4rem; }
  .answer-copy { color: var(--color-text-secondary); font-size: 0.875rem; margin-top: 0.6rem; line-height: 1.65; }
  .audio-reference { display: flex; align-items: center; gap: 0.75rem; margin-top: 1rem; border: 1px solid #cce8eb; background: var(--color-brand-light); padding: 0.8rem; border-radius: 12px; color: var(--color-brand-dark); }
  .play-symbol { display: grid; place-items: center; background: #fff; width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0; font-size: 0.75rem; }
  .audio-reference strong { font-size: 0.875rem; }
  .audio-reference strong span { font-size: 0.6875rem; font-weight: 600; }
  .audio-reference p { margin-top: 0.15rem; font-size: 0.75rem; line-height: 1.5; }
  .next-step { display: flex; align-items: center; gap: 0.75rem; border-top: 1px solid #e8e4e1; padding-top: 1rem; }
  .check-mark { color: var(--color-brand-dark); background: var(--color-bg-ivory); border-radius: 50%; width: 26px; height: 26px; flex-shrink: 0; display: grid; place-items: center; font-size: 0.875rem; }
  .next-step p { font-size: 0.8125rem; font-weight: 600; margin-top: 0.25rem; line-height: 1.5; }
  .caregiver-recap { display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem 0.3rem 0.75rem; }
  .sync-mark { color: var(--color-brand-dark); font-size: 1.25rem; }
  .caregiver-recap strong { font-size: 0.8125rem; }
  figcaption { border-top: 1px solid #e8e4e1; padding-top: 0.7rem; color: var(--color-text-secondary); font-size: 0.6875rem; line-height: 1.55; }
  @media (max-width: 360px) { .recap-preview { padding: 1rem; } .recap-sheet { padding: 1rem; } .audio-reference strong span { display: block; } }
</style>
