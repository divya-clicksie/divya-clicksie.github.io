---
import SiteIcon from './SiteIcon.astro';

interface Props {
  id?: string;
  showDetailsLink?: boolean;
  compactHeading?: boolean;
  optional?: boolean;
}

const { id = 'device-logs', showDetailsLink = false, compactHeading = false, optional = false } = Astro.props;
const amazonURL = 'https://www.amazon.com/nubo-Newborn-Activity-Tracker-Color/dp/B0CJLNBG4P?maas=maas_adg_465D5CB69C73F660B7AD38831E2D680B_afap_abs&ref_=aa_maas&tag=maas';
const events = [
  { key: 'sleep', label: 'Sleep', entry: 'Sleep started', x: 63, y: 32.5, width: 29, height: 9.5, side: 'right' },
  { key: 'wake', label: 'Wake up', entry: 'Baby woke up', x: 33, y: 32.5, width: 20, height: 9.5, side: 'left' },
  { key: 'milk', label: 'Milk', entry: 'Pumped milk logged', x: 68, y: 60.5, width: 20, height: 14, side: 'right' },
  { key: 'formula', label: 'Formula', entry: 'Formula logged', x: 33, y: 60.5, width: 20, height: 14, side: 'left' },
  { key: 'pee', label: 'Pee', entry: 'Wet diaper logged', x: 63, y: 77, width: 29, height: 9.5, side: 'right' },
  { key: 'poop', label: 'Poop', entry: 'Dirty diaper logged', x: 33, y: 77, width: 20, height: 9.5, side: 'left' },
];
---

<section class:list={['remote-how', { 'compact-heading': compactHeading }]} id={id} aria-labelledby={`${id}-title`} data-remote-demo data-phase="shared">
  <div class="container">
    <div class="how-heading">
      {compactHeading ? <h2 id={`${id}-title`}>How Nubo Remote works</h2> : <><p class="overline">{optional ? 'Optional Nubo Remote' : 'How Nubo Remote works'}</p><h2 id={`${id}-title`}>A button tap.<br />Everyone in the loop.</h2><p>{optional ? 'Add dedicated buttons for everyday care when you want to leave your phone where it is. The Nubo app and Nubo Care work on their own.' : 'Log the moment without picking up your phone. Nubo takes it from there.'}</p></>}
    </div>

    <ol class="how-flow" role="list">
      <li class="how-step tap-step">
        <div class="step-heading"><span class="step-number" aria-hidden="true">1</span><h3>Tap Nubo Remote.</h3></div>
        <div class="step-visual tap-visual">
          <span class="visual-note">No screen. Just a button.</span>
          <div class="remote-demo">
            <div class="remote-photo">
              <img src="/images/hero-device.webp" alt="Nubo Remote, with physical buttons for waking, sleep, nursing, formula, pumped milk, poop, and pee" width="520" height="1077" loading="lazy" decoding="async" />
              {events.map((event, index) => (
                <span class:list={['tap-target', { 'is-selected': index === 0 }]} data-tap-target={event.key} style={`left:${event.x}%;top:${event.y}%;width:${event.width}%;height:${event.height}%`} aria-hidden="true"><span class="tap-dot"></span></span>
              ))}
            </div>
            <div class="event-choices" role="group" aria-label="Explore the Nubo Remote buttons">
              {events.map((event, index) => (
                <button class:list={['event-choice', `choice-${event.side}`]} type="button" style={`top:${event.y}%`} data-remote-event={event.key} data-entry={event.entry} aria-label={`Show ${event.label.toLowerCase()} button tap`} aria-pressed={index === 0 ? 'true' : 'false'}>{event.label}</button>
              ))}
            </div>
          </div>
        </div>
        <p class="step-description">Sleep and wake up. Milk and formula. Pee and poop. Press the matching button to record what happened and when.</p>
        <p class="step-detail">Dedicated left and right nursing buttons, too.</p>
        <span class="flow-arrow to-phone" aria-hidden="true"><SiteIcon name="bluetooth" size={19} /><span>→</span></span>
      </li>

      <li class="how-step phone-step">
        <div class="step-heading"><span class="step-number" aria-hidden="true">2</span><h3>Sync to a nearby phone.</h3></div>
        <div class="step-visual phone-visual">
          <span class="visual-note"><SiteIcon name="bluetooth" size={14} />Any paired caregiver’s phone</span>
          <div class="phone-preview">
            <img src="/images/appscreens/quick-actions-current.webp" alt="Nubo app showing the baby’s sleep and feeding activity" width="1284" height="2778" loading="lazy" decoding="async" />
          </div>
          <div class="sync-receipt"><span class="receipt-icon"><SiteIcon name="check" size={22} /></span><span><strong data-remote-entry>Sleep started</strong><small>From Nubo Remote</small></span></div>
        </div>
        <p class="step-description">Nubo Remote sends the log over Bluetooth to any nearby paired phone with the Nubo app. It can be yours, your partner’s, or another caregiver’s.</p>
        <p class="step-detail">Your phone can stay in your pocket.</p>
        <span class="flow-arrow to-caregivers" aria-hidden="true"><SiteIcon name="cloud" size={19} /><span>→</span></span>
      </li>

      <li class="how-step circle-step">
        <div class="step-heading"><span class="step-number" aria-hidden="true">3</span><h3>Share with all caregivers.</h3></div>
        <div class="step-visual circle-visual">
          <span class="visual-note">One shared baby timeline</span>
          <img class="caregiver-circle" src="/images/caregiver-hub.webp" alt="A circle of parents, grandparents, and caregivers, with their phones connected to Nubo Remote and to each other" width="1936" height="1170" loading="lazy" decoding="async" />
          <div class="shared-receipt"><SiteIcon name="users" size={18} /><span>Everyone’s up to date</span><SiteIcon name="check" size={17} /></div>
        </div>
        <p class="step-description">That phone shares the update through the internet with every invited caregiver, even when they’re away from home.</p>
        <p class="step-detail">You choose which details each person can see.</p>
      </li>
    </ol>

    <div class="demo-footer">
      <p class="demo-hint">Try a button to see what it logs.</p>
      <button class="demo-toggle" type="button" data-remote-toggle hidden aria-label="Pause Nubo Remote demo"><span class="playback-symbol" aria-hidden="true">Ⅱ</span><span data-toggle-label>Pause demo</span></button>
      <a href={showDetailsLink ? '/device/' : '/blog/product/nubo-bluetooth-sync/'} class="text-link">{showDetailsLink ? 'Explore Nubo Remote' : 'More about Bluetooth sync'} <span aria-hidden="true">→</span></a>
      {showDetailsLink && <a href={amazonURL} class="text-link" target="_blank" rel="noopener noreferrer">Buy on Amazon <span aria-hidden="true">↗</span></a>}
    </div>
    {showDetailsLink && <p class="remote-access">Each phone that syncs with Nubo Remote gets 30 days of Plus access, refreshed with each sync. Plus includes Nubo Care.</p>}
    <p class="sr-only" role="status" data-remote-status></p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-remote-demo]').forEach((demo) => {
    const choices = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-remote-event]'));
    const targets = Array.from(demo.querySelectorAll<HTMLElement>('[data-tap-target]'));
    const entry = demo.querySelector<HTMLElement>('[data-remote-entry]');
    const toggle = demo.querySelector<HTMLButtonElement>('[data-remote-toggle]');
    const toggleLabel = demo.querySelector<HTMLElement>('[data-toggle-label]');
    const symbol = demo.querySelector<HTMLElement>('.playback-symbol');
    const status = demo.querySelector<HTMLElement>('[data-remote-status]');
    if (!choices.length || !entry || !toggle || !toggleLabel || !symbol) return;

    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const phases = ['tap', 'phone', 'shared'];
    let current = 0;
    let phase = 0;
    let paused = false;
    let inView = false;
    let timer: number | undefined;

    const stop = () => {
      window.clearTimeout(timer);
      timer = undefined;
    };
    const updateToggle = () => {
      toggle.hidden = motion.matches;
      toggleLabel.textContent = paused ? 'Play demo' : 'Pause demo';
      symbol.textContent = paused ? '▷' : 'Ⅱ';
      toggle.setAttribute('aria-label', `${paused ? 'Play' : 'Pause'} Nubo Remote demo`);
    };
    const showEvent = (index: number) => {
      current = index;
      const choice = choices[current];
      choices.forEach((button, buttonIndex) => button.setAttribute('aria-pressed', String(buttonIndex === current)));
      targets.forEach((target) => target.classList.toggle('is-selected', target.dataset.tapTarget === choice.dataset.remoteEvent));
      entry.textContent = choice.dataset.entry || '';
    };
    const schedule = () => {
      stop();
      demo.classList.toggle('is-playing', !paused && !motion.matches && inView && !document.hidden);
      if (paused || motion.matches || !inView || document.hidden) return;
      timer = window.setTimeout(() => {
        phase = (phase + 1) % phases.length;
        if (phase === 0) showEvent((current + 1) % choices.length);
        demo.dataset.phase = phases[phase];
        schedule();
      }, phase === 2 ? 1800 : 1100);
    };

    choices.forEach((choice, index) => choice.addEventListener('click', () => {
      paused = true;
      phase = 2;
      showEvent(index);
      demo.dataset.phase = 'shared';
      if (status) status.textContent = `${choice.dataset.entry}. The log syncs to a nearby paired phone, then to all invited caregivers.`;
      updateToggle();
      schedule();
      if (!motion.matches) {
        demo.classList.remove('manual-tap');
        void demo.offsetWidth;
        demo.classList.add('manual-tap');
      }
    }));
    toggle.addEventListener('click', () => {
      paused = !paused;
      if (!paused) {
        phase = 0;
        demo.dataset.phase = 'tap';
        demo.classList.remove('manual-tap');
      }
      updateToggle();
      schedule();
    });
    document.addEventListener('visibilitychange', schedule);
    motion.addEventListener('change', () => {
      if (motion.matches) {
        phase = 2;
        demo.dataset.phase = 'shared';
      }
      updateToggle();
      schedule();
    });
    new IntersectionObserver(([observed]) => {
      inView = observed.isIntersecting;
      schedule();
    }, { threshold: 0 }).observe(demo);

    phase = motion.matches ? 2 : 0;
    demo.dataset.phase = phases[phase];
    updateToggle();
  });
</script>

<style>
  .remote-how { padding-block: 4.5rem; background: #fff; }
  .compact-heading { padding-top: 2rem; }
  .compact-heading .how-heading { margin-bottom: 2rem; }
  .compact-heading .how-heading h2 { font-size: clamp(1.5rem,2.5vw,1.9rem); }
  .how-heading { text-align: center; margin-bottom: 2.5rem; }
  .how-heading .overline { font-size: .6875rem; }
  .how-heading h2 { font-size: clamp(2rem,3.5vw,2.8rem); line-height: 1.15; letter-spacing: -.03em; text-wrap: balance; }
  .how-heading > p:last-child { margin: 1rem auto 0; max-width: 510px; color: var(--color-text-secondary); font-size: .9375rem; }
  .how-flow { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 2.25rem; margin: 0; padding: 0; list-style: none; }
  .how-step { position: relative; min-width: 0; }
  .step-heading { display: flex; align-items: center; gap: .65rem; margin-bottom: 1rem; }
  .step-number { display: grid; place-items: center; flex-shrink: 0; width: 27px; height: 27px; border-radius: 50%; color: var(--color-brand-dark); background: var(--color-brand-light); font-size: .75rem; font-weight: 700; }
  .step-heading h3 { font-size: 1.0625rem; letter-spacing: -.025em; line-height: 1.35; }
  .step-visual { position: relative; display: grid; place-items: center; height: 330px; overflow: hidden; border: 1px solid #e3e9df; border-radius: 24px; background: #f1f6ef; }
  .visual-note { position: absolute; top: 1rem; left: 0; right: 0; display: flex; justify-content: center; align-items: center; gap: .3rem; font-size: .625rem; font-weight: 700; color: #4e6653; z-index: 1; }
  .remote-demo { position: relative; width: 100%; height: 265px; margin-top: 1.75rem; }
  .remote-photo { position: relative; width: 128px; height: 265px; margin-inline: auto; filter: drop-shadow(0 7px 9px #304b3426); }
  .remote-photo > img { width: 100%; height: 100%; }
  .tap-target { position: absolute; display: none; transform: translate(-50%,-50%); border: 2px solid var(--color-brand); border-radius: 40%; background: #0ba3a61f; }
  .tap-target.is-selected { display: grid; place-items: center; }
  .tap-target::after { position: absolute; content: ''; inset: -3px; border: 2px solid var(--color-brand); border-radius: inherit; opacity: .45; }
  .tap-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-brand-dark); box-shadow: 0 0 0 4px #fff9; }
  .event-choice { position: absolute; transform: translateY(-50%); min-width: 64px; min-height: 38px; padding: .35rem .45rem; border: 1px solid #dae5d8; border-radius: 12px; background: #fffffff0; color: #47544b; font-size: .625rem; font-weight: 700; transition: background .2s, color .2s; }
  .choice-left { left: .65rem; }
  .choice-right { right: .65rem; }
  .event-choice[aria-pressed="true"] { color: #fff; background: var(--color-brand-dark); border-color: var(--color-brand-dark); }
  .event-choice:hover { border-color: var(--color-brand-dark); }
  .phone-visual { background: #f2f4fa; border-color: #e2e5ef; }
  .phone-visual .visual-note { color: #5c6081; }
  .phone-preview { position: relative; width: 142px; height: 288px; overflow: hidden; margin-top: 4.25rem; border-radius: 22px; box-shadow: 0 9px 25px #3846741c; }
  .phone-preview img { position: absolute; width: 138%; max-width: none; left: -19.7%; top: -32.2%; }
  .sync-receipt { position: absolute; left: 50%; bottom: 1.6rem; display: flex; align-items: center; gap: .65rem; width: max-content; max-width: calc(100% - 1.5rem); padding: .8rem .9rem; border: 1px solid #dae8de; border-radius: 15px; background: #fffffff5; transform: translateX(-50%); box-shadow: 0 6px 16px #304b3410; }
  .receipt-icon { display: grid; place-items: center; width: 33px; height: 33px; border-radius: 50%; background: var(--color-brand-light); color: var(--color-brand-dark); flex-shrink: 0; }
  .sync-receipt strong, .sync-receipt small { display: block; }
  .sync-receipt strong { font-size: .75rem; white-space: nowrap; }
  .sync-receipt small { font-size: .5625rem; color: var(--color-text-secondary); }
  .circle-visual { background: #fff6ec; border-color: #eee2d3; }
  .circle-visual .visual-note { color: #775a3a; }
  .caregiver-circle { width: calc(100% - 1rem); height: auto; margin-top: -.5rem; }
  .shared-receipt { position: absolute; bottom: 1.6rem; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: .45rem; padding: .65rem .8rem; border: 1px solid #e8dbcb; border-radius: 30px; background: #fff; color: var(--color-brand-dark); white-space: nowrap; font-size: .625rem; font-weight: 700; }
  .step-description { margin-top: 1.2rem; color: var(--color-text-secondary); font-size: .8125rem; line-height: 1.75; }
  .step-detail { margin-top: .65rem; color: var(--color-brand-dark); font-size: .6875rem; font-weight: 700; }
  .flow-arrow { position: absolute; top: 181px; right: -1.95rem; display: flex; flex-direction: column; align-items: center; gap: .1rem; color: #5b8176; }
  .flow-arrow > span { font-size: 1.5rem; line-height: 1; }
  .demo-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .5rem 1.5rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid #e7eae3; }
  .demo-hint { color: var(--color-text-secondary); font-size: .6875rem; }
  .demo-toggle { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; border: 0; padding: .5rem 0; background: none; color: var(--color-brand-dark); font-size: .6875rem; font-weight: 700; }
  .demo-toggle[hidden] { display: none; }
  .demo-footer .text-link { font-size: .75rem; }
  .remote-access { max-width: 640px; margin: .6rem auto 0; color: var(--color-text-secondary); text-align: center; font-size: .6875rem; }
  button:focus-visible, a:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 4px; }
  .is-playing[data-phase="tap"] .is-selected::after { animation: tap-ripple 1.1s ease-out infinite; }
  .manual-tap .is-selected::after { animation: tap-ripple .8s ease-out; }
  .is-playing[data-phase="phone"] .to-phone, .is-playing[data-phase="shared"] .to-caregivers { color: var(--color-brand-dark); animation: transfer .9s ease-in-out infinite; }
  .is-playing[data-phase="phone"] .sync-receipt { animation: receipt-arrives .4s ease-out; }
  .is-playing[data-phase="shared"] .shared-receipt { animation: receipt-arrives .4s ease-out; box-shadow: 0 0 0 5px #087f840f; }
  .is-playing[data-phase="tap"] .sync-receipt, .is-playing:not([data-phase="shared"]) .shared-receipt { opacity: 0; }
  @keyframes tap-ripple { from { opacity: .8; transform: scale(.9); } to { opacity: 0; transform: scale(1.7); } }
  @keyframes transfer { 50% { transform: translateX(3px); } }
  @keyframes receipt-arrives { from { opacity: .3; translate: 0 6px; } to { opacity: 1; translate: 0 0; } }
  @media (max-width: 1000px) and (min-width: 821px) {
    .how-flow { gap: 1.75rem; }
    .step-heading { gap: .45rem; }
    .step-heading h3 { font-size: .875rem; }
    .step-visual { height: 300px; }
    .remote-demo { height: 235px; }
    .remote-photo { width: 113.5px; height: 235px; }
    .event-choice { min-width: 52px; padding-inline: .2rem; font-size: .5625rem; }
    .choice-left { left: .25rem; } .choice-right { right: .25rem; }
    .flow-arrow { top: 168px; right: -1.55rem; }
    .phone-preview { width: 129px; height: 260px; }
    .visual-note { font-size: .5625rem; }
    .shared-receipt { padding-inline: .6rem; gap: .3rem; font-size: .5625rem; }
  }
  @media (max-width: 820px) {
    .remote-how { padding-block: 3rem; }
    .compact-heading { padding-top: 1.5rem; }
    .how-heading { margin-bottom: 2rem; }
    .how-heading h2 { font-size: clamp(1.8rem,7vw,2.3rem); }
    .how-heading > p:last-child { font-size: .875rem; }
    .how-flow { grid-template-columns: 1fr; gap: 3.5rem; max-width: 440px; margin-inline: auto; }
    .step-heading h3 { font-size: 1.125rem; }
    .step-visual { height: 330px; }
    .remote-demo { max-width: 350px; }
    .event-choice { min-width: 75px; font-size: .75rem; min-height: 44px; }
    .choice-left { left: 1rem; } .choice-right { right: 1rem; }
    .caregiver-circle { width: 92%; max-width: 360px; }
    .flow-arrow { top: auto; bottom: -2.7rem; right: calc(50% - 18px); flex-direction: row; transform: rotate(90deg); }
    .flow-arrow :global(svg) { transform: rotate(-90deg); }
    .is-playing[data-phase="phone"] .to-phone, .is-playing[data-phase="shared"] .to-caregivers { animation: none; }
    .demo-footer { margin-top: 1.75rem; gap: .3rem 1rem; }
    .demo-hint { flex-basis: 100%; text-align: center; }
  }
  @media (max-width: 480px) {
    .container { padding-inline: 1.25rem; }
    .event-choice { min-width: 68px; }
    .choice-left { left: .65rem; } .choice-right { right: .65rem; }
  }
  @media (max-width: 360px) {
    .event-choice { min-width: 60px; font-size: .6875rem; }
    .choice-left { left: .35rem; } .choice-right { right: .35rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .remote-how *, .remote-how *::after { animation: none !important; transition: none !important; }
  }
</style>
