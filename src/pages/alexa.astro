---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';

const title = 'Nubo Alexa Skill | Hands-Free Baby Logging';
const description = 'Hands full? Log feeds, sleep, and diapers from across the room with the Nubo Alexa skill, included in Plus. Events join your shared baby timeline.';
const alexaURL = 'https://www.amazon.com/Clicksie-LLC-Nubo-Baby-Tracker/dp/B0FJ2N8XKB';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Nubo Alexa Skill',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Amazon Alexa',
  description,
  image: 'https://www.nubotracker.com/images/nubo-alexa-echo-show.webp',
  publisher: {
    '@type': 'Organization',
    name: 'Nubo',
    url: 'https://www.nubotracker.com/'
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    url: alexaURL
  }
};
---

<MarketingLayout title={title} description={description} ogImage="/images/nubo-alexa-echo-show.webp" jsonLd={jsonLd}>
  <section class="m-hero"><div class="container m-split"><div><p class="overline">Nubo Alexa skill · Included in Plus</p><h1>Hands full?<br />Just ask Alexa.</h1><p class="m-lead">Making a bottle? At the changing table? Say what happened from across the room. Bottles, nursing, sleep, and diapers join your shared Nubo timeline.</p><div class="m-actions"><a href={alexaURL} class="btn-primary" target="_blank" rel="noopener noreferrer">Open the Alexa skill</a><a href="/pricing/" class="text-link">Explore Plus <span aria-hidden="true">→</span></a></div></div><figure class="echo-visual"><img class="m-photo" src="/images/nubo-alexa-echo-show.webp" srcset="/images/nubo-alexa-echo-show-720.webp 720w, /images/nubo-alexa-echo-show.webp 1280w" sizes="(max-width: 680px) 92vw, 46vw" alt="Nubo baby tracker dashboard on an Amazon Echo Show" width="1280" height="800" fetchpriority="high" /><figcaption><img src="/images/just-ask-alexa-badge.webp" alt="Just Ask Alexa" width="250" height="122" loading="lazy" /></figcaption></figure></div></section>
  <section class="m-section"><div class="container"><div class="m-heading center"><p class="overline">Everyday words for everyday care</p><h2>Say what happened.</h2><p>Use times like “five minutes ago,” then review your baby's history in the app.</p></div><div class="command-grid"><article><span class="m-icon peach"><SiteIcon name="bottle" /></span><p class="m-label">While making a bottle</p><blockquote>“Alexa, tell Newborn Tracker baby had four ounces of formula.”</blockquote></article><article><span class="m-icon lilac"><SiteIcon name="moon" /></span><p class="m-label">When baby wakes</p><blockquote>“Alexa, tell Newborn Tracker baby slept at 1 and woke up 10 minutes ago.”</blockquote></article><article><span class="m-icon"><SiteIcon name="users" /></span><p class="m-label">During a feed</p><blockquote>“Alexa, tell Newborn Tracker Sam started nursing five minutes ago.”</blockquote></article><article><span class="m-icon peach"><SiteIcon name="drop" /></span><p class="m-label">At the changing table</p><blockquote>“Alexa, tell Newborn Tracker that Ella had a dirty diaper.”</blockquote></article></div></div></section>
  <section class="m-section m-warm"><div class="container"><div class="m-heading center"><p class="overline">One connected day</p><h2>A spoken update.<br />The same shared timeline.</h2></div><ol class="m-grid three m-steps"><li><h3>Ask Alexa.</h3><p>Say the care event and when it happened.</p></li><li><h3>Nubo organizes it.</h3><p>The details become a structured baby-care log.</p></li><li><h3>Your team catches up.</h3><p>Caregivers review the same record in the app.</p></li></ol><div class="m-actions flow-actions"><a href="/app/" class="text-link">Explore the app <span aria-hidden="true">→</span></a><a href="/caregivers/" class="text-link">See shared care <span aria-hidden="true">→</span></a></div></div></section>
  <section class="m-section"><div class="container"><div class="m-heading"><p class="overline">Where voice is processed</p><h2>A clear privacy picture.</h2></div><div class="m-grid two"><article class="m-card"><span class="m-icon"><SiteIcon name="phone" /></span><p class="m-label">Free in-app voice logging</p><h3>On your phone.</h3><p>Talk to catch up, then review and edit events before saving. In-app speech recognition and event interpretation run on your phone, even offline.</p><a href="/app/#voice-logging" class="text-link">See in-app voice logging <span aria-hidden="true">→</span></a></article><article class="m-card"><span class="m-icon lilac"><SiteIcon name="cloud" /></span><p class="m-label">Alexa logging · Plus</p><h3>Through Amazon's Alexa systems.</h3><p>Amazon processes Alexa voice requests. The resulting events join your Nubo timeline.</p><a href="/privacy/" class="text-link">Read the privacy overview <span aria-hidden="true">→</span></a></article></div></div></section>
</MarketingLayout>
<style>
  .echo-visual { margin: 0; } .echo-visual figcaption { display: flex; justify-content: center; margin-top: 1rem; } .echo-visual figcaption img { width: 110px; height: auto; }
  .command-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; } .command-grid article { background: #f2f7f4; border: 1px solid #e0e8de; border-radius: 24px; padding: 1.75rem; } .command-grid article:nth-child(2n) { background: #f4f0f8; border-color: #e9e1ef; } .command-grid blockquote { font-size: 1.2rem; font-weight: 600; line-height: 1.6; }
  .flow-actions { justify-content: center; padding-top: .5rem; }
  @media (max-width: 680px) { .command-grid { grid-template-columns: 1fr; } .command-grid blockquote { font-size: 1.0625rem; } }
</style>
