---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FaqList from '../components/FaqList.astro';
import CareRecapPreview from '../components/CareRecapPreview.astro';
import HomeHero from '../components/HomeHero.astro';
import RemoteHowItWorks from '../components/RemoteHowItWorks.astro';
import StoreLinks from '../components/StoreLinks.astro';
import SiteIcon from '../components/SiteIcon.astro';

const title = 'Nubo | Baby Tracking & Doctor Visit Notes in One App';
const description = 'Track feeds, sleep, and observations free. Nubo Care adds doctor visit questions, recordings, and shared next steps. Everyday care and doctor visits in one app.';
const stores = [
  { href: 'https://apps.apple.com/us/app/nubo-baby-tracker/id1667461158', image: '/images/appstore-badge.webp', label: 'Download on the App Store' },
  { href: 'https://play.google.com/store/apps/details?id=com.clicksie.nuboapp', image: '/images/playstore-badge.webp', label: 'Get it on Google Play' },
];
const careSteps = [
  { title: 'Prepare your questions.', body: 'Start with whatever is on your mind. If you have saved observations, Care summarizes the relevant notes and suggests questions for you to review and edit.' },
  { title: 'Record with permission.', body: 'Ask everyone taking part for permission, then record the conversation in the Nubo app. You can prepare questions and take notes instead.' },
  { title: 'Review the answers and next steps.', body: 'Come back to a summary of the visit. On the phone that recorded it, tap an answer’s timestamp to hear that part of the conversation again.' },
  { title: 'Share the follow-up with caregivers.', body: 'If your partner missed the visit, share the reviewed answers and to-dos. The primary caregiver chooses which visit details each person can see.' },
];
const faqItems = [
  { q: 'Are baby tracking and Nubo Care in the same app?', a: 'Yes. Download the Nubo app on iPhone or Android for both. Use free tracking for everyday care. Nubo Care is a feature of the same app, included in the paid Plus plan.' },
  { q: 'What stays free, and what does Plus cost?', a: 'Feeds, sleep, diapers, observations, in-app voice logging, unlimited caregivers, offline mode, and private backup stay free. Nubo Plus includes Care and additional tools for $59.99 per year. Subscriptions use App Store or Google Play billing. Prices may vary by region.' },
  { q: 'Can I download Nubo before my baby arrives?', a: 'Yes. Downloading the app and creating a profile do not start your 14-day Plus preview. It begins when you confirm your child is here. The preview is separate from a subscription. Everyday tracking stays free afterward.' },
  { q: 'Do I need a tracking history or a visit recording to use Care?', a: 'No. Start with your own questions, even at your first hospital conversation. Saved observations can add context when you have them. You can prepare questions and take notes without recording. If you choose to record, get permission from everyone taking part. Recording and summaries support English.' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': 'https://www.nubotracker.com/#organization',
      name: 'Nubo', legalName: 'Clicksie LLC', url: 'https://www.nubotracker.com/',
      logo: 'https://www.nubotracker.com/images/nubo-logo.svg',
      sameAs: ['https://www.instagram.com/nubo_baby_tracker', 'https://www.youtube.com/@NuboBabyTracker'],
    },
    {
      '@type': 'MobileApplication', '@id': 'https://www.nubotracker.com/app/#application',
      name: 'Nubo Baby Tracker', url: 'https://www.nubotracker.com/app/',
      operatingSystem: 'iOS, Android', applicationCategory: 'HealthApplication',
      description: 'Everyday baby tracking and doctor visit notes in one Nubo app. Tracking, voice logging, observations, and caregiver sharing stay free. Nubo Care, included in paid Plus, adds visit preparation, recording, answers, and shared next steps.',
      image: 'https://www.nubotracker.com/images/appscreens/01_onetouch.webp',
      publisher: { '@id': 'https://www.nubotracker.com/#organization' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: ['Nubo Care suggested visit questions, recording, and recaps with Nubo Plus', 'Nubo Scribe doctor recordings and answers linked to the original audio', 'Nubo Coordinator follow-up with shared visit next steps and to-dos', 'Nubo Intelligence built-in AI across everyday care and doctor visits', 'Free in-app voice logging with on-device processing', 'Nubo Observations for anything parents notice beyond buttons and forms', 'Nubo Intelligence follows up on reported symptoms and summarizes relevant observations for doctor visits', 'Nubo Intelligence suggests pediatrician questions using saved observations and your baby’s age', 'Nubo Noticed recorded-pattern insights with Plus, free for everyone on Mondays', 'Quick logs for feeds, sleep, and diapers', 'Unlimited caregivers across iPhone and Android', 'Offline tracking and private backup'],
      installUrl: stores.map((store) => store.href), downloadUrl: stores.map((store) => store.href),
    },
    {
      '@type': 'FAQPage', '@id': 'https://www.nubotracker.com/#questions',
      mainEntity: faqItems.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
    {
      '@type': 'WebPage', '@id': 'https://www.nubotracker.com/#webpage',
      name: title, description, url: 'https://www.nubotracker.com/',
      about: { '@id': 'https://www.nubotracker.com/app/#application' },
    },
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} ogImage="/images/nubo-home-feeding-v1-1536.webp">
  <Header ctaHref="#app-downloads" photoHero />
  <main id="main-content">
    <HomeHero />

    <section class="app-overview section-space" id="one-app" aria-labelledby="one-app-title">
      <div class="container">
        <div class="section-heading">
          <p class="overline">One Nubo app</p>
          <h2 id="one-app-title">Baby tracking and doctor visit notes,<br />together in one app.</h2>
          <p class="section-sub">Keep everyday care notes connected to your questions, your doctor’s answers, and the next steps you share with caregivers.</p>
        </div>
        <div class="app-overview-grid">
          <article class="app-overview-card tracker-overview" aria-labelledby="tracker-overview-title">
            <span class="feature-icon"><SiteIcon name="phone" size={26} /></span>
            <p class="eyebrow">Everyday care · Free</p>
            <h3 id="tracker-overview-title">Baby Tracker</h3>
            <p>Log feeds, sleep, and diapers. Save observations in your own words, catch up by voice, and share updates with the people caring for your baby.</p>
            <a href="#everyday-care" class="text-link">See free tracking features <span aria-hidden="true">↓</span></a>
          </article>
          <article class="app-overview-card care-overview" aria-labelledby="care-overview-title">
            <span class="feature-icon sharing-icon"><SiteIcon name="questions" size={26} /></span>
            <p class="eyebrow">Doctor visits · Paid Plus plan</p>
            <h3 id="care-overview-title">Nubo Care</h3>
            <p>Prepare questions, record visits with permission, and review your doctor’s answers. Share reviewed next steps with your caregivers.</p>
            <a href="#nubo-care" class="text-link">See how Nubo Care works <span aria-hidden="true">↓</span></a>
          </article>
        </div>
        <p class="overview-note">Both are part of the same app on iPhone and Android. Your 14-day Plus preview includes Nubo Care.</p>
      </div>
    </section>

    <aside class="trust-strip" aria-label="Nubo app essentials">
      <div class="container trust-inner">
        <span><SiteIcon name="mic" size={19} />Free voice logging, even offline</span>
        <span><SiteIcon name="users" size={19} />Free caregiver sharing</span>
        <a href="/privacy/"><SiteIcon name="lock" size={19} />Privacy and sharing controls <span aria-hidden="true">↗</span></a>
      </div>
    </aside>

    <section class="care-section section-space" id="nubo-care" aria-labelledby="care-title">
      <div class="container">
        <div class="section-heading"><p class="overline">Nubo Care · Included in Plus</p><h2 id="care-title">Prepare your questions.<br />Keep the answers and next steps.</h2><p class="section-sub">You noticed a change in feeding during the week. Bring that note to the visit, record with permission, and share your pediatrician’s next steps with a partner who couldn’t be there.</p></div>
        <div class="care-grid" id="care-loop">
          <ol class="care-steps" role="list">{careSteps.map((step, index) => <li><span class="step-number" aria-hidden="true">{index + 1}</span><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol>
          <div class="care-example"><CareRecapPreview id="home-care-recap" /><p class="processing-note">Nubo sends selected visit content to a server to create your summary. Nubo and its processing providers keep no visit data after processing. <a href="/privacy/#processing">How visit data is processed <span aria-hidden="true">→</span></a></p></div>
        </div>
        <div class="care-actions"><a href="/care/" class="btn-primary">See how Nubo Care works <span aria-hidden="true">→</span></a><a href="/pricing/" class="text-link">See Plus pricing <span aria-hidden="true">→</span></a></div>
        <p class="care-access">Nubo Care is included in the paid Plus plan. Recording and summaries support English.<br />Start with your own questions, even before you have any tracking history.</p>
        <aside class="care-privacy" id="care-privacy" aria-label="Visit recording and sharing"><span><SiteIcon name="mic" size={20} />Ask permission before recording</span><span><SiteIcon name="phone" size={20} />Original audio stays on the recording phone</span><span><SiteIcon name="users" size={20} />Choose which visit details each caregiver can see</span></aside>
      </div>
    </section>

    <section class="tracker-section section-space" id="everyday-care" aria-labelledby="tracker-title">
      <div class="container">
        <div class="section-heading" id="baby-care-details">
          <p class="overline">Baby Tracker · Free on iPhone and Android</p>
          <h2 id="tracker-title">Track feeds, sleep,<br />and everyday observations.</h2>
          <p class="section-sub">Between visits, check the last feed and today’s sleep. Speak or type what you notice in your own words, ready to bring up at the next appointment. Everyday tracking stays free in the same Nubo app.</p>
        </div>
        <div class="tracker-grid">
          <figure class="tracker-preview">
            <div class="app-screen"><img src="/images/appscreens/quick-actions-current.webp" alt="Nubo app showing sleep and feeding logs, quick logging buttons, and a summary of changes in bottle feeding" width="1284" height="2778" loading="lazy" decoding="async" /></div>
            <figcaption>Sample app data. Pattern insights shown are included in Plus and are free on Mondays.</figcaption>
          </figure>
          <div class="tracker-features">
            <article class="tracker-feature" id="one-tap-logging"><span class="feature-icon"><SiteIcon name="phone" size={24} /></span><div><p class="eyebrow">Quick Log · Free</p><h3>Log a feed, nap, or diaper change.</h3><p>Use the app’s Quick Log buttons to record each activity and check recent entries.</p></div></article>
            <article class="tracker-feature" id="voice-logging"><span class="feature-icon intelligence-icon"><SiteIcon name="sparkles" size={24} /></span><div><p class="eyebrow">Voice logging · Free</p><h3>Catch up by voice.</h3><p>Say “She had 90 mL at eight,” then review the entry before saving. Voice logging works on your phone, even offline.</p><a href="/app/#voice-logging" class="text-link">See voice logging in the app <span aria-hidden="true">→</span></a></div></article>
            <article class="tracker-feature"><span class="feature-icon sharing-icon"><SiteIcon name="questions" size={24} /></span><div><p class="eyebrow">Observations · Free</p><h3>Save the details you want to remember.</h3><p>Speak or type what you notice about your baby in your own words. With Care, review a summary of relevant observations before your doctor visit.</p><a href="/app/#observations" class="text-link">See how observations work <span aria-hidden="true">→</span></a></div></article>
            <article class="tracker-feature"><span class="feature-icon sharing-icon"><SiteIcon name="users" size={24} /></span><div><p class="eyebrow">Shared care · Free</p><h3>Share updates with your caregivers.</h3><p>Check the last feed before your turn. Invite your partner, family, or nanny on iPhone or Android. The primary caregiver chooses which details each person can see.</p></div></article>
            <a href="/app/" class="btn-primary tracker-link">Explore the free baby tracker <span aria-hidden="true">→</span></a>
            <p class="access-note">Quick Log, voice logging, observations, and unlimited caregivers stay free. Plus adds Care for doctor visits and more app tools.</p>
          </div>
        </div>
        <figure class="mobile-comfort-photo">
          <img src="/images/nubo-home-comforting-v1-768.webp" srcset="/images/nubo-home-comforting-v1-480.webp 480w, /images/nubo-home-comforting-v1-768.webp 768w" sizes="(max-width: 560px) calc(100vw - 40px), 520px" alt="Concept photo of a father gently comforting his baby against his shoulder" width="1536" height="1024" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <section class="questions-section section-space" id="questions" aria-labelledby="questions-title">
      <div class="container questions-grid">
        <div class="questions-copy"><p class="overline">Before you download</p><h2 id="questions-title">One app.<br />Free tracking. Care with Plus.</h2><p>Start with everyday care. Explore Care for your next doctor visit, with no separate app to set up.</p><a href="/pricing/" class="text-link">Compare Free and Plus <span aria-hidden="true">→</span></a></div>
        <FaqList items={faqItems} />
      </div>
    </section>

    <section class="final-cta" id="app-downloads" aria-labelledby="download-title">
      <div class="container"><span class="closing-mark"><SiteIcon name="leaf" size={30} /></span><p class="overline">On iPhone and Android</p><h2 id="download-title">Download Nubo for everyday care<br />and doctor visit notes.</h2><p>Start with free baby tracking and caregiver sharing.<br />Nubo Care adds visit preparation, recordings, and shared next steps with paid Plus.</p><div class="closing-stores"><StoreLinks /></div><p class="final-note">Your 14-day Plus preview starts when you confirm your child is here.<br />Downloading before your baby arrives does not start it. The preview is separate from a subscription.<br />Tracking, voice logging, observations, and caregiver sharing stay free afterward.</p><a href="/pricing/" class="text-link">See Plus pricing <span aria-hidden="true">→</span></a><a href="/faq/" class="text-link">More app and Care questions <span aria-hidden="true">→</span></a></div>
    </section>

    <RemoteHowItWorks id="device" showDetailsLink optional />
  </main>
  <Footer />
</BaseLayout>

<style>
  main [id] { scroll-margin-top: 96px; }
  .trust-strip { background: var(--color-brand-light); color: var(--color-brand-dark); }
  .trust-inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .75rem 1.5rem; padding-block: 1.1rem; }
  .trust-inner > * { display: flex; align-items: center; gap: .6rem; font-size: .75rem; font-weight: 700; }
  .trust-inner :global(svg) { flex-shrink: 0; }
  .section-space { padding-block: 5rem; }
  .section-heading { text-align: center; margin-bottom: 3rem; }
  .section-heading .overline { font-size: .6875rem; }
  h2 { font-size: clamp(2rem,3.5vw,2.9rem); line-height: 1.15; letter-spacing: -.03em; text-wrap: balance; }
  h3 { font-size: 1.35rem; line-height: 1.3; letter-spacing: -.02em; }
  .section-sub { max-width: 540px; margin: 1rem auto 0; color: var(--color-text-secondary); font-size: 1rem; }
  .eyebrow { color: var(--color-brand-dark); font-size: .6875rem; font-weight: 700; letter-spacing: .045em; text-transform: uppercase; margin-bottom: .4rem; }
  .app-overview-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.5rem; }
  .app-overview-card { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; padding: 2rem; border: 1px solid #dfe9e1; border-radius: 26px; }
  .tracker-overview { background: #eef6f1; }
  .care-overview { background: #fff7ee; border-color: #eee2d3; }
  .app-overview-card .feature-icon { margin-bottom: 1.25rem; }
  .app-overview-card h3 { font-size: 1.75rem; }
  .app-overview-card > p:not(.eyebrow) { margin-top: .85rem; margin-bottom: 1.25rem; color: var(--color-text-secondary); font-size: .9375rem; line-height: 1.75; }
  .app-overview-card .text-link { margin-top: auto; font-size: .875rem; }
  .overview-note { margin-top: 1.5rem; color: var(--color-text-secondary); text-align: center; font-size: .8125rem; }
  .tracker-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 4rem; align-items: center; }
  .mobile-comfort-photo { display: none; }
  .tracker-preview { position: relative; height: 575px; margin: 0; padding-top: 2rem; overflow: hidden; border: 1px solid #dfe9e1; border-radius: 30px; background: #eef6f1; }
  .app-screen { position: relative; width: 250px; aspect-ratio: 686 / 1430; margin-inline: auto; overflow: hidden; border-radius: 30px; box-shadow: 0 10px 35px #24463b1a; }
  .app-screen img { position: absolute; width: 138%; max-width: none; left: -19.7%; top: -32.2%; }
  .tracker-preview figcaption { position: absolute; inset: auto 0 0; padding: .8rem 1rem; background: #eef6f1; text-align: center; color: var(--color-text-secondary); font-size: .625rem; }
  .tracker-features { min-width: 0; }
  .tracker-feature { display: flex; gap: 1rem; margin-bottom: 1.8rem; }
  .feature-icon { display: grid; place-items: center; flex-shrink: 0; width: 46px; height: 46px; border-radius: 15px; color: var(--color-brand-dark); background: #e9f5f1; }
  .intelligence-icon { color: #67518b; background: #f1eef8; }
  .sharing-icon { color: #895b34; background: #fff0e2; }
  .tracker-feature h3 { font-size: 1.25rem; }
  .tracker-feature p:not(.eyebrow) { margin-top: .6rem; color: var(--color-text-secondary); font-size: .875rem; line-height: 1.75; }
  .tracker-feature .text-link { display: inline-block; margin-top: .65rem; font-size: .8125rem; }
  .tracker-link { font-size: .875rem; gap: .75rem; }
  .access-note { max-width: 410px; margin-top: 1rem; color: var(--color-text-secondary); font-size: .6875rem; }
  .care-section { background: var(--color-bg-ivory); }
  .care-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 4rem; align-items: start; }
  .care-steps { list-style: none; padding: 0; margin: 0; }
  .care-steps li { position: relative; padding: 1.1rem 0 1.1rem 3rem; border-top: 1px solid #e4e5da; }
  .step-number { position: absolute; top: 1.2rem; left: 0; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: #e6f2ed; color: var(--color-brand-dark); font-size: .875rem; font-weight: 700; }
  .care-steps h3 { font-size: 1.125rem; }
  .care-steps p { margin-top: .4rem; font-size: .8125rem; line-height: 1.75; color: var(--color-text-secondary); }
  .care-example { min-width: 0; }
  .processing-note { font-size: .6875rem; color: var(--color-text-secondary); margin-top: 1rem; line-height: 1.7; }
  .processing-note a { color: var(--color-brand-dark); text-decoration: underline; text-underline-offset: 3px; }
  .care-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1rem 1.5rem; margin-top: 2.25rem; font-size: .875rem; }
  .care-actions .btn-primary { font-size: .875rem; gap: .75rem; }
  .care-access { text-align: center; font-size: .75rem; line-height: 1.8; color: var(--color-text-secondary); margin-top: 1rem; }
  .care-privacy { display: grid; grid-template-columns: .8fr 1.1fr 1.1fr; gap: 1.5rem; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid #e4e5da; }
  .care-privacy > span { display: flex; align-items: center; gap: .6rem; color: var(--color-brand-dark); font-size: .6875rem; }
  .care-privacy :global(svg) { flex-shrink: 0; }
  .questions-section { background: #f0f7f3; }
  .questions-grid { display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); gap: 4rem; align-items: start; }
  .questions-copy .overline { font-size: .6875rem; }
  .questions-copy p:not(.overline) { color: var(--color-text-secondary); font-size: .9375rem; margin-top: 1rem; }
  .questions-copy .text-link { display: inline-block; margin-top: 1.25rem; font-size: .875rem; }
  .final-cta { padding-block: 4rem; text-align: center; }
  .closing-mark { display: inline-flex; color: var(--color-brand); margin-bottom: 1rem; }
  .final-cta > .container > p { color: var(--color-text-secondary); margin-top: 1rem; }
  .closing-stores { display: flex; justify-content: center; margin-top: 1.5rem; }
  .final-cta .final-note { font-size: .75rem; line-height: 1.8; }
  .final-cta .text-link { display: inline-block; margin: 1.25rem .75rem 0; font-size: .8125rem; }
  a:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 5px; }
  @media (max-width: 1000px) { .tracker-grid, .care-grid { gap: 2.5rem; } .trust-inner { justify-content: center; } }
  @media (max-width: 760px) {
    .tracker-grid, .care-grid, .questions-grid { grid-template-columns: 1fr; gap: 2rem; }
    .app-overview-grid { grid-template-columns: 1fr; }
    .mobile-comfort-photo { display: block; width: 100%; max-width: 520px; margin: 2rem auto 0; border-radius: 24px; overflow: hidden; }
    .mobile-comfort-photo img { width: 100%; height: auto; }
    .tracker-preview { width: 100%; max-width: 520px; justify-self: center; height: 475px; padding-top: 1.75rem; }
    .app-screen { width: 220px; }
    .tracker-features { max-width: 540px; margin-inline: auto; }
    .care-example { max-width: 520px; justify-self: center; }
    .care-privacy { grid-template-columns: 1fr; gap: .85rem; }
  }
  @media (max-width: 680px) {
    .container { padding-inline: 1.25rem; }
    .section-space { padding-block: 3.25rem; }
    .section-heading { margin-bottom: 2rem; }
    .section-heading .overline { font-size: .625rem; }
    h2 { font-size: clamp(1.8rem,7vw,2.3rem); }
    .section-sub { font-size: .9375rem; }
    .app-overview-card { padding: 1.5rem; }
    .trust-inner { justify-content: flex-start; gap: .7rem; }
    .trust-inner > * { flex-basis: 100%; font-size: .6875rem; }
    .tracker-feature { gap: .8rem; margin-bottom: 1.5rem; }
    .feature-icon { width: 40px; height: 40px; border-radius: 12px; }
    .tracker-feature h3 { font-size: 1.2rem; }
    .care-access { font-size: .6875rem; }
    .final-cta { padding-block: 3rem; }
    .final-cta .final-note { font-size: .6875rem; }
  }
</style>
