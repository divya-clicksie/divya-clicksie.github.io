---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VisualPlaceholder from '../components/VisualPlaceholder.astro';
import CareRecapPreview from '../components/CareRecapPreview.astro';
import CareHeroSlideshow from '../components/CareHeroSlideshow.astro';

const title = 'Nubo Care | Never Forget What Your Pediatrician Said';
const description = 'Nubo will help you prepare for the doctor visit, record and recap the conversations, follow up with next steps, and track the care.';
const amazonURL = 'https://www.amazon.com/nubo-Newborn-Activity-Tracker-Color/dp/B0CJLNBG4P?maas=maas_adg_465D5CB69C73F660B7AD38831E2D680B_afap_abs&ref_=aa_maas&tag=maas';
const stores = [
  { href: 'https://apps.apple.com/us/app/nubo-baby-tracker/id1667461158', image: '/images/appstore-badge.webp', label: 'Download on the App Store' },
  { href: 'https://play.google.com/store/apps/details?id=com.clicksie.nuboapp', image: '/images/playstore-badge.webp', label: 'Get it on Google Play' },
];
const questions = [
  { question: 'Should I download Nubo before my baby is born?', answer: 'Yes. Get familiar with the app before those busy first days. Downloading and creating a profile do not start your 14-day Plus preview. It starts when you confirm your child is here.' },
  { question: 'Can I use Nubo Care at the first hospital conversation?', answer: 'Yes. Start with your questions and record the conversation with your care team’s permission. You do not need a tracking history. Nubo Care is included in Plus and is available worldwide, in English.' },
  { question: 'Can I hear what the doctor actually said?', answer: 'Every answer extracted from a recording links to its actual audio timestamps. Replay that passage on the phone that recorded the conversation. Manually entered notes do not have audio references.' },
  { question: 'What do my other caregivers see?', answer: 'Your invited caregivers receive the visit summary, question answers, to-dos, and other visit records. The audio recording stays on the recording phone and is not synced to caregivers. Everyday tracking already supports unlimited caregivers on iPhone and Android.' },
  { question: 'Is Nubo Care included in Nubo Plus?', answer: 'Yes. Care is included in Plus, everyone’s 14-day Plus preview, and device-owner Plus access. The preview starts when parents confirm the child is here. Everyday tracking, Quick Log, in-app voice logging, and caregiver sharing remain free.' },
  { question: 'Where is my visit processed and stored?', answer: 'Care processing happens on the server, with zero data retention after processing. Visit records are stored on phones and backed up to your private backups. Audio remains available on the recording phone. Everyday in-app voice logging runs on your phone.' },
  { question: 'Do I need the Nubo device?', answer: 'No. The app works on its own. The optional device adds dedicated buttons for feeds, sleep, and diapers. Every phone that syncs with the device gets Plus, with each sync refreshing a 30-day access window.' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': 'https://www.nubotracker.com/#organization',
      name: 'Nubo', legalName: 'Clicksie LLC', url: 'https://www.nubotracker.com/',
      logo: 'https://www.nubotracker.com/images/nubo-logo.svg',
      sameAs: ['https://www.instagram.com/nubo_baby_tracker', 'https://www.youtube.com/@NuboBabyTracker'],
    },
    {
      '@type': 'MobileApplication', '@id': 'https://www.nubotracker.com/app/#application',
      name: 'Nubo Baby Tracker', url: 'https://www.nubotracker.com/app/',
      operatingSystem: 'iOS, Android', applicationCategory: 'HealthApplication',
      description: 'Nubo Care helps parents prepare questions, record pediatrician visits, and revisit answers and next steps. Everyday baby tracking and caregiver sharing are free. Care is included in Nubo Plus.',
      image: 'https://www.nubotracker.com/images/appscreens/01_onetouch.webp',
      publisher: { '@id': 'https://www.nubotracker.com/#organization' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: ['Nubo Care visit questions, recording, and recaps with Nubo Plus', 'Answers linked to the original visit audio', 'Shared visit summaries and next steps', 'Free in-app voice logging with on-device processing', 'Quick logs for feeds, sleep, and diapers', 'Unlimited caregivers across iPhone and Android', 'Offline tracking and private backup'],
      installUrl: stores.map((store) => store.href), downloadUrl: stores.map((store) => store.href),
    },
    {
      '@type': 'WebPage', '@id': 'https://www.nubotracker.com/#webpage',
      name: title, description, url: 'https://www.nubotracker.com/',
      about: { '@id': 'https://www.nubotracker.com/app/#application' },
    },
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} ogImage="/images/nubo-care-hospital-phone-v2.webp">
  <Header ctaHref="#app-downloads" photoHero />
  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <CareHeroSlideshow />
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="container hero-inner">
        <div class="hero-content">
          <p class="hero-eyebrow">From newborn hospital days to growing years</p>
          <h1 id="hero-title">Never forget what your pediatrician said.</h1>
          <p class="hero-sub">Nubo will help you prepare for the doctor visit, record and recap the conversations, follow up with next steps, and track the care.</p>
          <div class="hero-download">
            <p>Bring Nubo to your next appointment.</p>
            <div class="store-links hero-actions" aria-label="Download the free Nubo app">
              {stores.map((store) => <a href={store.href} target="_blank" rel="noopener noreferrer" aria-label={store.label}><img src={store.image} alt={store.label} width="160" height="56" /></a>)}
            </div>
            <p class="hero-note">Privacy Promise: All the recordings and visit notes stay on your phone.</p>
            <p class="hero-note"><strong>Try Nubo for free.</strong> No credit card required.</p>
          </div>
        </div>
      </div>
    </section>

    <nav class="benefit-strip" aria-label="Explore the Nubo Care story">
      <div class="container benefit-links">
        <a href="#nubo-care">Listen without taking notes</a>
        <a href="#care-loop">Your appointment</a>
        <a href="#original-words">Hear it again</a>
        <a href="#caregivers">Shared next steps</a>
        <a href="#everyday-care">Everyday care</a>
      </div>
    </nav>

    <section class="feature-section care-section" id="nubo-care" aria-labelledby="care-title">
      <div class="container feature-grid">
        <div class="feature-copy">
          <p class="overline">In the room, your hands are full</p>
          <h2 id="care-title">You shouldn't have to choose between listening and taking notes.</h2>
          <p>Your baby is fussing. The pediatrician is answering your questions. You're trying to listen, settle your child, and remember what to do next. By the time you're home, you wish you'd written it down.</p>
          <p>Nubo Care keeps what your pediatrician said: a recap, answers to the questions you brought, and next steps to share. Stay in the conversation. The details are there when you need them.</p>
          <p class="permission-note">Ask your care team before recording.</p>
          <a href="/care/" class="text-link">Explore Nubo Care <span aria-hidden="true">→</span></a>
          <p class="feature-note">Included in Nubo Plus. Available worldwide, in English.</p>
        </div>
        <CareRecapPreview id="homepage-care-recap" />
      </div>
    </section>

    <section class="loop-section" id="care-loop" aria-labelledby="loop-title">
      <div class="container">
        <div class="section-intro"><p class="overline">Before, during, and after the appointment</p><h2 id="loop-title">Go in with questions.<br />Come home with a recap.</h2><p class="section-sub">A place for what you want to ask. A way to listen. A recap when you need it.</p></div>
        <ol class="loop-grid">
          <li><span class="step-number">01</span><p class="step-context">Before the appointment</p><h3>Things I want to ask.</h3><p>Save questions as they come to you. Bring them to the visit, along with any daily observations you choose.</p><div class="step-example"><span>Your question list</span><strong>What should we keep track of before the follow-up?</strong></div></li>
          <li><span class="step-number">02</span><p class="step-context">During the appointment</p><h3>Tap record.</h3><p>Ask your pediatrician's permission, then tap record. Listen, ask your questions, and be there for your child.</p><div class="step-example"><span>In the room</span><strong>Less note-taking. More listening.</strong></div></li>
          <li><span class="step-number">03</span><p class="step-context">After the appointment</p><h3>Here's what your pediatrician said.</h3><p>Return to a clear recap, answers to your questions, and next steps. Hear the original words again and share the recap with caregivers.</p><div class="step-example"><span>Your visit recap</span><strong>Answers, original audio, and shared next steps.</strong></div></li>
        </ol>
        <p class="loop-caption">From the first hospital conversation to childhood checkups, bring Nubo along.</p>
      </div>
    </section>

    <section class="feature-section source-section" id="original-words" aria-labelledby="source-title">
      <div class="container feature-grid">
        <div class="feature-copy">
          <p class="overline">The original words, close by</p>
          <h2 id="source-title">Hear the answer in your doctor's own words.</h2>
          <p>A recap helps you find the important parts. Each answer drawn from the recording points to the moment it came from, so you can hear it again with the surrounding conversation.</p>
          <p>Review the recap before acting on it. A question without a supported answer stays a question to clarify.</p>
          <p class="feature-note">Audio replay is available on the phone that recorded the conversation.</p>
          <a href="/care/#care-journey" class="text-link">See how Nubo Care works <span aria-hidden="true">→</span></a>
        </div>
        <figure class="source-preview" aria-labelledby="source-preview-caption">
          <p class="sample-label">Sample visit · Recorder's phone</p>
          <span class="small-label">Your question</span><h3>What should we keep track of before the follow-up?</h3>
          <div class="answer-excerpt"><span class="small-label">What your pediatrician said</span><p>Keep a note of the feeding changes you notice and bring those observations to the next visit.</p></div>
          <div class="audio-moment"><span class="audio-mark" aria-hidden="true">▶</span><div><strong>04:32</strong><span>Source in the original recording</span></div><div class="waveform" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></div>
          <p class="source-boundary">The recording stays on this phone.</p>
          <figcaption id="source-preview-caption">Example answer and timestamp from a visit recap.</figcaption>
        </figure>
      </div>
    </section>

    <section class="feature-section caregiver-section" id="caregivers" aria-labelledby="caregiver-title">
      <div class="container feature-grid">
        <div class="feature-copy">
          <p class="overline">Everyone caring for your baby</p>
          <h2 id="caregiver-title">When your partner asks,<br />"What did the doctor say?"</h2>
          <p>Your partner, grandparents, and other invited caregivers see the visit summary, answers, and to-dos alongside the care you already track together.</p>
          <p>The recording stays on the recording phone. The useful visit records stay in sync.</p>
          <a href="/caregivers/" class="text-link">Explore caregiver sharing <span aria-hidden="true">→</span></a>
          <p class="feature-note">Everyday tracking already includes unlimited caregivers on iPhone and Android.</p>
        </div>
        <figure class="handoff-preview" aria-labelledby="handoff-caption">
          <p class="sample-label">Sample visit · Shared visit records</p>
          <div class="shared-visit-heading"><span class="baby-initial" aria-hidden="true">E</span><div><h3>Ella's pediatrician visit</h3><p>Answers and next steps</p></div></div>
          <div class="shared-task"><span aria-hidden="true">✓</span><div><p class="small-label">Reviewed next step</p><strong>Save feeding observations for the follow-up.</strong></div></div>
          <div class="caregiver-views"><div><span>Parent's phone</span><strong>Recap + original audio</strong></div><div><span>Caregiver's phone</span><strong>Recap + shared to-dos</strong></div></div>
          <p class="sync-note">Summary, answers, and to-dos sync to invited caregivers. Audio does not.</p>
          <figcaption id="handoff-caption">Example visit records shared with caregivers.</figcaption>
        </figure>
      </div>
    </section>

    <section class="tracking-section" id="everyday-care" aria-labelledby="tracking-title">
      <div class="container">
        <div class="section-intro"><p class="overline">Everyday baby tracking · Free</p><h2 id="tracking-title">The care at home becomes<br />context for the next visit.</h2><p class="section-sub">Capture what fits the moment. Choose the observations you want to bring back.</p></div>
        <div class="tracking-grid">
          <article id="one-tap-logging"><div class="tracking-copy"><h3>Tap as it happens.</h3><p>Quick Log keeps feeds, sleep, and diaper changes close. Each entry joins your baby's shared timeline.</p></div><VisualPlaceholder number="01" title="Everyday care, with quick taps" description="Capture a diaper log, a bottle entry, and a sleep timer joining the timeline." kind="sequence" media="video" labels={['Diaper', 'Bottle', 'Sleep']} /></article>
          <article id="voice-logging"><div class="tracking-copy"><h3>Talk to catch up.</h3><p>Baby finally settled? Say the feeds, naps, and changes you remember. Review each result as you go.</p></div><VisualPlaceholder number="02" title="Remembered events, in the right place" description="Capture a spoken feed, its result at the original event time, and the next spoken event." kind="sequence" media="video" labels={['Say it', 'Review it', 'Keep going']} /></article>
        </div>
        <div class="tracking-followup"><p>In-app voice logging runs on your phone. Nubo Care connects the records you select to your next visit.</p><a href="/app/" class="text-link">Explore the full baby tracker <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="privacy-section" id="care-privacy" aria-labelledby="privacy-title">
      <div class="container feature-grid">
        <div><p class="overline">Private by design</p><h2 id="privacy-title">Private records.<br />A clear processing promise.</h2><p class="privacy-copy">Nubo Care processes selected visit content on the server with zero data retention after processing. Your records live on your phones and in your private backups.</p><a href="/privacy/" class="text-link">How Nubo handles your data <span aria-hidden="true">→</span></a></div>
        <div class="privacy-facts"><article><span>01</span><div><h3>You choose to record.</h3><p>Ask your care team, then deliberately start the conversation recording.</p></div></article><article><span>02</span><div><h3>Processed, then cleared.</h3><p>Server processing and its providers retain no visit data after processing.</p></div></article><article><span>03</span><div><h3>Audio stays on the recording phone.</h3><p>Summaries, answers, and to-dos sync to caregivers. The audio recording does not.</p></div></article></div>
      </div>
    </section>

    <section class="plus-section" id="device" aria-labelledby="plus-title">
      <div class="container plus-grid">
        <div class="feature-copy"><p class="overline">Nubo Plus</p><h2 id="plus-title">Care is part of Plus.<br />The device is optional.</h2><p>Your 14-day Plus preview starts when you confirm your child is here, not when you download or create a profile. Nubo Care is included in Plus.</p><p>Every device owner gets Plus, too. Each phone sync refreshes a 30-day access window.</p><a href="/pricing/" class="text-link">See what's included in Plus <span aria-hidden="true">→</span></a><p class="feature-note">Everyday tracking, in-app voice logging, and caregiver sharing stay free.</p></div>
        <div class="device-card"><img src="/images/hero-device.webp" alt="Nubo device with dedicated baby tracking buttons" width="520" height="1077" loading="lazy" decoding="async" /><div><h3>A tap for care at home.</h3><p>A feed in the dark. A change with both hands busy. Dedicated buttons help you log without reaching for the phone.</p><a href={amazonURL} class="btn-primary" target="_blank" rel="noopener noreferrer">Buy on Amazon</a><a href="/device/" class="text-link">See the device <span aria-hidden="true">→</span></a></div></div>
      </div>
    </section>

    <section class="faq-section" id="questions" aria-labelledby="questions-title"><div class="container faq-inner"><div class="faq-intro"><p class="overline">A few practical answers</p><h2 id="questions-title">Before your<br />next appointment.</h2><p>How visit recaps, shared care, and Plus access work.</p><a href="/faq/" class="text-link">Read all Nubo FAQs <span aria-hidden="true">→</span></a></div><div class="faq-list">{questions.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></div></section>
    <section class="final-cta" id="app-downloads" aria-labelledby="download-title"><div class="container"><p class="overline">Nubo Care · Included in Nubo Plus</p><h2 id="download-title">Take your pediatrician's<br />advice home with you.</h2><p>Download Nubo, save the things you want to ask, and bring your phone to the visit.</p><div class="store-links" aria-label="Choose where to download Nubo">{stores.map((store) => <a href={store.href} target="_blank" rel="noopener noreferrer" aria-label={store.label}><img src={store.image} alt={store.label} width="160" height="56" loading="lazy" /></a>)}</div><p class="final-note">Everyday tracking is free on iPhone and Android.<br />Your 14-day Plus preview starts when you confirm your child is here.</p></div></section>
  </main>
  <Footer />
</BaseLayout>

<style>
  main section[id], .tracking-grid article[id] { scroll-margin-top: 92px; }
  .hero { position: relative; overflow: hidden; background: #243f3b; }
  .hero-scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgba(17,40,37,.94) 0%, rgba(17,40,37,.87) 31%, rgba(17,40,37,.60) 49%, rgba(17,40,37,.04) 77%); }
  .hero-inner { position: relative; z-index: 2; pointer-events: none; padding-top: 100px; padding-bottom: 90px; min-height: 720px; display: flex; align-items: center; }
  .hero-content { pointer-events: auto; }
  .hero-content { width: 52%; max-width: 565px; color: #fff; }
  .hero-eyebrow { text-transform: uppercase; font-size: .75rem; letter-spacing: .12em; font-weight: 700; color: #d4e9dc; }
  h1 { font-size: clamp(2.6rem, 3.8vw, 3.5rem); line-height: 1.09; margin-top: 1.2rem; letter-spacing: -.02em; color: #fff; }
  .hero-sub { margin-top: 1.4rem; font-size: 1rem; line-height: 1.75; max-width: 490px; color: #f0f4f0; }
  .hero-download { margin-top: 1.6rem; border-top: 1px solid rgba(255,255,255,.25); padding-top: 1.2rem; }
  .hero-download > p:first-child { font-size: .875rem; font-weight: 700; }
  .store-links { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .store-links a { display: inline-flex; border-radius: 9px; }
  .store-links img { width: 160px; height: 56px; object-fit: contain; }
  .hero-actions { margin-top: .8rem; }
  .hero-note { font-size: .75rem; line-height: 1.6; color: #e1e9e1; margin-top: .7rem; max-width: 400px; }
  .benefit-strip { border-bottom: 1px solid #dce5e2; background: #fff; }
  .benefit-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 1.8rem; padding-block: 1.25rem; }
  .benefit-links a { color: var(--color-brand-dark); font-size: .8125rem; font-weight: 700; }
  .feature-section, .tracking-section, .loop-section, .faq-section, .plus-section { padding: 5rem 0; }
  .feature-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 4rem; align-items: center; }
  .feature-grid > *, .plus-grid > * { min-width: 0; }
  h2 { font-size: clamp(1.9rem,3.3vw,2.8rem); line-height: 1.18; letter-spacing: -.015em; }
  .feature-copy > p:not(.overline) { color: var(--color-text-secondary); margin-top: 1.1rem; }
  .feature-copy .text-link { display: inline-block; margin-top: 1.3rem; }
  .feature-note, .final-note { font-size: .8125rem; line-height: 1.6; color: var(--color-text-secondary); }
  .feature-copy .permission-note { font-size: .8125rem; font-weight: 700; color: var(--color-brand-dark); }
  .care-section { background: #fafbf7; }
  .section-intro { margin-bottom: 2.5rem; }
  .section-intro .section-sub { font-size: 1rem; max-width: 570px; margin-inline: auto; }
  .loop-section { background: #fff; }
  .loop-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.5rem; list-style: none; padding: 0; }
  .loop-grid li { border-top: 2px solid #c4d7cd; padding: 1.3rem 1rem 0 0; display: flex; flex-direction: column; min-width: 0; }
  .step-number { font-size: 1.55rem; color: var(--color-brand-dark); font-weight: 700; }
  .step-context { text-transform: uppercase; letter-spacing: .055em; font-size: .625rem; font-weight: 700; margin-top: 1.2rem; color: #50675d; }
  .loop-grid h3 { font-size: 1.15rem; margin-top: .45rem; line-height: 1.35; }
  .loop-grid li > p:not(.step-context) { font-size: .875rem; color: var(--color-text-secondary); margin-top: .8rem; margin-bottom: 1.25rem; }
  .step-example { margin-top: auto; background: #f1f6f2; padding: 1rem; border-radius: 12px; min-height: 105px; }
  .step-example span, .small-label { display: block; text-transform: uppercase; letter-spacing: .035em; font-size: .625rem; color: #50675d; font-weight: 700; }
  .step-example strong { display: block; font-size: .8125rem; line-height: 1.5; margin-top: .5rem; }
  .loop-caption { text-align: center; margin-top: 1.8rem; font-size: .75rem; color: var(--color-text-secondary); }
  .source-section { background: #edf4ef; }
  .source-preview, .handoff-preview { margin: 0; border: 1px solid #cbdcd2; border-radius: 24px; padding: 2rem; background: #fff; box-shadow: 0 14px 40px rgba(25,61,47,.04); }
  .sample-label { color: #50675d; font-size: .625rem; text-transform: uppercase; letter-spacing: .055em; font-weight: 700; margin-bottom: 1.8rem; }
  .source-preview h3 { font-size: 1.25rem; line-height: 1.4; margin-top: .6rem; }
  .answer-excerpt { margin-top: 1.5rem; border-top: 1px solid #e0e7e2; padding-top: 1.2rem; }
  .answer-excerpt p { margin-top: .6rem; font-size: .9375rem; color: var(--color-text-secondary); }
  .audio-moment { display: flex; align-items: center; gap: .9rem; margin-top: 1.5rem; padding: 1rem; background: #eaf5ef; border-radius: 14px; }
  .audio-mark { background: #fff; color: var(--color-brand-dark); border-radius: 50%; width: 38px; height: 38px; display: grid; place-items: center; flex-shrink: 0; }
  .audio-moment strong { color: var(--color-brand-dark); font-size: 1rem; }
  .audio-moment div > span { display: block; font-size: .625rem; line-height: 1.5; color: #50675d; }
  .waveform { margin-left: auto; display: flex; gap: 4px; align-items: center; height: 36px; }
  .waveform i { display: block; width: 3px; height: 12px; background: #3d7962; border-radius: 4px; }
  .waveform i:nth-child(3n) { height: 30px; } .waveform i:nth-child(2n) { height: 20px; }
  .source-boundary, .sync-note { font-size: .75rem; color: #50675d; margin-top: 1rem; }
  figcaption { font-size: .6875rem; color: var(--color-text-secondary); border-top: 1px solid #e0e7e2; padding-top: .8rem; margin-top: 1.3rem; }
  .caregiver-section { background: #fff; }
  .shared-visit-heading { display: flex; align-items: center; gap: .8rem; }
  .baby-initial { display: grid; place-items: center; background: #eaf5ef; color: var(--color-brand-dark); width: 44px; height: 44px; border-radius: 14px; font-weight: 700; flex-shrink: 0; }
  .shared-visit-heading h3 { font-size: 1rem; line-height: 1.4; }
  .shared-visit-heading p { font-size: .75rem; color: var(--color-text-secondary); margin-top: .25rem; }
  .shared-task { display: flex; align-items: center; gap: .8rem; padding: 1.1rem; background: #f1f6f2; margin-top: 1.5rem; border-radius: 12px; }
  .shared-task > span { color: var(--color-brand-dark); font-size: 1.2rem; }
  .shared-task strong { display: block; font-size: .875rem; margin-top: .4rem; line-height: 1.5; }
  .caregiver-views { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; margin-top: 1.5rem; }
  .caregiver-views > div { padding: 1rem; border: 1px solid #dce5e2; border-radius: 12px; }
  .caregiver-views span { display: block; font-size: .6875rem; color: #50675d; }
  .caregiver-views strong { display: block; font-size: .75rem; line-height: 1.5; margin-top: .45rem; }
  .tracking-section { background: var(--color-bg-ivory); }
