---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';
import { nuboStory, nuboSharing, nuboProcessing } from '../data/nuboMessaging';


const title = 'FAQ | Nubo Care, Nubo Intelligence, App, and Device';
const description = 'Answers about Nubo Intelligence, Nubo Scribe doctor recordings, Nubo Coordinator follow-up, everyday logging, privacy, Free and Plus, and the device.';

const careFaqs = [
  {
    "q": "What is Nubo Care?",
    "a": `${nuboStory.care} See the <a href="/care/">Nubo Care overview</a>.`
  },
  {
    "q": "Should I download before my baby arrives?",
    "a": "Yes. Get familiar with Nubo before the first busy days. Downloading and creating a profile do not start your Plus preview. The 14-day preview starts when you confirm your child is here."
  },
  {
    "q": "Can I use Nubo Care at the first hospital conversation?",
    "a": "Yes. Start with your questions and record with your care team’s permission. You do not need a tracking history. Nubo Care is included in Plus, including your 14-day preview, and is available worldwide with recording and recaps in English."
  },
  {
    "q": "Is Nubo Care included in the Plus preview and with the device?",
    "a": "Yes. Nubo Care is part of Nubo Plus, including everyone’s 14-day Plus preview and the Plus access included with every Nubo Remote. Your preview starts when you confirm your child is here."
  },
  {
    "q": "Where is Nubo Care available?",
    "a": "Nubo Care is available worldwide. Visit recording and recaps support English."
  },
  {
    "q": "Do I have to record the appointment?",
    "a": "No. Prepare your questions and selected observations, then take notes if you prefer. If you record, get permission from everyone taking part and follow the clinic’s policy."
  },
  {
    "q": "How can I check an answer against the conversation?",
    "a": "Every answer extracted from a recording refers to its actual audio timestamps. On the phone that recorded the visit, you can replay the relevant passage and recollect what was said. Manually entered notes do not have an audio reference."
  },
  {
    "q": "What do caregivers see?",
    "a": nuboProcessing.careRecords
  },
  {
    "q": "Where does processing happen, and what is retained?",
    "a": "Care processing happens on the server with zero data retention after processing. Summaries, answers, to-dos, and other visit records are stored on phones and backed up to users’ private backups. Audio remains available on the recording phone."
  },
  {
    "q": "Can I prepare without a tracking history?",
    "a": "Yes. Start with your own questions and observations. Select relevant logs when you have them; a long logging history is not required."
  },
  {
    "q": "Do I need the Nubo Remote for doctor visits?",
    "a": "No. Nubo Care works in the app on its own. The optional Nubo Remote adds dedicated buttons for everyday feeds, sleep, and diapers. Each phone that syncs with the device receives Plus access, refreshed for 30 days with each sync."
  }
];

const intelligenceFaqs = [
  {
    q: "What is Nubo Intelligence?",
    a: `${nuboStory.intelligence} Explore <a href="/app/#intelligence">Nubo Intelligence in the app</a>.`
  },
  {
    q: "How do Nubo Intelligence, Nubo Care, and Nubo Plus fit together?",
    a: `Intelligence is the built-in AI across everyday logging, observations, recorded patterns, visit preparation, Nubo Scribe doctor recordings, and Nubo Coordinator follow-up. Care brings this AI to doctor visits and shared next steps. All are part of one Nubo app. ${nuboStory.plus} Voice logging and observations stay free. See <a href="/pricing/">Free and Plus access details</a>.`
  },
  {
    q: "Is Nubo Scribe part of Nubo Intelligence?",
    a: `${nuboStory.scribe} Scribe is part of Nubo Intelligence within Nubo Care, included in Plus. <a href="/care/#nubo-scribe">Explore Nubo Scribe</a>.`
  },
  {
    q: "How does Nubo Coordinator help after a visit?",
    a: `${nuboStory.coordinator} It is part of Nubo Intelligence within Nubo Care, included in Plus. ${nuboProcessing.careRecords} <a href="/care/#caregivers">Explore Nubo Coordinator</a>.`
  },
  {
    q: "How does Nubo Intelligence work?",
    a: "Nubo Intelligence uses AI built into the app. In-app voice logging runs on your phone, including offline. Supported Notetaker AI titles and tags also run on the device. Nubo Care uses server processing for selected visit content, with no visit data retained afterward. See <a href=\"/app/#how-intelligence-works\">how Nubo Intelligence works</a> or the <a href=\"/privacy/#processing\">feature-by-feature privacy explanation</a>."
  },
  {
    q: "Can I log by voice in the app?",
    a: "Yes. Say what happened in everyday language, such as 'She had 90 mL of formula 20 minutes ago.' Nubo Intelligence identifies supported events and extracts amounts, units, times, and durations, including several events from one spoken update. Review and edit the events before saving. In-app voice logging is free and unlimited, with no usage caps. <a href=\"/app/#voice-logging\">Try the voice logging examples</a>."
  },
  {
    q: "How does Nubo Notetaker help between doctor visits?",
    a: "When the days blur together, it can be hard to recall when something changed. Speak or type what you notice: a different feeding routine, earlier waking, or a question for the next checkup. Nubo Notetaker keeps those observations in your own words, so you can review them and choose the details to discuss with your pediatrician. Observations stay free. <a href=\"/app/#notetaker\">See how Nubo Notetaker keeps the context</a>."
  },
  {
    q: "Which phones support Nubo Notetaker's AI titles and tags?",
    a: "On iOS 26 or later with Apple Intelligence available, on-device AI can add a short title and relevant tags to spoken or typed observations while preserving your words. Otherwise, your note keeps its text and receives a simpler title without AI tags. You can keep observations without AI enrichment."
  },
  {
    q: "What does Nubo Noticed show, and is it free?",
    a: "Nubo Noticed highlights supported changes in recorded sleep, bottle intake, nursing, and wet and dirty diaper patterns. It compares recent and earlier completed days and appears when the records support a finding. Missing logs are not treated as proof that no care happened. Nubo Noticed is included with Nubo Plus and is free for everyone on Mondays. <a href=\"/app/#insights\">See a Nubo Noticed example</a>."
  },
  {
    q: "How do suggestions while logging work?",
    a: "Nubo can suggest a feed amount from recent entries of the same type, prioritizing similar times of day when enough history exists. Growth entry controls can start from an estimate based on a previous measurement and its growth-chart position at your baby's current age. Suggestions are editable starting points, and growth estimates are not measured results. You choose the values to save."
  },
  {
    q: "Where does voice processing happen?",
    a: "In-app speech recognition and voice event interpretation run on your phone, including offline. Nubo Notetaker AI titles and tags also run on the device when supported. Optional caregiver sharing and private backup are separate from local processing. Alexa logging uses Amazon's systems. Nubo Care uses separate server processing for selected visit content, with no visit data retained after processing; original visit audio stays on the recording phone. Read <a href=\"/privacy/\">how Nubo handles privacy</a>."
  },
  {
    q: "Does Nubo have an AI medical advisor or health chatbot?",
    a: "No. Nubo Intelligence helps you record care, organize observations, and review patterns in your logs. It does not diagnose conditions or establish causes or relationships between symptoms and care patterns. Nubo Care helps you return to your pediatrician's own guidance. Bring medical questions to your care team."
  }
];

const trackerFaqs = [
  {
    q: "Does unlimited caregiver sharing mean everyone sees everything?",
    a: `${nuboSharing.overview} ${nuboSharing.pumping} See <a href="/caregivers/#sharing-controls">sharing choices for each caregiver</a>.`
  },
  { q: "Can nursing side and time per side stay private?", a: nuboSharing.nursing },
  { q: "Who can see Care Vault information?", a: nuboSharing.vault },
  { q: "Who can see doctor visit data?", a: nuboProcessing.careRecords },
  {
    q: "Who is Nubo best for?",
    a: "Nubo is best for families who want baby tracking to be fast, shared, and forgiving. It works well for newborn parents managing night feeds, forgotten logs, hands-full moments, and multiple caregivers. You can use the free app on its own, add Nubo Plus for advanced tools, or add the quick-log device when opening your phone is inconvenient."
  },
  {
    q: "How is Nubo different from other baby tracker apps?",
    a: "Nubo brings doctor visits and everyday care together. Nubo Care helps you prepare questions and return to your pediatrician's words. Nubo Intelligence helps with natural logging, observations, and useful context between visits. Start with the free app, share care across iPhone and Android, and add the optional Nubo Remote when dedicated event buttons fit your routine."
  },
  {
    q: "Does using Nubo mean more screen time?",
    a: "No. Nubo is built to support caregiving, not compete with it. The optional Nubo Remote logs feeds, sleep, and diapers with dedicated event buttons, so you can mark the moment without unlocking, scrolling, or pulling your attention off the baby. When you do use the app, voice catch-up and Quick Log keep entries short. The goal is not more screen time, it is better caregiving coordination. The <a href=\"/device/\">Nubo Remote page</a> explains the screen-free approach."
  },
  {
    q: "What does Nubo track?",
    a: "The Nubo Remote has dedicated one-tap buttons for core newborn logs like feeds, sleep, and diapers. The free Nubo app supports a fuller baby timeline, including feeds, sleep, diapers, medicine, growth, notes, voice catch-up, and caregiver sharing. See the <a href=\"/device/\">Nubo Remote page</a> for what the device buttons cover, or the <a href=\"/app/\">app page</a> for the full timeline and advanced logs."
  },
  {
    q: "Do I need the app to use the Nubo Remote?",
    a: "You can tap the Nubo Remote buttons right away to save logs, even before connecting the app. To view your timeline, sync history, invite caregivers, edit logs, or use trends and insights, you'll use the free Nubo app. The <a href=\"/device/\">Nubo Remote page</a> covers physical logging, and the <a href=\"/app/\">app page</a> covers the shared timeline."
  },
  {
    q: "Can I use Nubo without buying Nubo Remote?",
    a: `Yes. The Nubo app is free on iPhone and Android and works on its own. ${nuboStory.device} Start from the <a href="/app/">free app page</a> to download.`
  },
  {
    q: "Does the Nubo Remote need Wi-Fi or internet?",
    a: "No. The Nubo Remote does not use Wi-Fi and does not need an internet connection to save logs. It syncs to the app over Bluetooth when your phone is nearby."
  },
  {
    q: "How does Nubo Remote sync with the app?",
    a: "Nubo Remote syncs via Bluetooth Low Energy. When your phone is nearby, the app automatically pulls new activity data from the device. No Wi-Fi or internet connection is needed for syncing. For the full flow, read <a href=\"/blog/product/nubo-bluetooth-sync/\">how Nubo Bluetooth sync works</a>."
  },
  {
    q: "What phones are compatible?",
    a: "The Nubo app is available for iOS (iPhone) and Android. It requires Bluetooth Low Energy support, which is standard on any phone released in the last several years. Start from the <a href=\"/app/\">free app page</a> to choose App Store or Google Play."
  },
  {
    q: "How long does the Nubo Remote battery last?",
    a: "Nubo Remote uses a standard coin cell battery (CR2032) that lasts several months with typical use. An extra battery is included in the box. No charging cables needed. The <a href=\"/device/\">Nubo Remote page</a> has the box contents and setup overview."
  },
  {
    q: "Is Nubo Remote waterproof?",
    a: "Nubo Remote can handle light splashes and everyday surface messes. Wipe it clean with a dry or slightly damp cloth. Do not rinse it under water, put it in the dishwasher, or submerge it."
  },
  {
    q: "Can multiple caregivers use Nubo?",
    a: "Yes. Anyone can tap Nubo Remote buttons to log activities. In the app, you can invite caregivers like a partner, grandparents, or nanny so everyone sees the same activity log. Learn more on the <a href=\"/caregivers/\">caregiver page</a>."
  },
  {
    q: "How much does Nubo Plus cost, and how is it billed?",
    a: "Nubo Plus is $4.99/month (billed annually). Subscriptions are billed through the App Store on iPhone or Google Play billing on Android. Prices may vary by region; check your local price in the app before subscribing. The free app remains available without a subscription."
  },
  {
    q: "How does Nubo Plus work with the Nubo Remote?",
    a: "The Nubo Remote works with the free app. Any phone that pairs with or syncs from the device gets a 30-day Nubo Plus access window, and each later sync refreshes that window. This is separate from App Store or Google Play Nubo Plus subscriptions. See the <a href=\"/pricing/\">pricing page</a> for the household math."
  },
  {
    q: "How does Nubo Remote give caregivers Nubo Plus access?",
    a: "When a caregiver phone pairs with or syncs from the device, that phone gets a 30-day Nubo Plus access window. Each later sync refreshes the 30-day window. This is why the device can be a strong value for households with nannies, grandparents, doulas, or daycare staff. See the <a href=\"/pricing/\">pricing page</a> for the household math."
  },
  {
    q: "What happens if a caregiver only visits occasionally?",
    a: "Nubo Plus access lasts 30 days after that caregiver's most recent sync. If it lapses, it reactivates the next time that caregiver syncs with your device. The <a href=\"/caregivers/\">caregiver page</a> explains how occasional helpers fit into the shared timeline."
  },
  {
    q: "Does Nubo Plus work for me if my partner buys Nubo Remote?",
    a: "Yes. Nubo Plus access follows device use. It does not depend on which caregiver bought the device or which Apple or Google account made the purchase."
  },
  {
    q: "Can my partner use Nubo too?",
    a: "Yes. The free app supports unlimited caregivers. Nubo Plus tools belong to the App Store or Google Play account that buys Nubo Plus. Caregivers on separate store accounts usually need their own Nubo Plus subscription, or the device can grant Nubo Plus access when they use it. The <a href=\"/pricing/\">pricing page</a> compares those setups."
  },
  {
    q: "Is my baby's data private?",
    a: "Your baby activity data is stored locally on your phone, backups use your own iCloud or Google Drive, and caregiver sharing is end-to-end encrypted. We do not sell baby activity data. We only share information as needed to provide the service, support the app, or process purchases through third-party platforms, as described in our <a href=\"/privacy-policy/\">privacy policy</a>. Read the plain-English <a href=\"/privacy/\">privacy overview</a> for more."
  },
  {
    q: "What happens to my data if my Nubo Plus access ends?",
    a: "Your baby history remains available in the free app. Nubo Plus adds advanced tools, but ending Nubo Plus access does not erase your logs. The <a href=\"/app/\">free app page</a> shows what remains useful without upgrading."
  },
  {
    q: "Is the free tier actually useful?",
    a: "Yes. The <a href=\"/app/\">free Nubo app</a> includes routine tracking, unlimited caregivers, child profiles, private backup, offline mode, voice logging, quick logs, and observations with Nubo Notetaker. Nubo Noticed is free for everyone on Mondays. Nubo Plus adds further tools, including Nubo Care and Nubo Noticed throughout the week. The device is optional."
  },
  {
    q: "Do I need to create an account?",
    a: "No account is required to use the device or app. If you want to share data with other caregivers, you can create an optional account with just an email address."
  },
  {
    q: "Where can I buy Nubo Remote?",
    a: "Nubo Remote is available on <a href=\"https://www.amazon.com/nubo-Newborn-Activity-Tracker-Color/dp/B0CJLNBG4P?maas=maas_adg_465D5CB69C73F660B7AD38831E2D680B_afap_abs&ref_=aa_maas&tag=maas\" target=\"_blank\" rel=\"noopener noreferrer\">Amazon</a>. Free shipping with Prime. The companion app is free on the App Store and Google Play. You can compare options on the <a href=\"/pricing/\">pricing page</a>."
  },
  {
    q: "What if I have a second baby?",
    a: "The app supports multiple child profiles, and the device can keep working for a future baby. A one-time device purchase can be especially useful for families planning beyond one newborn stage. Compare app, Nubo Plus, and device paths on the <a href=\"/pricing/\">pricing page</a>."
  },
  {
    q: "Can I return Nubo Remote?",
    a: "Nubo Remote is sold through Amazon, so returns follow Amazon's standard return policy. You can review device pricing and purchase reassurance on the <a href=\"/pricing/\">pricing page</a>."
  },
  {
    q: "What comes in the box?",
    a: "The Nubo Remote (with battery installed), a milk volume sticker, a magnetic mount sticker, an extra CR2032 battery, a lanyard, and setup and user guides. See the <a href=\"/device/\">Nubo Remote page</a> for the setup and box overview."
  },
  {
    q: "How do I mount or carry Nubo Remote?",
    a: "Nubo Remote has a built-in magnet. Use the included magnetic sticker to mount it on your fridge, crib, or anywhere convenient. You can also clip it to a bag or wear it with the included lanyard."
  },
  {
    q: "Can I export my data?",
    a: "Yes. Nubo Plus includes PDF and CSV export for your baby's activity data. This is helpful for pediatrician visits or keeping personal records. Your timeline stays available in the free app even if you do not use Nubo Plus. The <a href=\"/app/\">app page</a> covers the app-first tools in more detail."
  },
  {
    q: "Is Nubo good for exclusive pumping?",
    a: "Yes. Nubo separates the two records exclusive pumping families usually need: pumped milk bottles are baby feeds in the shared timeline, while Nubo Plus private pumping tracks milk output for the person who pumped. Caregivers can help log baby intake without seeing private pumping sessions. The <a href=\"/exclusive-pumping/\">exclusive pumping page</a> explains the setup."
  },
  {
    q: "Can caregivers see my pumping data?",
    a: "No. Pumping records are always private and are never shared with other caregivers. Nubo Plus includes the pumping tracker for milk output, kept separate from the shared baby log. Read the <a href=\"/blog/privacy/pumping-tracker-private-data/\">exclusive pumping privacy guide</a> for the full design."
  },
  {
    q: "How can Nubo help me see my baby's routine?",
    a: "Quick Action cards show the latest event and today's totals. Nubo Noticed highlights supported changes across recent and earlier completed days, and Plus Rhythm charts put care events on a shared timeline. These are parts of Nubo Intelligence that help you review recorded care. See <a href=\"/app/#insights\">Nubo Noticed and its access details</a>."
  },
  {
    q: "Is Nubo a medical device?",
    a: "No. Nubo is a consumer wellness product designed to help parents track daily baby activities. It is not intended to diagnose, treat, cure, or prevent any medical condition. Always consult your pediatrician for medical advice."
  },
  {
    q: "How do I get help or report an issue?",
    a: "Email us at <a href=\"mailto:support@clicksie.io\">support@clicksie.io</a>. We typically respond within one business day. You can also visit our <a href=\"/contact/\">contact page</a>."
  },
  {
    q: "How do I pair Nubo Remote with my phone?",
    a: "Open the Nubo app, tap Add Device, and hold Nubo Remote close to your phone. The app will find it automatically via Bluetooth. The whole process takes about 30 seconds. No Wi-Fi or passwords needed. The <a href=\"/device/\">Nubo Remote page</a> has the setup overview."
  },
  {
    q: "How do I reset Nubo Remote?",
    a: "First, remove your Nubo Remote from the app under Settings &gt; Devices. On iPhone, also open Bluetooth settings and choose \"Forget This Device\" for Nubo if it appears there. Then triple-click the + button on the device to reset pairing, or remove and reinsert the battery if needed. After that, open the Nubo app and tap Add Device again."
  },
  {
    q: "Nubo Remote isn't syncing with the app. What should I do?",
    a: "Make sure Bluetooth is enabled on your phone and Nubo Remote is within range (about 10 feet). Try closing and reopening the app. If it still won't sync, reset the device by removing and reinserting the battery, then re-pair. If the issue persists, email <a href=\"mailto:support@clicksie.io\">support@clicksie.io</a>."
  },
  {
    q: "How do I replace the battery?",
    a: "Slide open the battery cover on the back of the device and swap in a standard CR2032 coin cell. An extra battery is included in the box. No tools needed."
  },
  {
    q: "Can I log activities manually in the app?",
    a: "Yes. Open the app and tap the + button to add any activity with a custom time. This is useful if you forgot to tap the device or want to add a past event. See the <a href=\"/app/\">app page</a> for quick logging and catch-up options."
  },
  {
    q: "Do I need the Nubo Remote to use voice logging?",
    a: "No. In-app voice logging works in the free Nubo app on its own. The device adds dedicated physical buttons for moments when your phone isn't within reach. The <a href=\"/compare/\">comparison page</a> shows where voice, Quick Log, and the device each fit."
  }
];

const faqs = [...careFaqs, ...intelligenceFaqs, ...trackerFaqs];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a.replace(/<[^>]*>/g, '')
    }
  }))
};---

<MarketingLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="m-hero m-title"><div class="container"><p class="overline">Nubo FAQ</p><h1>A few answers.<br />A little less to figure out.</h1><p class="m-lead">Keeping track at home, bringing answers back from a visit, or choosing Free and Plus. Start with your question.</p></div></section>
  <nav class="topic-nav" aria-label="FAQ topics"><div class="container m-grid three"><a href="#doctor-visits"><span class="m-icon peach"><SiteIcon name="questions" /></span><div><p class="m-label">Nubo Care</p><strong>Doctor visits</strong></div><span aria-hidden="true">↓</span></a><a href="#nubo-intelligence"><span class="m-icon lilac"><SiteIcon name="sparkles" /></span><div><p class="m-label">Nubo Intelligence</p><strong>Built-in AI</strong></div><span aria-hidden="true">↓</span></a><a href="#app-and-device"><span class="m-icon"><SiteIcon name="phone" /></span><div><p class="m-label">App and Nubo Remote</p><strong>Plans and setup</strong></div><span aria-hidden="true">↓</span></a></div></nav>
  <section class="m-section" id="doctor-visits" aria-labelledby="care-faq-title"><div class="container faq-section"><div class="m-heading"><p class="overline">Nubo Care</p><h2 id="care-faq-title">Doctor visits.</h2><p>Prepare, record with permission, and come back to the answers.</p></div><div class="faq-list">{careFaqs.map((faq) => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><div class="faq-answer"><p set:html={faq.a} /></div></details>)}</div></div></section>
  <section class="m-section m-warm" id="nubo-intelligence" aria-labelledby="intelligence-faq-title"><div class="container faq-section"><div class="m-heading"><p class="overline">Nubo Intelligence</p><h2 id="intelligence-faq-title">Everyday care.<br />Visits. Follow-up.</h2><p>Built-in AI for logs, observations, recorded patterns, visit questions, Nubo Scribe doctor recordings, and Nubo Coordinator follow-up.</p></div><div class="faq-list">{intelligenceFaqs.map((faq) => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><div class="faq-answer"><p set:html={faq.a} /></div></details>)}</div></div></section>
  <section class="m-section" id="app-and-device" aria-labelledby="tracker-faq-title"><div class="container faq-section"><div class="m-heading"><p class="overline">App and Nubo Remote</p><h2 id="tracker-faq-title">Plans and setup.</h2><p>Free and Plus, shared care, and your first tap with Nubo Remote.</p></div><div class="faq-list">{trackerFaqs.map((faq) => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><div class="faq-answer"><p set:html={faq.a} /></div></details>)}</div></div></section>
  <section class="m-cta"><div class="container"><h2>Still have a question?</h2><div class="m-actions"><a href="/contact/" class="btn-primary">Contact us</a></div></div></section>
</MarketingLayout>
<style>
  .topic-nav { padding-block: 1.5rem 0; } .topic-nav a { display: flex; align-items: center; gap: 1rem; padding: 1.25rem; border: 1px solid #e0e8df; border-radius: 22px; background: #f7faf5; } .topic-nav .m-icon { margin: 0; flex-shrink: 0; } .topic-nav a > span:last-child { margin-left: auto; color: var(--color-brand-dark); } .topic-nav strong { font-size: 1rem; } .topic-nav .m-label { font-size: .625rem; }
  .faq-section { display: grid; grid-template-columns: .75fr 1.25fr; gap: 4rem; align-items: start; } .faq-section .m-heading { position: sticky; top: 110px; } .faq-section .m-heading p:last-child { font-size: .875rem; }
  .faq-list details { border-bottom: 1px solid #dce5db; } .faq-list summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.1rem; list-style: none; font-size: .9375rem; font-weight: 700; cursor: pointer; } .faq-list summary::-webkit-details-marker { display: none; } .faq-list summary > span { color: var(--color-brand-dark); flex-shrink: 0; font-size: 1.3rem; } .faq-list details[open] summary > span { transform: rotate(45deg); }
  .faq-answer { padding-bottom: 1.25rem; color: var(--color-text-secondary); font-size: .875rem; line-height: 1.75; } .faq-answer :global(a) { color: var(--color-brand-dark); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 680px) { .faq-section { grid-template-columns: 1fr; gap: 0; } .faq-section .m-heading { position: static; } .faq-list summary { font-size: .875rem; } .topic-nav .m-grid { gap: .75rem; } .topic-nav a { padding: 1rem; } }
</style>
