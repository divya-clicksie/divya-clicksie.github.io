---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NuboProductGuide from '../components/NuboProductGuide.astro';
import AppFeatureComparison from '../components/AppFeatureComparison.astro';
import SiteIcon from '../components/SiteIcon.astro';
import { nuboAccess, nuboStory } from '../data/nuboMessaging';

const title = 'Pricing | Nubo Free App, Plus, and Nubo Remote';
const description = 'Everyday tracking and caregivers stay free. Compare Nubo Plus for pediatrician visits and more app tools, plus the optional Nubo Remote for hands-full days.';

const amazonURL = 'https://www.amazon.com/nubo-Newborn-Activity-Tracker-Color/dp/B0CJLNBG4P?maas=maas_adg_465D5CB69C73F660B7AD38831E2D680B_afap_abs&ref_=aa_maas&tag=maas';
const appStoreURL = 'https://apps.apple.com/us/app/nubo-baby-tracker/id1667461158';
const playStoreURL = 'https://play.google.com/store/apps/details?id=com.clicksie.nuboapp';

const appFeatures = [
  'Everyday tracking and Quick Log',
  'On-device voice logging and observations',
  'Unlimited caregivers with individual sharing choices',
  'Multiple children, offline mode, private backup',
  'Nubo Noticed, free on Mondays',
];
const plusFeatures = [
  'Everything in Free',
  'Nubo Care for doctor visits and next steps',
  'Nubo Noticed throughout the week',
  'Reminders, charts, exports, and Alexa',
  'Private pumping and iPhone Live Activities',
];
const deviceFeatures = [
  'Dedicated buttons for feeds, sleep, and diapers',
  'Bluetooth sync to a nearby paired phone',
  'Plus access for each phone that syncs',
  'Magnetic mount and lanyard',
  'Battery included, designed to last months',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: title,
      description,
      url: 'https://www.nubotracker.com/pricing/',
      about: { '@type': 'Thing', name: 'Nubo Baby Tracker' }
    },
    {
      '@type': 'Product',
      name: 'Nubo Remote',
      alternateName: ['One-tap baby tracker', 'Physical baby tracker device', 'Screen-free baby tracker'],
      description: 'Nubo Remote is a one-tap baby tracker for screen-free logging, caregiver handoffs, and shared baby routines.',
      image: 'https://www.nubotracker.com/images/nubo-instant-tracker.webp',
      sku: 'B0CJLNBG4P',
      brand: { '@type': 'Brand', name: 'Nubo' },
      offers: {
        '@type': 'Offer',
        name: 'Nubo Remote',
        price: '89.00',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        itemCondition: 'https://schema.org/NewCondition',
        url: amazonURL
      }
    },
    {
      '@type': 'MobileApplication',
      name: 'Nubo Baby Tracker App',
      operatingSystem: 'iOS, Android',
      applicationCategory: 'HealthApplication',
      description: `${nuboStory.description} ${nuboStory.plus}`,
      offers: [
        { '@type': 'Offer', name: 'Nubo free app', price: '0', priceCurrency: 'USD', url: appStoreURL },
        { '@type': 'Offer', name: 'Nubo Plus annual subscription', price: '59.99', priceCurrency: 'USD', url: appStoreURL }
      ],
      installUrl: [appStoreURL, playStoreURL],
      downloadUrl: [appStoreURL, playStoreURL]
    },
    {
      '@type': 'OfferCatalog',
      name: 'Nubo pricing options',
      itemListElement: [
        {
          '@type': 'Offer',
          name: 'Free app',
          price: '0',
          priceCurrency: 'USD',
          url: appStoreURL,
          itemOffered: { '@type': 'MobileApplication', name: 'Nubo Baby Tracker App' }
        },
        {
          '@type': 'Offer',
          name: 'Nubo Plus annual subscription',
          price: '59.99',
          priceCurrency: 'USD',
          url: appStoreURL,
          itemOffered: { '@type': 'MobileApplication', name: 'Nubo Baby Tracker App' }
        },
        {
          '@type': 'Offer',
          name: 'Nubo Remote',
          price: '89.00',
          priceCurrency: 'USD',
          url: amazonURL,
          itemOffered: { '@type': 'Product', name: 'Nubo Remote' }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Header />
  <main id="main-content">
    <section class="page-hero pricing-hero" aria-labelledby="pricing-title"><div class="container"><p class="overline">Nubo pricing</p><h1 id="pricing-title">Start free.<br />Add what helps.</h1><p class="page-hero-sub">Quick Log, voice logging, observations, and unlimited caregivers stay free. Add Plus for Nubo Care and more app tools, or the optional Nubo Remote for hands-full moments.</p></div></section>

    <section class="plans-section" id="plans" aria-label="Nubo plans and Nubo Remote"><div class="container">
      <div class="pricing-grid">
        <article class="pricing-card"><span class="plan-mark"><SiteIcon name="leaf" size={30} /></span><p class="plan-label">The everyday app</p><h2>Nubo Free</h2><p class="price">$0</p><p class="price-context">Free on iPhone and Android</p><p class="tagline">Keep the day's care together.</p><ul class="feature-list" aria-label="Free app features">{appFeatures.map((feature) => <li><SiteIcon name="check" size={17} /><span>{feature}</span></li>)}</ul><div class="card-actions"><a href={appStoreURL} target="_blank" rel="noopener noreferrer"><img src="/images/appstore-badge.webp" alt="Download on the App Store" width="160" height="56" /></a><a href={playStoreURL} target="_blank" rel="noopener noreferrer"><img src="/images/playstore-badge.webp" alt="Get it on Google Play" width="160" height="56" /></a></div></article>
        <article class="pricing-card featured-card"><span class="plan-mark"><SiteIcon name="sparkles" size={30} /></span><p class="plan-label">The paid app plan</p><h2>Nubo Plus</h2><p class="price">$4.99<span>/month</span></p><p class="price-context">$59.99 billed annually</p><p class="tagline">Pediatrician visits, recorded patterns, and more.</p><ul class="feature-list" aria-label="Nubo Plus features">{plusFeatures.map((feature) => <li><SiteIcon name="check" size={17} /><span>{feature}</span></li>)}</ul><div class="card-actions"><a href={appStoreURL} class="btn-primary" target="_blank" rel="noopener noreferrer">Upgrade in the iPhone app</a><a href={playStoreURL} class="text-link" target="_blank" rel="noopener noreferrer">Upgrade in the Android app <span aria-hidden="true">↗</span></a></div></article>
        <article class="pricing-card device-card"><span class="device-mark"><img src="/images/hero-device.webp" alt="Nubo Remote with dedicated care buttons" width="520" height="1077" loading="lazy" decoding="async" /></span><p class="plan-label">Optional physical tracker</p><h2>Nubo Remote</h2><p class="price"><del>$109</del> $89</p><p class="price-context">One-time purchase on Amazon</p><p class="tagline">Screen-free logging, close at hand.</p><ul class="feature-list" aria-label="Nubo Remote features">{deviceFeatures.map((feature) => <li><SiteIcon name="check" size={17} /><span>{feature}</span></li>)}</ul><div class="card-actions"><a href={amazonURL} class="btn-primary" target="_blank" rel="noopener noreferrer">Buy on Amazon</a><a href="/device/" class="text-link">Explore Nubo Remote <span aria-hidden="true">→</span></a></div></article>
      </div>
      <p class="billing-note">Plus subscriptions use App Store or Google Play billing. Prices may vary by region. Nubo Remote price, shipping, availability, and returns follow the current Amazon listing.</p>
      <nav class="pricing-links" aria-label="More about Nubo plans"><a href="/care/">Explore Nubo Care <span aria-hidden="true">→</span></a><a href="/privacy/#free-and-paid">Trust &amp; Privacy: why Care is paid <span aria-hidden="true">→</span></a><a href="/compare/">Compare Nubo setups <span aria-hidden="true">→</span></a></nav>
      <details class="comparison-details"><summary>Compare every Free and Plus feature <span aria-hidden="true">+</span></summary><AppFeatureComparison heading="Find the tools that fit your day." intro="Feature access and device requirements, all in one place." /></details>
      <div class="access-grid" aria-label="Other ways to explore Plus"><article><div class="access-number">14<span>days</span></div><div><h3>Explore Plus for 14 days.</h3><p>Starts when you confirm your child is here. Downloading early won't use it up. The preview is separate from a subscription.</p></div></article><article><div class="access-number">30<span>days</span></div><div><h3>Plus follows your Nubo Remote.</h3><p>Each phone that syncs with the Nubo Remote gets a refreshed 30-day Plus window, including Nubo Care.</p></div></article></div>
      <details class="access-details"><summary>Feature availability and access questions <span aria-hidden="true">+</span></summary><div><p>{nuboAccess.noticed}</p><p>{nuboAccess.observations}</p><p>Nubo Care is included in Plus, the preview, and active device access. It supports recording and recaps in English.</p><a href="/faq/#nubo-intelligence" class="text-link">Intelligence and access FAQs <span aria-hidden="true">→</span></a></div></details>
    </div></section>
    <NuboProductGuide />
  </main>
  <Footer />
</BaseLayout>

<style>
  #plans { scroll-margin-top: 96px; }
  .pricing-hero { padding-top: 128px; padding-bottom: 2.5rem; }
  .pricing-hero h1 { font-size: clamp(2.8rem,5vw,4rem); line-height: 1.08; letter-spacing: -.04em; }
  .pricing-hero .page-hero-sub { max-width: 510px; font-size: 1rem; margin-top: 1.25rem; }
  .plans-section { padding-block: 1rem 4rem; background: var(--color-bg-ivory); }
  .pricing-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.1rem; align-items: stretch; }
  .pricing-card { display: flex; flex-direction: column; min-width: 0; position: relative; background: #fff; border: 1px solid #e3e5de; border-radius: 26px; padding: 1.75rem; }
  .featured-card { background: #f0f7f3; border-color: #9bbfae; }
  .device-card { background: #f7f4ed; border-color: #e4dfd3; }
  .plan-mark { color: var(--color-brand-dark); width: 48px; height: 62px; display: flex; align-items: center; margin-bottom: 1rem; }
  .device-mark { height: 62px; display: block; margin-bottom: 1rem; } .device-mark img { height: 62px; width: auto; transform: rotate(12deg); }
  .plan-label { font-size: .625rem; color: var(--color-brand-dark); text-transform: uppercase; font-weight: 700; letter-spacing: .06em; margin-bottom: .4rem; }
  h2 { font-size: 1.5rem; line-height: 1.2; letter-spacing: -.025em; }
  .price { font-size: clamp(2.3rem,3.7vw,3rem); line-height: 1.15; letter-spacing: -.04em; font-weight: 700; margin-top: 1.1rem; }
  .price > span { font-size: .875rem; letter-spacing: 0; font-weight: 500; }
  .price del { font-size: 1.125rem; color: var(--color-text-secondary); font-weight: 500; letter-spacing: 0; }
  .price-context { color: var(--color-text-secondary); font-size: .6875rem; margin-top: .4rem; }
  .tagline { color: var(--color-text-secondary); font-size: .875rem; margin-top: 1.25rem; min-height: 2.8rem; }
  .feature-list { list-style: none; display: grid; align-content: start; gap: .85rem; margin-block: 1.5rem 2rem; flex: 1; }
  .feature-list li { display: flex; align-items: start; gap: .5rem; font-size: .75rem; line-height: 1.65; }
  .feature-list svg { color: var(--color-brand-dark); flex-shrink: 0; margin-top: 2px; }
  .card-actions { display: flex; flex-direction: column; gap: .7rem; align-items: flex-start; }
  .card-actions img { width: 140px; height: 49px; object-fit: contain; }
  .card-actions .btn-primary { padding: .8rem 1rem; font-size: .75rem; width: 100%; text-align: center; justify-content: center; }
  .card-actions .text-link { display: inline-block; font-size: .6875rem; }
  .billing-note { color: var(--color-text-secondary); font-size: .6875rem; line-height: 1.7; margin-block: 1.5rem; text-align: center; }
  .pricing-links { display: flex; flex-wrap: wrap; justify-content: center; gap: .8rem 1.5rem; margin-bottom: 1.75rem; font-size: .8125rem; font-weight: 700; color: var(--color-brand-dark); }
  .comparison-details, .access-details { border-block: 1px solid #e1e5db; }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-block: 1.1rem; font-size: .875rem; color: var(--color-brand-dark); cursor: pointer; list-style: none; font-weight: 700; }
  summary::-webkit-details-marker { display: none; } summary > span { font-size: 1.4rem; } details[open] > summary > span { transform: rotate(45deg); }
  .access-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-block: 2.5rem; }
  .access-grid article { display: flex; gap: 1.25rem; align-items: flex-start; }
  .access-number { font-size: 2.8rem; color: var(--color-brand-dark); font-weight: 700; line-height: 1; letter-spacing: -.04em; }
  .access-number span { display: block; text-transform: uppercase; font-size: .625rem; line-height: 1.6; letter-spacing: .06em; margin-top: .4rem; }
  .access-grid h3 { font-size: 1rem; line-height: 1.4; } .access-grid p { color: var(--color-text-secondary); font-size: .8125rem; margin-top: .55rem; }
  .access-details > div { display: grid; gap: .8rem; padding-bottom: 1.5rem; color: var(--color-text-secondary); font-size: .875rem; }
  a:focus-visible, summary:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 5px; }
  @media (max-width: 900px) { .pricing-grid { gap: .8rem; } .pricing-card { padding: 1.3rem; } .card-actions .btn-primary { padding-inline: .7rem; font-size: .6875rem; } }
  @media (max-width: 680px) { .container { padding-inline: 1.25rem; } .pricing-hero { padding-top: 100px; padding-bottom: 2rem; } .pricing-hero .page-hero-sub { font-size: .9375rem; } .pricing-grid { grid-template-columns: 1fr; gap: 1.25rem; } .pricing-card { padding: 1.5rem; } .plan-mark, .device-mark { position: absolute; top: 1.5rem; right: 1.5rem; height: 48px; margin: 0; } .device-mark img { height: 48px; } .price { font-size: 2.7rem; } .tagline { min-height: 0; } .feature-list { margin-block: 1.25rem 1.5rem; } .feature-list li { font-size: .8125rem; } .card-actions { flex-direction: row; flex-wrap: wrap; gap: .75rem; align-items: center; } .card-actions .btn-primary { font-size: .8125rem; } .card-actions .text-link { font-size: .75rem; } .billing-note { font-size: .6875rem; text-align: left; } .access-grid { grid-template-columns: 1fr; gap: 1.75rem; } summary { font-size: .8125rem; } }
</style>
