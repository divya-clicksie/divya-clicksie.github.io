---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';
import NuboProductGuide from '../components/NuboProductGuide.astro';
import { nuboStory } from '../data/nuboMessaging';

const title = 'About Nubo | Everyday Care, Built by a Mom and Engineer';
const description = 'Built by a mom and engineer, Nubo connects everyday tracking, observations, and pediatrician visits, with a little less for parents to remember.';
const amazonURL = 'https://www.amazon.com/nubo-Newborn-Activity-Tracker-Color/dp/B0CJLNBG4P?maas=maas_adg_465D5CB69C73F660B7AD38831E2D680B_afap_abs&ref_=aa_maas&tag=maas';
const instagramURL = 'https://www.instagram.com/nubo_baby_tracker';
const youtubeURL = 'https://www.youtube.com/@NuboBabyTracker';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      name: title,
      description,
      url: 'https://www.nubotracker.com/about/',
      about: { '@id': 'https://www.nubotracker.com/#organization' }
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.nubotracker.com/#organization',
      name: 'Nubo',
      legalName: 'Clicksie LLC',
      url: 'https://www.nubotracker.com/',
      logo: 'https://www.nubotracker.com/images/nubo-logo.svg',
      slogan: 'Care with Confidence',
      description: nuboStory.description,
      founder: {
        '@type': 'Person',
        name: 'Divya',
        jobTitle: 'Founder of Nubo'
      },
      sameAs: [instagramURL, youtubeURL]
    }
  ]
};
---

<MarketingLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="m-hero"><div class="container m-split"><div><p class="overline">Created by a mom and engineer</p><h1>Built for the days<br />you can't keep it all<br />in your head.</h1><p class="m-lead">Nubo began with the feeds, diapers, and sleepless nights Divya knew firsthand. A little less to remember. More attention for the baby.</p><div class="m-actions"><a href="/app/" class="btn-primary">Explore Nubo</a><a href="/device/" class="text-link">Meet Nubo Remote <span aria-hidden="true">→</span></a></div></div><img class="m-photo" src="/images/hero-mother-baby-800.webp" alt="A parent holding their baby close" width="800" height="669" fetchpriority="high" /></div></section>
  <section class="founder-section"><div class="container founder-inner"><span class="quote-mark" aria-hidden="true">“</span><p class="overline">Divya · Founder of Nubo</p><blockquote>“So I built what I wished existed: something so simple you could use it with your eyes closed.”</blockquote><p class="m-note">Mom. Engineer. Sleep-deprived inventor.</p></div></section>
  <section class="m-section m-warm"><div class="container"><div class="m-heading center"><p class="overline">What guides Nubo</p><h2>Small choices.<br />A little more breathing room.</h2></div><div class="m-grid three"><article><span class="m-icon"><SiteIcon name="leaf" /></span><h3>Keep it simple.</h3><p class="m-note">Tap as it happens. Talk to catch up. Use what fits the moment.</p></article><article><span class="m-icon peach"><SiteIcon name="users" /></span><h3>Make room for your people.</h3><p class="m-note">Parents, grandparents, and nannies follow the same baby timeline.</p></article><article><span class="m-icon lilac"><SiteIcon name="lock" /></span><h3>Care for the data, too.</h3><p class="m-note">Private by design, with no ads or selling baby data.</p></article></div><div class="principle-line"><p><strong>Start with the free app.</strong> Nubo Remote adds a button when that's easier.</p><p><strong>Support without grading.</strong> Records and context to help you care for your baby.</p></div></div></section>
  <NuboProductGuide />
  <section class="m-cta"><div class="container"><p class="overline">Care with confidence</p><h2>Find what fits<br />your family.</h2><div class="m-actions"><a href="/pricing/" class="btn-primary">Explore Free and Plus</a><a href="/privacy/" class="text-link">How we handle privacy <span aria-hidden="true">→</span></a></div></div></section>
</MarketingLayout>
<style>
  .founder-section { padding-block: 3.5rem; } .founder-inner { max-width: 850px; text-align: center; } .quote-mark { color: #bedcd1; font-size: 5rem; font-weight: 700; line-height: .8; display: block; margin-bottom: .5rem; } .founder-inner blockquote { font-size: clamp(1.5rem,3vw,2.15rem); line-height: 1.45; letter-spacing: -.025em; text-wrap: balance; }
  .principle-line { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; border-top: 1px solid #dce4d9; padding-top: 1.5rem; margin-top: 2.5rem; } .principle-line p { font-size: .875rem; color: var(--color-text-secondary); } .principle-line strong { color: var(--color-text); display: block; margin-bottom: .4rem; }
  @media (max-width: 680px) { .principle-line { grid-template-columns: 1fr; gap: 1.25rem; } .founder-section { padding-block: 2.5rem; } }
</style>
