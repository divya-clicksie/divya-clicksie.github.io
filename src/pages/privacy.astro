---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';
import { nuboAccess } from '../data/nuboMessaging';

const title = 'Privacy | Nubo Intelligence, Nubo Care, and Sharing';
const description = 'Your family’s words, handled with care. See how Nubo processes voice logs and visit recaps, shares with invited caregivers, and backs up your records.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: 'https://www.nubotracker.com/privacy/'
};
---

<MarketingLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="m-hero"><div class="container m-split"><div><p class="overline">Private by design</p><h1>Your family's data.<br />Handled with care.</h1><p class="m-lead">A spoken update. A visit conversation. Your family's words deserve care. See what stays on your phone, what is processed on the server, and what invited caregivers receive.</p><div class="m-actions"><a href="#processing" class="btn-primary">See where data goes</a><a href="/privacy-policy/" class="text-link">Read the full policy <span aria-hidden="true">→</span></a></div></div><div class="privacy-map" aria-label="Your phone at the center, with optional encrypted caregiver sharing and backup in your own cloud account"><div class="phone-node"><SiteIcon name="phone" size={45} /><strong>Your phone</strong><span>Your baby's history</span></div><div class="map-branches"><div><SiteIcon name="users" size={28} /><strong>Invited caregivers</strong><span>Encrypted sharing</span></div><div><SiteIcon name="cloud" size={28} /><strong>Your cloud account</strong><span>Optional private backup</span></div></div></div></div></section>
  <section class="m-section" id="processing"><div class="container"><div class="m-heading center"><p class="overline">Feature by feature</p><h2>Where your information goes.</h2></div><div class="processing-cards"><article class="m-card"><span class="m-icon"><SiteIcon name="phone" /></span><p class="m-label">Everyday voice logging</p><h3>On your phone.</h3><p>Say what happened, then review and edit the events before saving. Speech recognition and event interpretation run on your phone, even offline.</p><p class="m-note">Supported Notetaker AI titles and tags also run on your phone.</p><details><summary>Notetaker device requirements</summary><p>{nuboAccess.notetaker}</p></details></article><article class="m-card care-processing"><span class="m-icon peach"><SiteIcon name="audio" /></span><p class="m-label">Nubo Care</p><h3>Processed, then cleared.</h3><p>Selected visit content goes to the server for processing. Nubo and its processing providers retain no visit data afterward.</p><div class="processing-path"><span>Selected content</span><span aria-hidden="true">→</span><span>Process</span><span aria-hidden="true">→</span><strong>Clear</strong></div><p class="m-note">Recaps sync to invited caregivers. Original audio stays on the recording phone.</p></article><article class="m-card"><span class="m-icon lilac"><SiteIcon name="cloud" /></span><p class="m-label">Alexa logging</p><h3>Through Amazon.</h3><p>Alexa requests use Amazon's Alexa systems. Resulting care events join your baby timeline.</p><a href="/alexa/" class="text-link">Explore Alexa <span aria-hidden="true">→</span></a></article></div></div></section>
  <section class="m-section m-teal"><div class="container m-split"><div class="m-copy"><p class="overline">Clear boundaries</p><h2>Shared care.<br />Thoughtful limits.</h2><p>Share the last feed and the visit recap with invited caregivers. Your private pumping history stays separate, and original visit audio stays on the recording phone.</p><a href="/caregivers/" class="text-link">See caregiver sharing <span aria-hidden="true">→</span></a></div><dl class="privacy-boundaries"><div><dt><SiteIcon name="users" size={20} />Baby logs and recaps</dt><dd>For invited caregivers, with end-to-end encrypted sharing.</dd></div><div><dt><SiteIcon name="lock" size={20} />Private pumping</dt><dd>Your milk output stays outside the caregiver timeline.</dd></div><div><dt><SiteIcon name="audio" size={20} />Original visit audio</dt><dd>Kept on the phone that recorded it.</dd></div><div><dt><SiteIcon name="cloud" size={20} />Optional backups</dt><dd>In your own iCloud or Google Drive account.</dd></div></dl></div></section>
  <section class="m-section"><div class="container m-grid three"><article><span class="m-icon"><SiteIcon name="check" /></span><h3>No selling baby data.</h3><p class="m-note">Your family's care history serves your family.</p></article><article><span class="m-icon peach"><SiteIcon name="leaf" /></span><h3>A quiet website.</h3><p class="m-note">Cookieless Plausible analytics. No ad pixels, retargeting, heatmaps, or session replay.</p></article><article><span class="m-icon lilac"><SiteIcon name="phone" /></span><h3>Your history stays.</h3><p class="m-note">Your baby history remains available in the free app if Plus access ends.</p></article></div></section>
  <section class="m-cta"><div class="container"><p class="overline">The details are here when you need them</p><h2>A clear policy.<br />A team you can reach.</h2><div class="m-actions"><a href="/privacy-policy/" class="btn-primary">Read the privacy policy</a><a href="/contact/" class="text-link">Ask a privacy question <span aria-hidden="true">→</span></a></div></div></section>
</MarketingLayout>
<style>
  .privacy-map { border-radius: 30px; padding: 2rem; background: #edf6f0; color: var(--color-brand-dark); } .phone-node { display: grid; justify-items: center; gap: .6rem; background: #fff; border: 1px solid #d3e3d6; border-radius: 20px; padding: 1.5rem; max-width: 230px; margin: 0 auto; } .phone-node span { font-size: .75rem; color: var(--color-text-secondary); }
  .map-branches { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2rem; } .map-branches > div { position: relative; display: grid; gap: .6rem; justify-items: center; text-align: center; padding: 1.25rem .75rem; border-radius: 18px; border: 1px solid #d3e3d6; background: #ffffffa6; } .map-branches > div::before { content: ''; width: 1px; height: 2rem; background: #b8d1bd; position: absolute; left: 50%; top: -2rem; } .map-branches strong { font-size: .8125rem; } .map-branches span { font-size: .6875rem; color: var(--color-text-secondary); }
  .processing-cards { display: grid; grid-template-columns: 1fr 1.2fr 1fr; gap: 1.25rem; } .care-processing { background: #fff6ec !important; border-color: #ebdfd0 !important; } .processing-cards h3 { font-size: 1.3rem; } .processing-cards .m-card > .m-note { font-size: .75rem; } .processing-cards details { font-size: .75rem; color: var(--color-brand-dark); margin-top: 1rem; } .processing-cards summary { cursor: pointer; } .processing-cards details p { margin-top: .6rem; font-size: .8125rem; color: var(--color-text-secondary); }
  .processing-path { display: flex; gap: .5rem; align-items: center; font-size: .625rem; margin-top: 1.25rem; color: #785a3f; background: #fff; padding: .7rem; border-radius: 9px; }
  .privacy-boundaries { display: grid; gap: 1.1rem; margin: 0; } .privacy-boundaries > div { padding-bottom: 1.1rem; border-bottom: 1px solid #c7e1dd; } .privacy-boundaries > div:last-child { padding: 0; border: 0; } .privacy-boundaries dt { display: flex; align-items: center; gap: .65rem; font-size: .9375rem; font-weight: 700; } .privacy-boundaries dd { font-size: .8125rem; color: var(--color-text-secondary); margin: .35rem 0 0 2rem; }
  @media (max-width: 900px) { .processing-cards { grid-template-columns: 1fr; } }
  @media (max-width: 680px) { .privacy-map { padding: 1.5rem; } .map-branches { gap: .75rem; } .map-branches strong { font-size: .75rem; } }
</style>
