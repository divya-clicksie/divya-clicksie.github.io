---
import { getCollection } from 'astro:content';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import SiteIcon from '../components/SiteIcon.astro';


const title = 'Nubo Resources | Preemies, Twins, Toddlers, and Young Kids';
const description = 'Find practical Nubo guides for premature babies, twins, toddlers, and young kids, plus everyday tracking, caregiver sharing, and visit preparation.';

const guides = await getCollection('guides');
const familyGuides = [
  { slug: 'nubo-for-preemie-babies', stage: 'Born early' },
  { slug: 'nubo-for-twins', stage: 'Twins and multiples' },
  { slug: 'nubo-for-toddlers', stage: 'The toddler years' },
  { slug: 'nubo-for-young-kids', stage: 'The preschool years' },
].map(({ slug, stage }) => {
  const guide = guides.find((entry) => entry.slug === slug);
  if (!guide) throw new Error(`Missing family guide: ${slug}`);
  return { guide, stage };
});

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime())
  .slice(0, 6);

const helpResources = [
  { title: 'Trust & Privacy', href: '/privacy/', icon: 'lock', description: 'What’s free, why Care is paid, and how your family’s information is handled.', link: 'Read Trust & Privacy' },
  { title: 'Compare options', href: '/compare/', icon: 'phone', description: 'Find the app and device setup that fits the care your family shares.', link: 'Compare Nubo setups' },
  { title: 'Nubo questions', href: '/faq/', icon: 'questions', description: 'Practical answers about visits, tracking, caregiver sharing, and getting started.', link: 'Read Nubo FAQs' },
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: 'https://www.nubotracker.com/resources/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      ...helpResources.map(({ title, href }) => ({ name: title, url: `https://www.nubotracker.com${href}` })),
      ...familyGuides.map(({ guide }) => ({
        url: `https://www.nubotracker.com/guides/${guide.slug}/`,
        name: guide.data.title,
      })),
      ...posts.map((post) => ({
        url: `https://www.nubotracker.com/blog/${post.data.category}/${post.slug}/`,
        name: post.data.title,
      })),
    ].map((resource, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      ...resource,
    })),
  },
};

const topics = [
 ['Sleep', '/blog/sleep/', 'moon'], ['Feeding', '/blog/feeding/', 'bottle'],
 ['Tracking', '/blog/tracking/', 'check'], ['Caregivers', '/blog/caregiver/', 'users'],
 ['Privacy', '/blog/privacy/', 'lock'], ['Product', '/blog/product/', 'sparkles'], ['Gifts', '/blog/gifts/', 'gift'],
] as const;
const familyCopy: Record<string, string> = {
 'nubo-for-preemie-babies': 'Care records, growth context, and questions for follow-ups.',
 'nubo-for-twins': 'Separate records, shared caregivers, and a day with more than one baby.',
 'nubo-for-toddlers': 'Changing routines, little observations, and the next checkup.',
 'nubo-for-young-kids': 'Everyday details to bring to the next conversation.',
};
const familyTopics = ['tracking', 'caregiver', 'feeding', 'product'];
---

<MarketingLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="m-hero"><div class="container m-split"><div><p class="overline">Nubo resources</p><h1>Help for the<br />stage you're in.</h1><p class="m-lead">When the days are full, a useful guide can help. Find practical ways to keep track, share care, and prepare for your child's next visit, from newborn days to preschool.</p><div class="m-actions"><a href="#your-family" class="btn-primary">Find your family guide</a><a href="/blog/" class="text-link">Browse all articles <span aria-hidden="true">→</span></a></div></div><img class="m-photo resource-hero-image" src="/images/nubo-care-toddler-visit-v6-960.webp" alt="Concept photo of a parent and toddler talking with a doctor at a checkup" width="960" height="480" fetchpriority="high" /></div></section>
  <section class="m-section" id="your-family"><div class="container"><div class="m-heading"><p class="overline">Your family, your stage</p><h2>Start where you are.</h2></div><div class="m-grid two">{familyGuides.map(({ guide, stage }, index) => <ResourceCard title={guide.data.title} href={`/guides/${guide.slug}/`} label={stage} category={familyTopics[index]} excerpt={familyCopy[guide.slug]} />)}</div></div></section>
  <section class="m-section m-warm"><div class="container m-split"><img class="m-photo newborn-guide-image" src="/images/hero-mother-baby-800.webp" alt="A parent holding their newborn close" width="800" height="669" loading="lazy" /><div class="m-copy"><p class="overline">New here?</p><h2>The first 12 weeks.<br />One useful place to start.</h2><p>A practical guide to keeping track of feeds, sleep, and diapers when the days blur together.</p><a href="/guides/track-feeding-sleep-diapers-first-12-weeks/" class="text-link">Read the newborn guide <span aria-hidden="true">→</span></a></div></div></section>
  <section class="m-section"><div class="container"><div class="m-heading"><p class="overline">Browse by topic</p><h2>What would help today?</h2></div><nav class="topic-links" aria-label="Resource topics">{topics.map(([label, href, icon]) => <a href={href}><SiteIcon name={icon} size={22} /><span>{label}</span><span aria-hidden="true">↗</span></a>)}</nav><div class="quick-links"><a href="/app/#app-downloads">Explore everyday tracking <span aria-hidden="true">→</span></a><a href="/pricing/">Compare Free and Plus <span aria-hidden="true">→</span></a><a href="/exclusive-pumping/">Private pumping <span aria-hidden="true">→</span></a><a href="/faq/#nubo-intelligence">Nubo questions <span aria-hidden="true">→</span></a></div></div></section>
  <section class="m-section m-teal" aria-labelledby="nubo-help-title"><div class="container"><div class="m-heading"><p class="overline">Choosing and using Nubo</p><h2 id="nubo-help-title">A few useful answers.</h2></div><div class="m-grid three">{helpResources.map(({ title, href, icon, description, link }) => <article class="m-card"><span class="m-icon"><SiteIcon name={icon} /></span><h3>{title}</h3><p>{description}</p><a href={href} class="text-link">{link} <span aria-hidden="true">→</span></a></article>)}</div></div></section>
  <section class="m-section m-ivory"><div class="container"><div class="m-heading"><p class="overline">From the Nubo blog</p><h2>A little help for everyday care.</h2></div><div class="m-grid three">{posts.map((post) => <ResourceCard title={post.data.title} href={`/blog/${post.data.category}/${post.slug}/`} label={post.data.category} category={post.data.category} image={post.data.heroImage} />)}</div><div class="m-actions"><a href="/blog/" class="text-link">View all articles <span aria-hidden="true">→</span></a></div></div></section>
</MarketingLayout>
<style>
  .resource-hero-image { min-height: 300px; object-fit: cover; object-position: 70% center; } .newborn-guide-image { max-height: 340px; object-fit: cover; }
  .topic-links { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: .75rem; } .topic-links a { display: flex; align-items: center; gap: .7rem; padding: 1.1rem; background: #f3f7f4; border: 1px solid #e1e7dd; border-radius: 16px; color: var(--color-brand-dark); font-size: .875rem; font-weight: 700; } .topic-links a > span:last-child { margin-left: auto; font-size: .75rem; }
  .quick-links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 1.75rem; font-size: .8125rem; color: var(--color-brand-dark); font-weight: 700; }
  @media (max-width: 850px) { .topic-links { grid-template-columns: 1fr 1fr; } } @media (max-width: 680px) { .resource-hero-image { min-height: 220px; max-height: 260px; } .topic-links a { padding: 1rem; font-size: .8125rem; } }
</style>
