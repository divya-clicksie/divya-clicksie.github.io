---
import { getCollection } from 'astro:content';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import ResourceCard from '../../components/ResourceCard.astro';


const title = 'Nubo Blog | Everyday Tracking, Shared Care, and Doctor Visits';
const description = 'Practical Nubo articles for feeds, sleep, shared care, privacy, and preparing for pediatrician visits. Find help for the care you’re doing today.';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime()
);

const categoryLabels: Record<string, string> = {
  sleep: 'Sleep',
  feeding: 'Feeding',
  tracking: 'Tracking',
  caregiver: 'Caregiver',
  privacy: 'Privacy',
  product: 'Product',
  gifts: 'Gifts',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: 'https://www.nubotracker.com/blog/',
  publisher: {
    '@type': 'Organization',
    name: 'Nubo',
    url: 'https://www.nubotracker.com/',
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://www.nubotracker.com/blog/${post.data.category}/${post.slug}/`,
      name: post.data.title,
    })),
  },
};---

<MarketingLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="m-hero m-title"><div class="container"><p class="overline">The Nubo blog</p><h1>For the everyday<br />questions of care.</h1><p class="m-lead">Feeds, sleep, handoffs, and preparing for the next checkup. Practical reading for the care you do every day.</p></div></section>
  <section class="m-section"><div class="container"><nav class="blog-filters" aria-label="Browse posts by category"><a class="active" href="/blog/" aria-current="page">All articles</a>{Object.entries(categoryLabels).filter(([key]) => posts.some((post) => post.data.category === key)).map(([key,label]) => <a href={`/blog/${key}/`}>{label}</a>)}</nav><div class="m-grid three">{posts.map((post,index) => <ResourceCard title={post.data.title} href={`/blog/${post.data.category}/${post.slug}/`} label={categoryLabels[post.data.category]} category={post.data.category} image={post.data.heroImage} excerpt={index < 3 ? post.data.excerpt || post.data.description : undefined} headingLevel="h2" />)}</div></div></section>
</MarketingLayout>
<style>
  .blog-filters { display: flex; justify-content: center; flex-wrap: wrap; gap: .6rem; margin-bottom: 2rem; }
  .blog-filters a { font-size: .8125rem; font-weight: 700; padding: .5rem .9rem; border: 1px solid #dce4d8; border-radius: 22px; color: var(--color-brand-dark); }
  .blog-filters .active { background: var(--color-brand); color: #fff; border-color: var(--color-brand); }
</style>
