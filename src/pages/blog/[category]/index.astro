---
import { getCollection } from 'astro:content';
import MarketingLayout from '../../../layouts/MarketingLayout.astro';
import ResourceCard from '../../../components/ResourceCard.astro';
import SiteIcon from '../../../components/SiteIcon.astro';


const categoryLabels: Record<string, string> = {
  sleep: 'Sleep',
  feeding: 'Feeding',
  tracking: 'Tracking',
  caregiver: 'Caregiver',
  privacy: 'Privacy',
  product: 'Product',
  gifts: 'Gifts',
};

const categoryDescriptions: Record<string, string> = {
  sleep: 'Guides for newborn sleep, wake windows, regressions, and nighttime tracking routines.',
  feeding: 'Feeding guides for breastfeeding, bottles, exclusive pumping, allergens, and intake notes.',
  tracking: 'Practical advice for logging feeds, sleep, diapers, growth, vaccines, and patterns.',
  caregiver: 'Caregiver handoff guides for partners, grandparents, nannies, and returning to work.',
  privacy: 'Plain-English guidance on baby data, voice logging, backups, and sharing.',
  product: 'Nubo product guides, setup help, features, and workflow ideas.',
  gifts: 'Gift guides and practical baby shower ideas for new parents.',
};

const categoryCtas: Record<string, { title: string; copy: string; href: string; label: string }> = {
  sleep: {
    title: 'Track nights without unlocking your phone every time.',
    copy: 'Nubo combines a 1-second Nubo Remote tap with voice catch-up and a shared caregiver timeline.',
    href: '/device/',
    label: 'View Nubo Remote',
  },
  feeding: {
    title: 'A free app for feeds, pumped milk bottles, and notes.',
    copy: 'Use Nubo for the basics from day one, then add Nubo Plus private pumping when milk output should stay separate from the shared baby log.',
    href: '/app/',
    label: 'Explore the app',
  },
  tracking: {
    title: 'Not sure which Nubo setup fits?',
    copy: 'Compare the free app, Nubo Plus, and Nubo Remote by household, caregiver needs, and logging speed.',
    href: '/pricing/',
    label: 'See pricing',
  },
  caregiver: {
    title: 'Keep every caregiver on the same timeline.',
    copy: 'See how QR invites, sync, and device-based Nubo Plus access work for partners, grandparents, nannies, and daycare.',
    href: '/caregivers/',
    label: 'See caregiver sync',
  },
  privacy: {
    title: 'Baby data should stay with the family caring for the baby.',
    copy: 'Read how Nubo handles local storage, private voice logging, caregiver sharing, and backups.',
    href: '/privacy/',
    label: 'Read privacy overview',
  },
  product: {
    title: 'Compare the Nubo setup options.',
    copy: 'See how the free app, Nubo Plus, and the Nubo Remote differ by speed, privacy, and caregiver needs.',
    href: '/compare/',
    label: 'Compare options',
  },
  gifts: {
    title: 'A baby shower gift that still matters at 3 a.m.',
    copy: 'Nubo Remote gives parents the fastest log, fewer phone pickups, and refreshed Nubo Plus access for active syncing phones.',
    href: '/gift/',
    label: 'See the gift page',
  },
};

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = [...new Set(posts.map((post) => post.data.category))];
  return categories.map((category) => ({ params: { category }, props: { category, posts } }));
}

const { category, posts } = Astro.props;
const categoryPosts = posts
  .filter((post) => post.data.category === category)
  .sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime());
const label = categoryLabels[category] || category;
const description = categoryDescriptions[category] || `Nubo ${label.toLowerCase()} articles and guides.`;
const title = `${label} Baby Tracking Guides | Nubo Resources`;
const categoryCta = categoryCtas[category] || categoryCtas.tracking;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: `https://www.nubotracker.com/blog/${category}/`,
};---

<MarketingLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="m-hero m-title"><div class="container"><p class="overline">Nubo blog · {categoryPosts.length} articles</p><h1>{label} guides</h1><p class="m-lead">{description}</p></div></section>
  <section class="m-section"><div class="container"><nav class="category-actions" aria-label="Article navigation"><a href="/blog/" class="text-link">All articles <span aria-hidden="true">←</span></a><a href="/resources/" class="text-link">Family guides <span aria-hidden="true">→</span></a></nav><div class="m-grid three">{categoryPosts.map((post) => <ResourceCard title={post.data.title} href={`/blog/${post.data.category}/${post.slug}/`} label={label} category={category} image={post.data.heroImage} headingLevel="h2" />)}</div></div></section>
  <aside class="category-next"><div class="container"><span class="m-icon"><SiteIcon name="leaf" /></span><div><p class="m-label">A next step with Nubo</p><h2>{categoryCta.title}</h2></div><a href={categoryCta.href} class="text-link">{categoryCta.label} <span aria-hidden="true">→</span></a></div></aside>
</MarketingLayout>
<style>
  .category-actions { display: flex; gap: 1.5rem; justify-content: space-between; margin-bottom: 1.5rem; font-size: .875rem; }
  .category-next { background: var(--color-brand-light); padding-block: 2rem; } .category-next > .container { display: grid; grid-template-columns: auto 1fr auto; gap: 1.5rem; align-items: center; } .category-next .m-icon { margin: 0; background: #fff; } .category-next h2 { font-size: 1.4rem; max-width: 650px; } .category-next a { font-size: .8125rem; }
  @media (max-width: 680px) { .category-next > .container { grid-template-columns: auto 1fr; gap: 1rem; } .category-next a { grid-column: 2; } }
</style>
