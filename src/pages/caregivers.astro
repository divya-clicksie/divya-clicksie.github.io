---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';
import StoreLinks from '../components/StoreLinks.astro';
import FaqList from '../components/FaqList.astro';

const title = 'Baby Tracker for Caregivers, Nannies, and Grandparents | Nubo';
const description = 'Care changes hands. Share feeds, sleep, and everyday observations with unlimited caregivers, free on iPhone and Android. Share visit recaps with Nubo Care.';
const amazonURL = 'https://www.amazon.com/nubo-Newborn-Activity-Tracker-Color/dp/B0CJLNBG4P?maas=maas_adg_465D5CB69C73F660B7AD38831E2D680B_afap_abs&ref_=aa_maas&tag=maas';
const appStoreURL = 'https://apps.apple.com/us/app/nubo-baby-tracker/id1667461158';
const playStoreURL = 'https://play.google.com/store/apps/details?id=com.clicksie.nuboapp';

const caregiverTypes = [
  { icon: 'users', title: 'Partners', body: 'Pick up the day without a long recap.' },
  { icon: 'leaf', title: 'Grandparents', body: 'Join the same timeline on iPhone or Android.' },
  { icon: 'check', title: 'Nannies and sitters', body: 'Keep parents in the loop as care happens.' },
  { icon: 'moon', title: 'Overnight helpers', body: 'Leave the details for the next sleepy handoff.' },
] as const;

const sharedItems = [
  'Feeds and bottles',
  'Nursing sessions',
  'Sleep',
  'Wet and dirty diapers',
  'Medicine',
  'Growth',
  'Vaccines',
  'Allergens',
  'Milestones',
  'Notes'
];

const faqItems = [
  {
    q: 'Can multiple caregivers use Nubo?',
    a: 'Yes. Nubo is built for shared baby tracking. Parents can invite partners, grandparents, nannies, sitters, and other trusted caregivers to the same baby timeline.'
  },
  {
    q: 'Is caregiver sharing free?',
    a: 'Yes. Unlimited caregivers are included in the free Nubo app. Nubo Plus and the physical tracker are optional upgrades.'
  },
  {
    q: 'Do grandparents or nannies need the device?',
    a: 'No. Caregivers can use the free app. The device is optional for helpers who prefer simple physical buttons for feeds, sleep, and diapers.'
  },
  {
    q: 'Can caregivers see private pumping logs?',
    a: 'No. Private pumping is a Nubo Plus app tool, and pumping data is not shared with caregivers on the baby timeline. For exclusive pumping families, caregivers can still log pumped milk bottles as baby feeds.'
  },
  {
    q: 'Does the device require a Nubo Plus subscription?',
    a: 'No. The device works with the free app, and device sync refreshes a 30-day Nubo Plus access window for active phones.'
  }
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: 'https://www.nubotracker.com/caregivers/',
    about: { '@type': 'SoftwareApplication', name: 'Nubo Baby Tracker App' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a
      }
    }))
  }
];
---

<MarketingLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="m-hero"><div class="container m-split"><div><p class="overline">Baby tracking for your whole care team</p><h1>Care changes hands.<br />The details come along.</h1><p class="m-lead">The last bottle, the morning nap, the little thing you noticed. Keep the details ready for your partner, a grandparent, or the nanny.</p><div class="m-actions"><StoreLinks eager /></div><p class="m-note">Unlimited caregivers, free on iPhone and Android.</p></div><div class="caregiver-visual"><img src="/images/caregiver-hub.webp" alt="Nubo device and app connected across multiple caregiver phones" width="970" height="600" fetchpriority="high" /><div class="shared-badge"><SiteIcon name="users" size={19} />Same baby. Same timeline.</div></div></div></section>
  <aside class="m-strip" aria-label="Shared care essentials"><div class="container"><span><SiteIcon name="users" size={19} />Unlimited caregivers</span><span><SiteIcon name="phone" size={19} />iPhone + Android</span><a href="/privacy/"><SiteIcon name="lock" size={19} />Private invites</a></div></aside>
  <section class="m-section"><div class="container m-split"><div class="m-copy"><p class="overline">The next set of arms</p><h2>Your turn.<br />The details are here.</h2><p>Your partner logged the bottle. The last nap is here, too. Check the time, amount, and who was there before you take over.</p><a href="/app/" class="text-link">See the shared app <span aria-hidden="true">→</span></a><p class="m-note">Plus Live Activities can put recent care and active timers on your iPhone Lock Screen.</p></div><figure class="handoff-timeline"><div class="timeline-top"><strong>Ella's day</strong><span>Illustrative sample</span></div><div class="timeline-row"><span class="event-icon bottle"><SiteIcon name="bottle" /></span><div><strong>Pumped milk · 90 mL</strong><span>8:00 AM · Dad</span></div><span class="row-status">Shared</span></div><div class="timeline-row"><span class="event-icon diaper"><SiteIcon name="drop" /></span><div><strong>Wet diaper</strong><span>8:20 AM · Mom</span></div><span class="row-status">Shared</span></div><div class="timeline-row"><span class="event-icon sleep"><SiteIcon name="moon" /></span><div><strong>Nap · 45 minutes</strong><span>9:00 AM · Grandma</span></div><span class="row-status">Shared</span></div><figcaption>Updates are shared when phones sync and have connectivity.</figcaption></figure></div></section>
  <section class="m-section m-warm"><div class="container"><div class="m-heading center"><p class="overline">Whoever is helping today</p><h2>A place for your people.</h2></div><div class="m-grid four">{caregiverTypes.map((item) => <article class="care-person"><span class="m-icon"><SiteIcon name={item.icon} /></span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></div></section>
  <section class="m-section"><div class="container"><div class="m-heading center"><p class="overline">Use what fits the moment</p><h2>A phone in hand.<br />Or a button close by.</h2></div><div class="m-grid two"><article class="logging-card app-logging"><div class="logging-copy"><p class="m-label">Free app</p><h3>Tap as it happens.<br />Talk to catch up.</h3><p>Nubo Intelligence helps turn a spoken update into logs. Review and edit before saving. Keep observations in your own words, too.</p><a href="/app/#intelligence" class="text-link">Explore Nubo Intelligence <span aria-hidden="true">→</span></a></div><div class="voice-bubble"><SiteIcon name="mic" size={28} /><blockquote>“She had a bottle at eight.”</blockquote><span>Illustrative voice update</span></div></article><article class="logging-card device-logging"><img src="/images/nubo-oneclick.webp" alt="A Nubo device held in one hand" width="740" height="554" loading="lazy" /><div class="logging-copy"><p class="m-label">Optional device</p><h3>A familiar button.</h3><p>Feeds, sleep, and diapers without opening a phone. Sync over Bluetooth when a paired phone is nearby.</p><a href="/device/" class="text-link">Meet the device <span aria-hidden="true">→</span></a></div></article></div></div></section>
  <section class="m-section m-teal"><div class="container m-split"><div class="m-copy"><p class="overline">The right details, shared</p><h2>The baby timeline<br />belongs to the team.</h2><p>Feeds, sleep, and the little things the next caregiver needs.</p><ul class="m-pill-list shared-items">{sharedItems.map((item) => <li>{item}</li>)}</ul></div><aside class="private-pumping"><span class="m-icon"><SiteIcon name="lock" size={26} /></span><h3>Your pumping stays yours.</h3><p>With Plus, private pumping output stays separate. Caregivers can log your baby's bottles without seeing your pumping sessions.</p><a href="/exclusive-pumping/" class="text-link">How private pumping works <span aria-hidden="true">→</span></a></aside></div></section>
  <section class="m-section"><div class="container m-split"><div class="m-copy"><p class="overline">Nubo Care · Included in Plus</p><h2>“What did the doctor say?”<br />The recap is here.</h2><p>Your partner couldn't make the visit. With Nubo Care, invited caregivers can read the recap, your pediatrician's answers, and the next steps.</p><a href="/#nubo-care" class="text-link">Explore Nubo Care <span aria-hidden="true">→</span></a></div><figure class="visit-card"><p class="m-label">Sample shared visit</p><h3>Ella's pediatrician visit</h3><div><SiteIcon name="check" size={20} /><p>Save feeding observations for the follow-up.</p></div><figcaption>Recaps sync to invited caregivers. Original audio stays on the recording phone.</figcaption></figure></div></section>
  <section class="m-section m-warm"><div class="container m-split"><div class="m-heading"><p class="overline">Caregiver questions</p><h2>Before you invite<br />your first helper.</h2></div><FaqList items={faqItems} /></div></section>
  <section class="m-cta"><div class="container"><h2>One baby.<br />Everyone on the same page.</h2><p>Start with the free app and invite the people who help.</p><div class="m-actions"><StoreLinks /></div></div></section>
</MarketingLayout>
<style>
  .caregiver-visual { padding: 2rem 1.25rem; background: #eef6f1; border-radius: 30px; } .shared-badge { display: flex; align-items: center; justify-content: center; gap: .6rem; font-size: .8125rem; font-weight: 700; color: var(--color-brand-dark); margin-top: 1.25rem; }
  .handoff-timeline { margin: 0; border: 1px solid #e1e8df; border-radius: 24px; background: #fffaf7; padding: 1.5rem; }
  .timeline-top { display: flex; justify-content: space-between; align-items: center; gap: .5rem; padding-bottom: 1rem; } .timeline-top span { font-size: .6875rem; color: var(--color-text-secondary); }
  .timeline-row { display: flex; align-items: center; gap: .8rem; padding-block: 1rem; border-top: 1px solid #e9e7df; } .timeline-row strong { display: block; font-size: .875rem; } .timeline-row div > span { display: block; color: var(--color-text-secondary); font-size: .75rem; margin-top: .3rem; }
  .event-icon { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 15px; flex-shrink: 0; } .bottle { background: #fff0df; color: #946039; } .diaper { background: #e5f4f2; color: var(--color-brand-dark); } .sleep { background: #f0ebf8; color: #7654a1; }
  .row-status { margin-left: auto; font-size: .625rem; color: var(--color-brand-dark); } figcaption { font-size: .6875rem; color: var(--color-text-secondary); line-height: 1.7; margin-top: 1rem; }
  .care-person h3 { font-size: 1.1rem; } .care-person p { font-size: .8125rem; color: var(--color-text-secondary); margin-top: .5rem; }
  .logging-card { border-radius: 26px; overflow: hidden; } .app-logging { background: #f1eff8; display: flex; flex-direction: column; } .device-logging { background: #f1f7f3; } .device-logging img { width: 100%; height: 205px; object-fit: cover; }
  .logging-copy { padding: 1.75rem; } .logging-copy p:not(.m-label) { margin-top: .7rem; color: var(--color-text-secondary); font-size: .875rem; } .logging-copy a { display: inline-block; font-size: .8125rem; margin-top: 1rem; }
  .voice-bubble { margin: auto 1.75rem 1.75rem; background: #fff; border-radius: 18px; padding: 1.75rem; color: #6d5388; } .voice-bubble blockquote { margin-top: 1rem; font-size: 1.35rem; font-weight: 600; } .voice-bubble > span { display: block; color: var(--color-text-secondary); font-size: .625rem; margin-top: 1.25rem; }
  .shared-items { margin-top: 1.25rem; } .private-pumping { background: #fff; border: 1px solid #cde5e1; border-radius: 24px; padding: 2rem; } .private-pumping p { font-size: .875rem; color: var(--color-text-secondary); margin-top: .8rem; } .private-pumping a { display: inline-block; margin-top: 1.2rem; font-size: .8125rem; }
  .visit-card { background: #fff7ed; border: 1px solid #eee1d2; border-radius: 24px; padding: 2rem; } .visit-card > div { display: flex; gap: .75rem; align-items: center; background: #fff; border-radius: 12px; padding: 1rem; margin-top: 1.25rem; font-size: .875rem; } .visit-card svg { flex-shrink: 0; color: var(--color-brand-dark); }
  @media (max-width: 680px) { .caregiver-visual { padding: 1.5rem 1rem; } .row-status { display: none; } .private-pumping, .visit-card { padding: 1.5rem; } .voice-bubble { margin-top: .5rem; } }
</style>
