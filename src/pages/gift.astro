---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';
import FaqList from '../components/FaqList.astro';

const title = 'Baby Shower Gift for New Parents | One-Tap Baby Tracker';
const description = 'A little help for very full days. Give the Nubo device for feeds, naps, and diapers, with free shared tracking and Plus access refreshed by device sync.';
const amazonURL = 'https://www.amazon.com/nubo-Newborn-Activity-Tracker-Color/dp/B0CJLNBG4P?maas=maas_adg_465D5CB69C73F660B7AD38831E2D680B_afap_abs&ref_=aa_maas&tag=maas';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Nubo Baby Tracker Gift',
  description,
  image: 'https://www.nubotracker.com/images/nubo-instant-tracker.webp',
  brand: { '@type': 'Brand', name: 'nubo' },
  offers: {
    '@type': 'Offer',
    price: '89.00',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: amazonURL
  }
};
---

<MarketingLayout title={title} description={description} jsonLd={jsonLd} ctaHref={amazonURL} ctaLabel="Buy on Amazon" ctaExternal>
  <section class="m-hero"><div class="container m-split"><div><p class="overline">A practical baby shower gift</p><h1>A little help.<br />For the very full days.</h1><p class="m-lead">Give new parents a simple way to remember feeds, naps, and diapers, even when they're running on little sleep.</p><div class="m-actions"><a href={amazonURL} class="btn-primary" target="_blank" rel="noopener noreferrer">Buy on Amazon</a><span class="gift-price"><del>$109</del> $89</span></div><p class="m-note">Purchase, shipping, and returns through Amazon.</p></div><figure class="gift-photo"><img src="/images/nubo-gift.webp" alt="Nubo device package presented in an open gift box" width="550" height="440" fetchpriority="high" /><figcaption>Gift presentation shown for inspiration.</figcaption></figure></div></section>
  <section class="m-section"><div class="container m-grid three"><article><span class="m-icon peach"><SiteIcon name="gift" /></span><h3>Easy to explain.</h3><p class="m-note">Dedicated buttons for bottles, nursing, sleep, and diapers.</p></article><article><span class="m-icon"><SiteIcon name="users" /></span><h3>Useful for helping hands.</h3><p class="m-note">Parents, grandparents, and nannies can use the same buttons.</p></article><article><span class="m-icon lilac"><SiteIcon name="sparkles" /></span><h3>Help beyond the daily log.</h3><p class="m-note">Each phone that syncs gets a refreshed 30-day Plus window, including Nubo Care for pediatrician visits.</p></article></div></section>
  <section class="m-section m-warm"><div class="container m-split"><img class="m-photo" src="/images/nubo-oneclick.webp" alt="The Nubo baby tracker held in one hand" width="740" height="554" loading="lazy" /><div class="m-copy"><p class="overline">What comes with the gift</p><h2>A tap for the moment.<br />An app for the record.</h2><ul class="kit-list"><li><SiteIcon name="check" size={19} />Nubo device with dedicated care buttons</li><li><SiteIcon name="check" size={19} />Magnetic mount, lanyard, and battery</li><li><SiteIcon name="check" size={19} />Free app with unlimited caregivers</li><li><SiteIcon name="check" size={19} />Plus access refreshed by each phone's device sync</li></ul><a href="/device/" class="text-link">Explore the device <span aria-hidden="true">→</span></a></div></div></section>
  <section class="m-section"><div class="container"><div class="m-heading center"><p class="overline">A place in the routine</p><h2>Before the first feed.<br />Through the next handoff.</h2></div><ol class="m-grid three m-steps"><li><h3>Before baby arrives.</h3><p>Install the app, pair the device, and find a spot near the changing table.</p></li><li><h3>In the first weeks.</h3><p>Keep track of feeds and diapers when the days blur together.</p></li><li><h3>When help arrives.</h3><p>Let grandparents or a nanny add to the same baby timeline.</p></li></ol></div></section>
  <section class="m-section m-warm"><div class="container m-split"><div class="m-heading"><p class="overline">Before you wrap it</p><h2>A few gift questions.</h2></div><FaqList items={[
    { q: 'Will the parents need a subscription?', a: 'The device works with the free app. Each phone that syncs gets a refreshed 30-day Plus window, including Nubo Care and Nubo Noticed all week. A store subscription is optional.' },
    { q: 'What if they already use a baby app?', a: 'Nubo adds physical buttons for the moments a phone is out of reach. Device events sync into the Nubo app.' },
    { q: 'Does it work on iPhone and Android?', a: 'Yes. Caregivers can share the same baby timeline across both platforms.' },
    { q: 'Where do I buy it?', a: 'Nubo is sold through Amazon. Purchase, shipping, and returns happen there.' },
  ]} /></div></section>
  <section class="m-cta"><div class="container"><p class="overline">A gift for everyday care</p><h2>Something useful<br />when the house is quiet.</h2><div class="m-actions"><a href={amazonURL} class="btn-primary" target="_blank" rel="noopener noreferrer">Buy on Amazon</a><a href="/blog/gifts/best-baby-shower-gifts-for-new-parents/" class="text-link">Read the gift guide <span aria-hidden="true">→</span></a></div></div></section>
</MarketingLayout>
<style>
  .gift-price { font-size: 1.6rem; font-weight: 700; } .gift-price del { font-size: 1rem; font-weight: 500; color: var(--color-text-secondary); margin-right: .3rem; }
  .gift-photo { background: #f3eee3; border-radius: 30px; overflow: hidden; margin: 0; } .gift-photo img { width: 100%; height: auto; } .gift-photo figcaption { padding: .75rem 1rem 1.25rem; text-align: center; font-size: .6875rem; color: var(--color-text-secondary); }
  .kit-list { list-style: none; display: grid; gap: .85rem; margin-top: 1.5rem; padding: 0; font-size: .875rem; } .kit-list li { display: flex; gap: .65rem; align-items: start; } .kit-list svg { flex-shrink: 0; color: var(--color-brand-dark); margin-top: 2px; }
</style>
