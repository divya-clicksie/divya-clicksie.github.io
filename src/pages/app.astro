---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AttentionLine from '../components/AttentionLine.astro';
import AppCarousel from '../components/AppCarousel.astro';
import AppFeatureComparison from '../components/AppFeatureComparison.astro';

const title = 'Free Baby Tracker App for iPhone and Android | Nubo';
const description = 'Download the free Nubo baby tracker app for iPhone and Android. Log feeds, sleep, diapers, voice catch-up, and caregiver sync with no ads.';
const appStoreURL = 'https://apps.apple.com/us/app/nubo-baby-tracker/id1667461158';
const playStoreURL = 'https://play.google.com/store/apps/details?id=com.clicksie.nuboapp';

const faqItems = [
  {
    q: 'Is Nubo really a free baby tracker app?',
    a: 'Yes. The free Nubo app covers everyday baby tracking for feeds, sleep, diapers, medicine, growth, notes, voice catch-up, caregiver sync, offline mode, and private storage. Nubo Plus and the Nubo device are optional upgrades.'
  },
  {
    q: 'Does Nubo work on iPhone and Android?',
    a: 'Yes. Nubo is cross-platform compatible. Parents and caregivers can use iPhone or Android and still share the same baby timeline.'
  },
  {
    q: 'Can I log baby events after they happen?',
    a: 'Yes. Use voice catch-up in the app to say what happened later, such as a bottle around noon or a wet diaper after a nap, and Nubo files it into the timeline.'
  },
  {
    q: 'Can I use Nubo for exclusive pumping?',
    a: 'Yes. Log pumped milk bottles as baby feeds in the shared timeline, and use Nubo Plus private pumping to track milk output separately. Caregivers can see baby intake, not your private pumping logs.'
  },
  {
    q: 'Can I see a caregiver\'s log on my iPhone Lock Screen?',
    a: 'Yes. With Nubo Plus on iPhone, Live Activities show recent feed and diaper information on the Lock Screen. The view updates when another caregiver logs an event or a Nubo device event syncs to the shared timeline.'
  }
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Nubo Baby Tracker',
    operatingSystem: 'iOS, Android',
    applicationCategory: 'HealthApplication',
    url: 'https://www.nubotracker.com/app/',
    description,
    image: 'https://www.nubotracker.com/images/appscreens/01_onetouch.webp',
    featureList: [
      'One-tap quick logs for routine baby care',
      'On-device voice catch-up in the app',
      'Feeds, sleep, diapers, growth, vaccines, allergens, milestones, medication, and notes',
      'Unlimited caregivers across iOS and Android',
      'Nubo Plus Live Activities on iPhone for recent feeds, diapers, and active timers',
      'End-to-end encrypted caregiver sharing',
      'Offline mode and private cloud backup'
    ],
    offers: [
      { '@type': 'Offer', name: 'Nubo free app', price: '0', priceCurrency: 'USD', url: appStoreURL },
      { '@type': 'Offer', name: 'Nubo Plus', price: '39.99', priceCurrency: 'USD', url: appStoreURL }
    ],
    installUrl: [appStoreURL, playStoreURL],
    downloadUrl: [appStoreURL, playStoreURL]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a
      }
    }))
  }
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Header />
  <main>
    <section class="app-hero">
      <div class="container app-hero-inner">
        <div>
          <p class="overline">All-in-one baby tracker</p>
          <h1>Free baby tracker app for newborn feeds, sleep, and diapers.</h1>
          <p>Log feeds, sleep, diapers, medicine, growth, and notes with quick taps. Remembered something later? Say it in plain English. Sharing care with another parent, grandparent, or nanny? Keep every caregiver on the same timeline, then compare the optional <a href="/device/" class="text-link">screen-free baby tracker device</a> if phone logging starts to get in the way.</p>
          <div class="hero-store-links" aria-label="Download Nubo app">
            <a href={appStoreURL} target="_blank" rel="noopener noreferrer"><img src="/images/appstore-badge.webp" alt="Download on the App Store" width="160" height="56" /></a>
            <a href={playStoreURL} target="_blank" rel="noopener noreferrer"><img src="/images/playstore-badge.webp" alt="Get it on Google Play" width="160" height="56" /></a>
          </div>
        </div>
        <AppCarousel />
      </div>
    </section>

    <AttentionLine lead="Baby care changes fast. Nubo keeps up." variant="plain" />

    <section class="live-activity-section" aria-labelledby="live-activity-title">
      <div class="container live-activity-grid">
        <div>
          <p class="overline">Nubo Plus on iPhone</p>
          <h2 id="live-activity-title">See the last feed or diaper at a glance.</h2>
          <p>"When did the baby last feed?" The answer can be on your Lock Screen, without opening the app. Nubo Live Activities show recent care details alongside active sleep and nursing timers.</p>
          <p>When another caregiver logs an event, or a Nubo device log syncs, the shared timeline and your Live Activity update. It is a quick way to get oriented before you take over care.</p>
          <a href="/blog/caregiver/baby-care-at-a-glance-shared-live-activity/" class="text-link">Read how it helps with handoffs &rarr;</a>
        </div>
        <img src="/images/appscreens/04_liveactivities.webp" alt="Nubo iPhone Lock Screen showing the time since the baby's last feed and diaper" width="642" height="1389" loading="lazy" decoding="async" />
      </div>
    </section>

    <div class="feature-table-section container">
      <AppFeatureComparison />
    </div>

    <section class="proof-section" id="app-downloads">
      <div class="container">
        <div class="store-links store-links-centered" aria-label="Download Nubo app">
          <a href={appStoreURL} target="_blank" rel="noopener noreferrer"><img src="/images/appstore-badge.webp" alt="Download on the App Store" width="160" height="56" loading="lazy" /></a>
          <a href={playStoreURL} target="_blank" rel="noopener noreferrer"><img src="/images/playstore-badge.webp" alt="Get it on Google Play" width="160" height="56" loading="lazy" /></a>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <div class="container">
        <div class="section-intro">
          <p class="overline">App questions</p>
          <h2>Quick answers about the Nubo app.</h2>
        </div>
        <div class="app-faq-grid">
          {faqItems.map((faq) => (
            <article>
              <h3>{faq.q}</h3>
              <p>{faq.a}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .app-hero { padding: 10rem 0 5rem; background: var(--color-bg-ivory); overflow: hidden; }
  .app-hero-inner { display: grid; grid-template-columns: 1fr 0.75fr; gap: 4rem; align-items: center; }
  .app-hero-inner > div, .section-intro, .app-faq-grid article { min-width: 0; }
  .app-hero h1 { font-size: clamp(2.35rem, 5vw, 4rem); line-height: 1.08; margin-bottom: 1rem; overflow-wrap: break-word; }
  .app-hero p, .app-faq-grid p { color: var(--color-text-secondary); line-height: 1.7; }
  .hero-store-links { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; margin-top: 2rem; }
  .hero-store-links img { height: 52px; width: auto; border-radius: 0; box-shadow: none; }
  .hero-trust { margin-top: 1rem; font-weight: 800; color: var(--color-brand-dark) !important; }
  :global(.app-hero + .attention-line) { padding-top: 0; padding-bottom: 3.5rem; background: var(--color-bg-ivory); }

  .live-activity-section { padding: 5rem 0; background: var(--color-bg-soft); }
  .live-activity-grid { display: grid; grid-template-columns: 1fr minmax(220px, 340px); align-items: center; gap: 4rem; }
  .live-activity-grid h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; margin-bottom: 1.25rem; }
  .live-activity-grid p { color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 1rem; }
  .live-activity-grid img { width: 100%; height: auto; border-radius: var(--radius-xl); box-shadow: 0 16px 38px rgba(31, 41, 55, 0.12); }

  .feature-table-section, .faq-section, .proof-section { padding: 5rem 0; }
  .feature-table-section { background: #fff; }

  .proof-section { scroll-margin-top: 1rem; }
  .proof-section, .faq-section { background: var(--color-bg-soft); }
  .store-links { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .store-links-centered { justify-content: center; align-items: center; }
  .store-links img { height: 48px; width: auto; }

  .app-faq-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .app-faq-grid article { background: #fff; border: 1px solid #e8e8e8; border-radius: var(--radius-xl); padding: 1.75rem; }
  .app-faq-grid h3 { font-size: 1.125rem; line-height: 1.3; margin-bottom: 0.75rem; color: var(--color-text); }

  @media (max-width: 980px) {
    .app-hero { padding: 8rem 0 4rem; }
    .app-hero-inner { grid-template-columns: 1fr; }
    .live-activity-grid { gap: 2rem; }
    .app-faq-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .app-hero { padding-top: 7rem; }
    .app-hero h1 { font-size: clamp(2rem, 10vw, 2.45rem); overflow-wrap: anywhere; }
    .app-hero .overline { font-size: 0.72rem; letter-spacing: 0.04em; overflow-wrap: anywhere; }
    .app-hero p, .section-intro h2, .section-sub { overflow-wrap: anywhere; }
    .live-activity-section { padding: 4rem 0; }
    .live-activity-grid { grid-template-columns: 1fr; }
    .live-activity-grid img { max-width: 300px; justify-self: center; }
    .feature-table-section, .faq-section, .proof-section { padding: 4rem 0; }
    .app-faq-grid { grid-template-columns: 1fr; }
    .hero-store-links img { height: 46px; }
    .store-links a, .store-links img { width: 100%; height: auto; }
  }
</style>
