---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';
import StoreLinks from '../components/StoreLinks.astro';
import FaqList from '../components/FaqList.astro';

const title = 'Exclusive Pumping Tracker App | Nubo';
const description = 'Pumping, feeding, washing parts. Keep baby bottle feeds shared and your pumping history private with Nubo. Baby logs stay free; private pumping is in Plus.';
const appStoreURL = 'https://apps.apple.com/us/app/nubo-baby-tracker/id1667461158';
const playStoreURL = 'https://play.google.com/store/apps/details?id=com.clicksie.nuboapp';
const amazonURL = 'https://www.amazon.com/nubo-Newborn-Activity-Tracker-Color/dp/B0CJLNBG4P?maas=maas_adg_465D5CB69C73F660B7AD38831E2D680B_afap_abs&ref_=aa_maas&tag=maas';

const faqItems = [
  {
    q: 'Can I use Nubo as an exclusive pumping tracker?',
    a: 'Yes. Nubo supports the two records exclusive pumping families usually need: pumped milk bottles in the shared baby timeline, and private pumping logs for milk output.'
  },
  {
    q: 'Can caregivers see my pumping output?',
    a: 'No. Private pumping logs stay separate from the shared baby timeline. Partners, grandparents, nannies, sitters, and other caregivers can see baby feeds, not your private pumping sessions.'
  },
  {
    q: 'Can caregivers log pumped milk bottles?',
    a: 'Yes. A caregiver can log a pumped milk bottle as a baby feeding event from the app, the Nubo Remote, or Alexa when enabled.'
  },
  {
    q: 'Does Nubo calculate my freezer stash?',
    a: 'Not currently. Nubo tracks private pumping output and shared baby bottle intake, but it does not maintain a running milk stash total.'
  }
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: 'https://www.nubotracker.com/exclusive-pumping/',
    about: [
      { '@type': 'Thing', name: 'exclusive pumping tracker' },
      { '@type': 'MobileApplication', name: 'Nubo Baby Tracker App' }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Nubo Baby Tracker',
    operatingSystem: 'iOS, Android',
    applicationCategory: 'HealthApplication',
    description: 'Baby bottle feeds and caregiver sharing stay free in Nubo. Plus adds a separate private pumping record for volume, duration, and side.',
    offers: [
      { '@type': 'Offer', name: 'Nubo free app', price: '0', priceCurrency: 'USD', url: appStoreURL },
      { '@type': 'Offer', name: 'Nubo Plus', price: '59.99', priceCurrency: 'USD', url: appStoreURL }
    ],
    installUrl: [appStoreURL, playStoreURL]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a
      }
    }))
  }
];
---

<MarketingLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="m-hero"><div class="container m-split"><div><p class="overline">Exclusive pumping · Nubo Plus</p><h1>Track bottles together.<br />Keep pumping private.</h1><p class="m-lead">Pumping, feeding, washing parts. There's enough to juggle. Share what your baby drank while your pumping record stays yours.</p><div class="m-actions"><StoreLinks eager /></div><p class="m-note">Baby bottle logs are free. Private pumping is included in Plus.</p></div><figure class="record-pair"><article class="intake-record"><span class="m-icon"><SiteIcon name="bottle" /></span><p class="m-label">Baby's bottle · Shared</p><h3>3 oz</h3><p>Pumped milk · 8:00 AM</p><span class="record-status"><SiteIcon name="users" size={17} />Your care team</span></article><article class="output-record"><span class="m-icon lilac"><SiteIcon name="lock" /></span><p class="m-label">Your pumping · Private</p><h3>4 oz</h3><p>Pumping session · 11:00 PM</p><span class="record-status"><SiteIcon name="lock" size={17} />Only you</span></article><figcaption>Illustrative records, kept separately.</figcaption></figure></div></section>
  <section class="m-section"><div class="container"><div class="m-heading center"><p class="overline">A clear place for each record</p><h2>What baby drank.<br />What you pumped.</h2></div><ol class="m-grid three m-steps"><li><h3>Log the bottle.</h3><p>Free app taps or voice logging record your baby's intake. Caregivers see the amount and time.</p></li><li><h3>Keep your output private.</h3><p>Plus tracks your pumping volume, duration, and side in a separate record.</p></li><li><h3>Review what you need.</h3><p>Shared intake for handoffs. Your own pumping history for you.</p></li></ol></div></section>
  <section class="m-section m-teal"><div class="container m-split"><div class="m-copy"><p class="overline">Shared care, clear boundaries</p><h2>They can help with the bottle.<br />You keep your own record.</h2><p>Partners and nannies can log pumped milk feeds while you're pumping, sleeping, or working. Private pumping sessions stay outside the caregiver timeline.</p><a href="/caregivers/" class="text-link">Explore shared care <span aria-hidden="true">→</span></a><a href="/blog/privacy/pumping-tracker-private-data/" class="text-link privacy-guide">Read the pumping privacy guide <span aria-hidden="true">→</span></a></div><img src="/images/caregiver-hub.webp" alt="Nubo app connected across caregiver phones for shared baby care" width="970" height="600" loading="lazy" /></div></section>
  <section class="m-section"><div class="container m-split"><div class="m-heading"><p class="overline">Pumping questions</p><h2>The practical details.</h2><p>Nubo tracks pumping output and bottle intake. It doesn't currently calculate a running freezer stash.</p></div><FaqList items={faqItems} /></div></section>
  <section class="m-cta"><div class="container"><p class="overline">Your routine, your boundaries</p><h2>Start with the next bottle.</h2><p>Download the free app. Add Plus for private pumping.</p><div class="m-actions"><StoreLinks /></div><div class="m-actions"><a href="/pricing/" class="text-link">Explore Free and Plus <span aria-hidden="true">→</span></a></div></div></section>
</MarketingLayout>
<style>
  .record-pair { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: start; }
  .record-pair article { border: 1px solid #d7e5dd; background: #f0f7f2; border-radius: 24px; padding: 1.5rem; }
  .record-pair .output-record { background: #f3eff8; border-color: #e4daef; margin-top: 3rem; }
  .record-pair h3 { font-size: 2.4rem; line-height: 1.2; margin-top: 1.5rem; } .record-pair article > p:not(.m-label) { font-size: .75rem; color: var(--color-text-secondary); margin-top: .5rem; }
  .record-status { display: flex; gap: .5rem; align-items: center; font-size: .6875rem; color: var(--color-brand-dark); border-top: 1px solid #cbdcd1; padding-top: 1rem; margin-top: 1.25rem; } .output-record .record-status { color: #67518b; border-color: #ddd2e9; }
  .record-pair figcaption { grid-column: 1 / -1; text-align: center; color: var(--color-text-secondary); font-size: .6875rem; }
  .privacy-guide { display: block !important; }
  @media (max-width: 680px) { .record-pair { gap: .75rem; } .record-pair article { padding: 1.25rem; } .record-pair h3 { font-size: 2rem; } }
  @media (max-width: 360px) { .record-pair article { padding: 1rem; } .record-pair .m-label { font-size: .625rem; } }
</style>
