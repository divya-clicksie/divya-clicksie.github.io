---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';
const title = 'Contact Us | Nubo Baby Tracker';
const description = 'Questions about the Nubo app, Care, Plus access, or your Nubo Remote? Contact the Nubo team. We typically respond within one business day.';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Nubo",
  "description": description,
  "url": "https://www.nubotracker.com/contact/",
  "publisher": {
    "@type": "Organization",
    "name": "Clicksie LLC",
    "url": "https://www.nubotracker.com",
    "email": "support@clicksie.io"
  }
};
---

<MarketingLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="m-hero m-title"><div class="container"><span class="contact-mark"><SiteIcon name="mail" size={38} /></span><p class="overline">Contact Nubo</p><h1>A little help<br />from our team.</h1><p class="m-lead">Questions about the app, Nubo Care, Plus access, or your Nubo Remote? We typically reply within one business day.</p><div class="m-actions"><a href="mailto:support@clicksie.io" class="btn-primary">Email support@clicksie.io</a><a href="/faq/" class="text-link">Browse common questions <span aria-hidden="true">→</span></a></div></div></section>
  <section class="m-section"><div class="container m-grid two"><article class="m-card"><span class="m-icon"><SiteIcon name="phone" /></span><h2>App or Nubo Remote help</h2><p>Tell us what's happening. For Nubo Remote issues, include the serial number on the back. Screenshots help, too.</p></article><article class="m-card"><span class="m-icon peach"><SiteIcon name="gift" /></span><h2>Amazon orders</h2><p>For order status, shipping, or returns, use your Amazon order page.</p><a href="https://www.amazon.com/gp/css/order-history" class="text-link" target="_blank" rel="noopener noreferrer">Your Amazon orders <span aria-hidden="true">↗</span></a></article><article class="m-card"><span class="m-icon lilac"><SiteIcon name="lock" /></span><h2>Privacy questions</h2><p>Read the plain-English overview or email us about your data.</p><a href="/privacy/" class="text-link">Privacy at Nubo <span aria-hidden="true">→</span></a></article><article class="m-card"><span class="m-icon"><SiteIcon name="users" /></span><h2>Press and partnerships</h2><p>Send a brief introduction and what you have in mind.</p><a href="mailto:support@clicksie.io" class="text-link">Get in touch <span aria-hidden="true">→</span></a></article></div></section>
</MarketingLayout>
<style>
  .contact-mark { display: inline-grid; place-items: center; width: 76px; height: 76px; border: 1px solid #d1e4d9; border-radius: 25px; background: #eef7f2; color: var(--color-brand-dark); margin-bottom: 1.5rem; }
  .m-card h2 { font-size: 1.35rem; }
</style>
