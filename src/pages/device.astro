---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';
import FaqList from '../components/FaqList.astro';
import PlusFollowsDevice from '../components/PlusFollowsDevice.astro';
import RemoteHowItWorks from '../components/RemoteHowItWorks.astro';

const title = 'Nubo Remote | Screen-Free Baby Tracking';
const description = 'Less screen time, more time with your baby. Tap Nubo Remote to log feeds, sleep, and diapers without opening your phone. Sync updates with every caregiver.';

const amazonURL = 'https://www.amazon.com/nubo-Newborn-Activity-Tracker-Color/dp/B0CJLNBG4P?maas=maas_adg_465D5CB69C73F660B7AD38831E2D680B_afap_abs&ref_=aa_maas&tag=maas';

const faqItems = [
  {
    q: 'What is a physical baby tracker?',
    a: 'A physical baby tracker is a dedicated device for logging baby events without opening your phone. With Nubo Remote, you tap buttons for bottles, nursing, sleep, and diapers, then the events sync to the free app.'
  },
  {
    q: 'Does Nubo Remote work for grandparents or nannies?',
    a: 'Yes. The buttons are designed to be simple for parents, grandparents, nannies, and other caregivers, even when they do not want to learn an app workflow in the moment.'
  },
  {
    q: 'What happens when my phone is out of range?',
    a: 'The device stores the timestamped event. When a caregiver phone with the Nubo app is nearby again, Bluetooth sync sends the event into the shared baby timeline.'
  },
  {
    q: 'Does Nubo Remote require a Nubo Plus subscription?',
    a: 'No. The device works with the free app, and device sync refreshes a 30-day Nubo Plus access window for active phones.'
  }
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Nubo Remote',
    alternateName: ['One-tap baby tracker', 'Physical baby tracker device', 'Screen-free baby tracker'],
    image: [
      'https://www.nubotracker.com/images/hero-device.webp',
      'https://www.nubotracker.com/images/caregiver-hub.webp'
    ],
    description,
    sku: 'B0CJLNBG4P',
    category: 'Baby activity tracker',
    brand: { '@type': 'Brand', name: 'Nubo' },
    url: 'https://www.nubotracker.com/device/',
    featureList: [
      'Dedicated event buttons for bottle feeds, nursing, sleep, and diapers',
      'Screen-free logging during night feeds and hands-full moments',
      'Bluetooth sync with the free Nubo app',
      'Nubo Plus access refresh for phones that sync with the device',
      'Magnetic mount, lanyard, and battery included'
    ],
    offers: {
      '@type': 'Offer',
      price: '89.00',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      itemCondition: 'https://schema.org/NewCondition',
      url: amazonURL
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a
      }
    }))
  }
];
---

<MarketingLayout title={title} description={description} jsonLd={jsonLd} ctaHref={amazonURL} ctaLabel="Buy on Amazon" ctaExternal>
  <section class="m-hero remote-hero" aria-labelledby="remote-title">
    <div class="container">
      <p class="overline">Nubo Remote</p>
      <h1 id="remote-title">Screen-free baby tracking.</h1>
      <p class="m-lead">For the night feeds and hands-full days when you want less time on screens. Tap a physical button to log care, without unlocking your phone or opening an app.</p>
      <div class="m-actions"><a href={amazonURL} class="btn-primary" target="_blank" rel="noopener noreferrer">Buy on Amazon</a><span class="device-price"><del>$109</del> $89</span></div>
      <p class="m-note">Works with the free Nubo app on iPhone and Android.</p>
    </div>
  </section>
  <RemoteHowItWorks compactHeading />
  <aside class="m-strip" aria-label="Nubo Remote essentials"><div class="container"><span><SiteIcon name="check" size={19} />Screen-free logging</span><span><SiteIcon name="bluetooth" size={19} />Bluetooth sync</span><span><SiteIcon name="users" size={19} />Unlimited caregivers, free</span></div></aside>
  <PlusFollowsDevice />
  <section class="m-section"><div class="container m-grid three"><article class="detail-tile"><span class="m-icon"><SiteIcon name="leaf" /></span><h3>Keep it close.</h3><p>Magnetic mount and lanyard included.</p></article><article class="detail-tile"><span class="m-icon peach"><SiteIcon name="check" /></span><h3>Ready for the routine.</h3><p>Battery included, designed for months of everyday use.</p></article><article class="detail-tile"><span class="m-icon lilac"><SiteIcon name="users" /></span><h3>Made for helping hands.</h3><p>A familiar button for parents, grandparents, and nannies.</p><a href="/caregivers/" class="text-link">Explore shared care <span aria-hidden="true">→</span></a></article></div></section>
  <section class="m-section m-warm"><div class="container m-split faq-split"><div class="m-heading"><p class="overline">A few practical answers</p><h2>Before your first tap.</h2><p>Comparing physical trackers? <a href="/compare/talli/" class="text-link">See Nubo Remote and Talli.</a></p></div><FaqList items={faqItems} /></div></section>
  <section class="m-cta"><div class="container"><p class="overline">For the moments your hands are full</p><h2>Keep the moment.<br />Skip the phone pickup.</h2><div class="m-actions"><a href={amazonURL} class="btn-primary" target="_blank" rel="noopener noreferrer">Buy on Amazon</a><a href="/app/" class="text-link">Explore the free app <span aria-hidden="true">→</span></a></div></div></section>
</MarketingLayout>
<style>
  .remote-hero.m-hero { text-align: center; padding-block: 112px 2rem; }
  .remote-hero .m-lead { max-width: 710px; margin-inline: auto; }
  .remote-hero .m-actions { justify-content: center; }
  .device-price { font-size: 1.6rem; font-weight: 700; } .device-price del { color: var(--color-text-secondary); font-size: 1rem; font-weight: 500; margin-right: .35rem; }
  .detail-tile p { font-size: .8125rem; color: var(--color-text-secondary); margin-top: .5rem; }
  .detail-tile { padding: .5rem; } .detail-tile .text-link { display: inline-block; font-size: .8125rem; margin-top: .8rem; }
  @media (max-width: 680px) { .remote-hero.m-hero { padding-top: 100px; } .faq-split { align-items: start; } }
</style>
