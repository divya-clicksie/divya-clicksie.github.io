---
import { getCollection } from 'astro:content';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import ResourceCard from '../../components/ResourceCard.astro';


const title = 'Nubo Guides | From Premature Babies to Preschoolers';
const description = 'Practical Nubo guides for premature babies, twins, toddlers, preschoolers, and the newborn weeks. Find a shared care routine that fits your family.';

const guides = (await getCollection('guides')).sort(
  (a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime()
);

const guideTopics: Record<string, string> = { 'nubo-for-preemie-babies': 'tracking', 'nubo-for-twins': 'caregiver', 'nubo-for-toddlers': 'product', 'nubo-for-young-kids': 'family', 'track-feeding-sleep-diapers-first-12-weeks': 'feeding' };

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: 'https://www.nubotracker.com/guides/',
  publisher: {
    '@type': 'Organization',
    name: 'Nubo',
    url: 'https://www.nubotracker.com/',
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: guides.map((guide, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://www.nubotracker.com/guides/${guide.slug}/`,
      name: guide.data.title,
    })),
  },
};---

<MarketingLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="m-hero m-title"><div class="container"><p class="overline">Nubo guides</p><h1>For your family's<br />next chapter.</h1><p class="m-lead">New routines bring new questions. Find ways to keep track, share the details, and prepare for visits, from newborn weeks to preschool.</p></div></section>
  <section class="m-section"><div class="container"><div class="m-grid two guide-grid">{guides.map((guide) => <ResourceCard title={guide.data.title} href={`/guides/${guide.slug}/`} label="Family guide" category={guideTopics[guide.slug] ?? 'family'} image={guide.data.heroImage} headingLevel="h2" />)}</div><div class="m-actions"><a href="/resources/" class="text-link">Explore all resources <span aria-hidden="true">→</span></a><a href="/blog/" class="text-link">Browse articles <span aria-hidden="true">→</span></a></div></div></section>
</MarketingLayout>

<style>:global(.guide-grid > .resource-card:last-child) { grid-column: 1 / -1; }</style>
